<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no, viewport-fit=cover" />
  <title><%= title %></title>
  <meta name="description" content="Khám phá các công trình thiết kế kiến trúc và nội thất đẳng cấp do Shome Luxury thực hiện." />
  <meta name="keywords" content="Shome Luxury, thiet ke noi that, thiet ke kien truc, du an thuc te, biet thu, nha pho, chung cu" />

  <!-- Open Graph -->
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="Tuyển tập công trình kiến trúc & nội thất sang trọng Shome Luxury." />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#000000" />
  <%- include("partials/site-favicon") %>

  <!-- CSS Stylesheet -->
  <link rel="preload" href="/images/shome-logo.png" as="image" />
  <link rel="stylesheet" href="/css/style.css?v=6.8.68" />
  <script src="/js/main.js?v=2.0.6" defer></script>
</head>
<body class="showcase-page-body">

  <!-- Header -->
  <%- include("partials/header") %>

  <!-- Mobile Drawer -->
  <%- include("partials/mobile-drawer") %>

  <!-- Main Content -->
  <main id="main-content" class="showcase-page-main">
    <!-- Showcase Hero & Filters -->
    <section class="project-showcase-hero <%= pageImages && pageImages[`subpage_${activeCategoryCode}_hero_banner`] ? 'has-managed-image' : '' %>" style="--showcase-hero-image: url('<%= pageImages && pageImages[`subpage_${activeCategoryCode}_hero_banner`] ? pageImages[`subpage_${activeCategoryCode}_hero_banner`] : '' %>');">
      <div class="container">
        <div class="showcase-header-text">
          <span class="eyebrow-text">─── <%= pageConfig.eyebrow %> ───</span>
          <h1 class="showcase-title">
            <span class="title-main <%= pageConfig.titleMainClass || '' %>"><%= pageConfig.titleMain %></span>
            <% if (pageConfig.titleScript) { %>
              <span class="title-script font-script"><%= pageConfig.titleScript %></span>
            <% } %>
          </h1>
          <% if (pageConfig.description) { %>
            <p class="showcase-subtitle"><%= pageConfig.description %></p>
          <% } %>
        </div>

      </div>
    </section>

    <!-- Construction videos or project showcase -->
    <section class="project-showcase-section">
      <div class="container">
        <% if (isConstructionShowcase) { %>
          <% const hasMoreProjects = constructionProjects && constructionProjects.length > 3; %>
          <% const hasMoreDesktopProjects = constructionProjects && constructionProjects.length > 6; %>
          <div id="construction-project-grid" class="completed-projects-grid construction-project-grid" aria-label="Hình ảnh đang thi công công trình">
            <% if (constructionProjects && constructionProjects.length > 0) { %>
              <% constructionProjects.forEach(project => { %>
                <%- include("partials/project-card", { project }) %>
              <% }); %>
            <% } else { %>
              <div class="empty-state-box">
                <p class="empty-state-title">Chưa có hình ảnh thi công</p>
              </div>
            <% } %>
          </div>
          <% if (hasMoreProjects) { %>
            <div class="construction-video-more <%= hasMoreDesktopProjects ? 'has-more-desktop' : 'has-more-mobile' %>">
              <button class="construction-video-more-button" type="button" data-expand-grid="construction-project-grid" aria-controls="construction-project-grid" aria-expanded="false" data-more-text="XEM THÊM" data-less-text="THU GỌN">
                XEM THÊM
              </button>
            </div>
          <% } %>
        <% } else if (isVideoShowcase) { %>
          <% const hasMoreVideos = videos && videos.length > 3; %>
          <% const hasMoreDesktopVideos = videos && videos.length > 6; %>
          <div id="construction-video-grid" class="construction-video-grid" aria-label="Video thi công công trình">
            <% if (videos && videos.length > 0) { %>
              <% videos.forEach(video => { %>
                <div class="construction-video-card">
                  <div class="youtube-thumbnail-card youtube-thumbnail-card--desktop" data-youtube-thumbnail data-video-url="https://www.youtube.com/watch?v=<%= video.youtubeId %>">
                    <button class="youtube-thumbnail-cover" type="button" aria-label="Phát video thi công công trình">
                      <img class="youtube-thumbnail-image" src="https://i.ytimg.com/vi/<%= video.youtubeId %>/maxresdefault.jpg" data-youtube-fallback="https://i.ytimg.com/vi/<%= video.youtubeId %>/hqdefault.jpg" alt="Thumbnail YouTube video thi công công trình" loading="lazy" decoding="async" />
                      <span class="youtube-thumbnail-shade" aria-hidden="true"></span>
                      <span class="youtube-play-button" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 6.7v10.6c0 .7.8 1.1 1.4.7l8-5.3c.5-.3.5-1 0-1.4l-8-5.3C9.8 5.6 9 6 9 6.7Z" /></svg>
                      </span>
                    </button>
                  </div>
                  <div class="youtube-responsive-iframe">
                    <iframe
                      src="https://www.youtube-nocookie.com/embed/<%= video.youtubeId %>?rel=0&modestbranding=1"
                      title="Video YouTube thi công công trình"
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen
                    ></iframe>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="empty-state-box">
                <p class="empty-state-title">Chưa có video thi công</p>
              </div>
            <% } %>
          </div>
          <% if (hasMoreVideos) { %>
            <div class="construction-video-more <%= hasMoreDesktopVideos ? 'has-more-desktop' : 'has-more-mobile' %>">
              <button class="construction-video-more-button" type="button" data-expand-grid="construction-video-grid" aria-controls="construction-video-grid" aria-expanded="false" data-more-text="XEM THÊM" data-less-text="THU GỌN">
                XEM THÊM
              </button>
            </div>
          <% } %>
        <% } else { %>
        <div id="project-list-container" class="project-list-vertical" data-category="<%= activeCategoryCode %>">
          <% if (initialProjects && initialProjects.length > 0) { %>
            <% initialProjects.forEach(project => { %>
              <%- include("partials/project-card", { project }) %>
            <% }); %>
          <% } else { %>
            <div class="empty-state-box">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <p class="empty-state-title">Chưa có công trình</p>
              <p class="empty-state-desc">Hiện chưa có công trình trong danh mục này.</p>
            </div>
          <% } %>
        </div>

        <!-- Infinite-scroll sentinel: the next page is fetched as this enters view. -->
        <div id="project-load-sentinel" class="project-infinite-loader" aria-live="polite"
             data-page="<%= initialPagination ? initialPagination.page : 1 %>"
             data-total-pages="<%= initialPagination ? initialPagination.totalPages : 0 %>"
             data-category="<%= activeCategoryCode %>"
             style="<%= (initialPagination && initialPagination.totalPages > 1) ? '' : 'display: none;' %>">
          <span class="infinite-loader-spinner" aria-hidden="true"></span>
          <span class="infinite-loader-text">Đang tải thêm công trình...</span>
        </div>
        <% } %>
      </div>
    </section>

    <% if (isConstructionShowcase) { %>
      <% const completedHeadingImage = pageImages && pageImages[`subpage_${activeCategoryCode}_hero_banner`] ? pageImages[`subpage_${activeCategoryCode}_hero_banner`] : '/images/hero_interior.jpg'; %>
      <section class="completed-projects-section">
        <div class="completed-projects-heading-band" style="--completed-heading-image: url('<%= completedHeadingImage %>');">
          <div class="container">
            <header class="completed-projects-heading">
              <p>─── NHỮNG HÌNH ẢNH HOÀN CÔNG TIÊU BIỂU ───</p>
              <h2 class="<%= pageConfig.completedTitleScript === 'Nhà Cấp 4' ? 'completed-title--nha-cap-4' : '' %>"><%= pageConfig.completedTitleMain || 'HOÀN CÔNG NỘI THẤT' %> <em class="font-script"><%= pageConfig.completedTitleScript || 'Chung Cư' %></em></h2>
              <strong><%= pageConfig.completedDescription || 'Những hình ảnh thực tế sau khi hoàn thiện, mang đến không gian sống sang trọng, tinh tế và đúng “chất” của từng gia chủ.' %></strong>
            </header>
          </div>
        </div>

        <div class="container">
          <% if (completedProjects && completedProjects.length > 0) { %>
            <div class="completed-projects-grid">
              <% completedProjects.forEach(project => { %>
                <%- include("partials/project-card", { project }) %>
              <% }); %>
            </div>
          <% } else { %>
            <div class="empty-state-box">
              <p class="empty-state-title">Chưa có công trình hoàn công</p>
            </div>
          <% } %>

          <div class="completed-projects-more">
            <a class="construction-video-more-button" href="<%= pageConfig.completedProjectUrl || '/thiet-ke-cong-trinh' %>">
              XEM THÊM
            </a>
          </div>
        </div>
      </section>

      <section class="completed-videos-section">
        <div class="completed-videos-heading-band" style="--completed-heading-image: url('<%= completedHeadingImage %>');">
          <div class="container">
            <header class="completed-videos-heading">
              <p>─── NHỮNG VIDEO HOÀN THIỆN TIÊU BIỂU ───</p>
              <h2 class="<%= pageConfig.completedTitleScript === 'Nhà Cấp 4' ? 'completed-title--nha-cap-4' : '' %>"><%= pageConfig.completedTitleMain || 'HOÀN CÔNG NỘI THẤT' %> <em class="font-script"><%= pageConfig.completedTitleScript || 'Chung Cư' %></em></h2>
              <strong><%= pageConfig.completedVideoDescription || 'Khám phá những video hoàn thiện thực tế với không gian sống tinh tế, hiện đại và đẳng cấp.' %></strong>
            </header>
          </div>
        </div>

        <div class="container">
          <div id="completed-video-grid" class="completed-video-grid" aria-label="Video hoàn công nội thất">
            <% if (videos && videos.length > 0) { %>
              <% videos.forEach(video => { %>
                <div class="construction-video-card">
                  <div class="youtube-thumbnail-card youtube-thumbnail-card--desktop" data-youtube-thumbnail data-video-url="https://www.youtube.com/watch?v=<%= video.youtubeId %>">
                    <button class="youtube-thumbnail-cover" type="button" aria-label="Phát video hoàn công nội thất">
                      <img class="youtube-thumbnail-image" src="https://i.ytimg.com/vi/<%= video.youtubeId %>/maxresdefault.jpg" data-youtube-fallback="https://i.ytimg.com/vi/<%= video.youtubeId %>/hqdefault.jpg" alt="Thumbnail YouTube video hoàn công nội thất" loading="lazy" decoding="async" />
                      <span class="youtube-thumbnail-shade" aria-hidden="true"></span>
                      <span class="youtube-play-button" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 6.7v10.6c0 .7.8 1.1 1.4.7l8-5.3c.5-.3.5-1 0-1.4l-8-5.3C9.8 5.6 9 6 9 6.7Z" /></svg>
                      </span>
                    </button>
                  </div>
                  <div class="youtube-responsive-iframe">
                    <iframe
                      src="https://www.youtube-nocookie.com/embed/<%= video.youtubeId %>?rel=0&modestbranding=1"
                      title="Video YouTube hoàn công nội thất"
                      loading="lazy"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen
                    ></iframe>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="empty-state-box">
                <p class="empty-state-title">Chưa có video hoàn công</p>
              </div>
            <% } %>
          </div>

          <% if (videos && videos.length > 3) { %>
            <div class="completed-videos-more <%= videos.length > 6 ? 'has-more-desktop' : '' %>">
              <button class="construction-video-more-button" type="button" data-expand-grid="completed-video-grid" aria-controls="completed-video-grid" aria-expanded="false" data-more-text="XEM THÊM" data-less-text="THU GỌN">
                XEM THÊM
              </button>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>
  </main>

  <!-- Footer -->
  <%- include("partials/footer") %>

  <script>
    document.querySelectorAll('[data-expand-grid]').forEach(function (button) {
      button.addEventListener('click', function () {
        var targetId = this.dataset.expandGrid;
        var grid = document.getElementById(targetId);
        if (!grid) return;

        var isExpanded = grid.classList.toggle('is-expanded');
        this.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');

        var moreText = this.dataset.moreText || 'XEM THÊM';
        var lessText = this.dataset.lessText || 'THU GỌN';
        this.textContent = isExpanded ? lessText : moreText;

        if (!isExpanded) {
          var yOffset = -90;
          var y = grid.getBoundingClientRect().top + window.pageYOffset + yOffset;
          window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
        }
      });
    });
  </script>

</body>
</html>
