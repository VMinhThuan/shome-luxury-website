<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title><link rel="stylesheet" href="/css/style.css?v=6.8.44" /><link rel="stylesheet" href="/css/admin-image-header.css?v=1.0.0" /><link rel="stylesheet" href="/css/admin-images.css?v=1.1.2" /><link rel="stylesheet" href="/css/admin-images-pair.css?v=1.0.6" /><link rel="stylesheet" href="/css/admin-content.css?v=1.0.1" />
  <%- include('partials/site-favicon') %>
  <script src="/js/main.js?v=6.8.6" defer></script>
  <script src="/js/admin-images.js?v=1.1.6" defer></script><script src="/js/admin-content.js?v=1.0.1" defer></script>
</head>
<body class="home-images-admin">
<% const initialContentModule = typeof initialContent !== 'undefined' ? initialContent : null; %>
<%- include('partials/header', { navigation, adminImageMode: true, adminHomeHref: '/admin/images' }) %>
<%- include('partials/mobile-drawer', { navigation, adminImageMode: true, adminHomeHref: '/admin/images' }) %>
<main class="image-admin-shell">
  <section class="image-admin-login" data-login-panel hidden><p class="eyebrow">KHU VỰC BẢO MẬT</p><h1>Quản lý ảnh & nội dung</h1><p>Đăng nhập để cập nhật ảnh, công trình, tuyển dụng và tin tức.</p><form data-login-form><label>Tài khoản<input name="username" autocomplete="username" required></label><label>Mật khẩu<input name="password" type="password" autocomplete="current-password" required></label><button>Đăng nhập</button><p data-login-status aria-live="polite"></p></form></section>
  <section data-editor hidden>
    <div class="image-admin-title-row">
      <div>
        <p class="eyebrow" data-eyebrow>TẤT CẢ / HÌNH ẢNH</p>
        <h1>Quản lý ảnh & nội dung</h1>
        <p class="intro">Quản lý ảnh, banner, công trình, tuyển dụng và tin tức trong cùng khu vực quản trị.</p>
      </div>
      <div class="image-admin-actions">
        <a class="view-live-page-btn" data-live-link href="/" target="_blank" rel="noopener">Xem trang ngoài ↗</a>
      </div>
    </div>

    <section class="admin-quote-image-picker" data-subpage-picker hidden aria-label="Chọn menu con báo giá">
      <div>
        <p class="eyebrow">ẢNH THEO MENU CON</p>
        <h2>Quản lý ảnh trang Báo giá</h2>
        <p>Chọn đúng menu con để thay riêng 3 banner, 3 ảnh báo giá và ảnh section thi công của trang đó.</p>
      </div>
      <label>
        <span>Menu con Báo giá</span>
        <select data-subpage-select aria-label="Chọn menu con Báo giá">
          <option value="">Chọn menu con...</option>
        </select>
      </label>
    </section>

    <section class="admin-image-submenu-context" data-admin-submenu-context hidden aria-live="polite">
      <div class="admin-image-submenu-breadcrumb"><a href="/admin/images">Quản lý ảnh</a><span>/</span><strong data-admin-submenu-breadcrumb></strong></div>
      <div class="admin-image-submenu-heading">
        <div><p class="eyebrow">SUBMENU ĐANG CHỌN</p><h2 data-admin-submenu-title></h2></div>
      </div>
    </section>

    <p class="status" data-status aria-live="polite"></p>
    <div class="image-slots" data-slots></div>
    <%- include('partials/admin-content-workspace', { currentModule: 'design-projects', currentModuleLabel: 'Chọn submenu công trình', embedded: true, lazy: true, managerId: 'admin-image-content' }) %>
    <%- include('partials/admin-content-workspace', { currentModule: 'careers', currentModuleLabel: 'Tuyển dụng', embedded: true, lazy: false, managerId: 'admin-image-careers', initiallyHidden: initialContentModule !== 'careers' }) %>
    <%- include('partials/admin-content-workspace', { currentModule: 'articles', currentModuleLabel: 'Tin tức', embedded: true, lazy: false, managerId: 'admin-image-articles', initiallyHidden: initialContentModule !== 'articles' }) %>
  </section>
</main></body></html>
