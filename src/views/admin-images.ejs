<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title><link rel="stylesheet" href="/css/admin-images.css?v=1.0.6" /><link rel="stylesheet" href="/css/admin-images-pair.css?v=1.0.6" />
  <script src="/js/admin-images.js?v=1.0.6" defer></script>
</head>
<body class="home-images-admin"><main class="image-admin-shell">
  <header style="display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ded8cd;padding-bottom:18px;margin-bottom:36px;flex-wrap:wrap;gap:16px">
    <div style="display:flex;align-items:center;gap:12px">
      <a class="image-admin-brand" href="/" style="font-size:20px;letter-spacing:.12em;font-weight:800;color:#171717;text-decoration:none">SHOME <span style="color:#a88754">LUXURY</span></a>
      <span style="background:rgba(168,135,84,0.15);color:#8a6523;font-size:10px;font-weight:800;padding:3px 8px;border-radius:6px;letter-spacing:.06em">CMS QUẢN TRỊ</span>
    </div>
    <nav style="display:flex;align-items:center;gap:8px;flex-wrap:wrap" aria-label="Các tính năng quản trị">
      <a href="/admin/images" style="background:#a88754;color:#fff;text-decoration:none;font-size:13px;font-weight:700;padding:7px 12px;border-radius:8px;box-shadow:0 2px 8px rgba(168,135,84,0.3)" title="Quản lý hình ảnh và banner trên tất cả các trang">🖼️ Quản lý ảnh</a>
      <a href="/admin/thiet-ke-cong-trinh" style="color:#625f59;text-decoration:none;font-size:13px;font-weight:600;padding:7px 12px;border-radius:8px" title="Quản lý dự án & bản vẽ thiết kế kiến trúc, nội thất">📐 Thiết kế công trình</a>
      <a href="/admin/thi-cong-cong-trinh" style="color:#625f59;text-decoration:none;font-size:13px;font-weight:600;padding:7px 12px;border-radius:8px" title="Quản lý dự án & tiến độ thi công thực tế">🏗️ Thi công công trình</a>
      <a href="/admin/bao-gia" style="color:#625f59;text-decoration:none;font-size:13px;font-weight:600;padding:7px 12px;border-radius:8px" title="Quản lý thông tin và công trình nổi bật trên trang Báo giá">💰 Quản lý báo giá</a>
      <button type="button" data-logout style="border:1px solid #dcd5ca;background:#fff;color:#a94535;font:inherit;font-size:12px;font-weight:600;padding:6px 12px;border-radius:8px;cursor:pointer">Đăng xuất</button>
    </nav>
  </header>
  <section class="image-admin-login" data-login-panel hidden><p class="eyebrow">KHU VỰC BẢO MẬT</p><h1>Quản lý ảnh các trang</h1><p>Đăng nhập bằng tài khoản quản trị để cập nhật hình ảnh.</p><form data-login-form><label>Tài khoản<input name="username" autocomplete="username" required></label><label>Mật khẩu<input name="password" type="password" autocomplete="current-password" required></label><button>Đăng nhập</button><p data-login-status aria-live="polite"></p></form></section>
  <section data-editor hidden>
    <div class="image-admin-title-row">
      <div>
        <p class="eyebrow" data-eyebrow>TẤT CẢ / HÌNH ẢNH</p>
        <h1>Quản lý ảnh các trang</h1>
        <p class="intro">Quản lý hình ảnh và banner trên toàn bộ các trang: Trang chủ, Xưởng sản xuất, Báo giá, Tin tức, Tuyển dụng, Đặt lịch tư vấn.</p>
      </div>
      <a class="view-live-page-btn" data-live-link href="/" target="_blank" rel="noopener">Xem trang ngoài ↗</a>
    </div>

    <div class="image-filter-bar">
      <nav class="image-page-tabs" data-page-tabs aria-label="Phân loại theo trang"></nav>
      <div class="image-search-wrap">
        <input type="search" class="image-search-input" data-search placeholder="Tìm vị trí ảnh..." aria-label="Tìm kiếm vị trí ảnh" />
      </div>
    </div>

    <p class="status" data-status aria-live="polite"></p>
    <div class="image-slots" data-slots></div>
  </section>
</main></body></html>
