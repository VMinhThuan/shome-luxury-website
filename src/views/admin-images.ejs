<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= title %></title><link rel="stylesheet" href="/css/style.css?v=6.8.6" /><link rel="stylesheet" href="/css/admin-image-header.css?v=1.0.0" /><link rel="stylesheet" href="/css/admin-images.css?v=1.0.6" /><link rel="stylesheet" href="/css/admin-images-pair.css?v=1.0.6" />
  <script src="/js/main.js?v=6.8.6" defer></script>
  <script src="/js/admin-images.js?v=1.0.6" defer></script>
</head>
<body class="home-images-admin">
<%- include('partials/header', { navigation, adminImageMode: true, adminHomeHref: '/admin' }) %>
<%- include('partials/mobile-drawer', { navigation, adminImageMode: true, adminHomeHref: '/admin' }) %>
<main class="image-admin-shell">
  <section class="image-admin-login" data-login-panel hidden><p class="eyebrow">KHU VỰC BẢO MẬT</p><h1>Quản lý ảnh các trang</h1><p>Đăng nhập bằng tài khoản quản trị để cập nhật hình ảnh.</p><form data-login-form><label>Tài khoản<input name="username" autocomplete="username" required></label><label>Mật khẩu<input name="password" type="password" autocomplete="current-password" required></label><button>Đăng nhập</button><p data-login-status aria-live="polite"></p></form></section>
  <section data-editor hidden>
    <div class="image-admin-title-row">
      <div>
        <p class="eyebrow" data-eyebrow>TẤT CẢ / HÌNH ẢNH</p>
        <h1>Quản lý ảnh các trang</h1>
        <p class="intro">Quản lý hình ảnh và banner trên toàn bộ các trang: Trang chủ, Xưởng sản xuất, Báo giá, Tin tức, Tuyển dụng, Đặt lịch tư vấn và Chi tiết công trình.</p>
      </div>
      <div class="image-admin-actions">
        <a class="view-live-page-btn" data-live-link href="/" target="_blank" rel="noopener">Xem trang ngoài ↗</a>
        <label class="image-search-wrap">
          <span>Tìm nhanh</span>
          <input type="search" class="image-search-input" data-search placeholder="Tên vị trí ảnh..." aria-label="Tìm kiếm vị trí ảnh" />
        </label>
      </div>
    </div>

    <p class="status" data-status aria-live="polite"></p>
    <div class="image-slots" data-slots></div>
  </section>
</main></body></html>
