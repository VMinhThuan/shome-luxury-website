<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no, viewport-fit=cover" />
  <title><%= title %></title>
  <meta name="description" content="Tuyển dụng SHOME LUXURY - Khám phá cơ hội nghề nghiệp trong ngành thiết kế kiến trúc và thi công nội thất gỗ công nghiệp cao cấp." />
  <meta name="theme-color" content="#171717" />

  <!-- Performance Preload Resource Hints -->
  <link rel="preload" href="/css/style.css?v=1.5.6" as="style" />
  <link rel="preload" href="/js/main.js?v=1.5.6" as="script" />
  <link rel="preload" href="/images/shome-logo.png" as="image" />
  <link rel="preload" href="/images/banner-tuyendung.png" as="image" />

  <!-- Google Fonts for Great Vibes & Montserrat -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Montserrat:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- CSS Stylesheet -->
  <link rel="stylesheet" href="/css/style.css?v=1.5.6" />
  <script src="/js/main.js?v=1.5.6" defer></script>
</head>
<body class="page-recruitment">

  <!-- Header -->
  <%- include("partials/header") %>

  <main class="main-content">
    <!-- Recruitment Hero Banner (Full Width & Attached directly under Header) -->
    <section class="recruitment-banner-section">
      <div class="recruitment-banner-card">
        <img src="/images/banner-tuyendung.png" alt="Tuyển dụng SHOME LUXURY" class="recruitment-banner-bg" width="1200" height="500" />
        
        <div class="recruitment-banner-overlay">
          <div class="recruitment-banner-text">
            <span class="recruitment-eyebrow">SHOME LUXURY</span>
            
            <div class="recruitment-hero-title">
              <span class="script-title font-script">Tuyển dụng</span>
              <h1 class="serif-sub">
                CÙNG KIẾN TẠO<br>
                <span class="text-accent-brown">GIÁ TRỊ!</span>
              </h1>
            </div>

            <p class="recruitment-hero-subtext">
              GIA NHẬP SHOME LUXURY,<br>
              NƠI TÀI NĂNG ĐƯỢC TRÂN TRỌNG<br>
              VÀ PHÁT TRIỂN MỖI NGÀY
            </p>
          </div>

          <div class="recruitment-banner-badge">
            <span class="badge-text-wrap">
              <span class="badge-word">KIẾN TẠO</span>
              <span class="badge-word">CUỘC SỐNG</span>
              <span class="badge-word">TINH TẾ</span>
            </span>
            <span class="badge-line"></span>
          </div>
        </div>
      </div>
    </section>

    <div class="container">
      <!-- Recruitment Positions Section -->
      <section class="recruitment-jobs-section" id="cac-vi-tri-tuyen-dung">
        <div class="recruitment-header">
          <h2 class="gallery-v2-title">Vị trí đang tuyển dụng</h2>
          <p class="section-v2-desc" style="font-size: 0.875rem; color: #666666; margin: 0 0 0.5rem 0;">
            Khám phá cơ hội nghề nghiệp tại SHOME LUXURY
          </p>
          <div class="gallery-v2-line"></div>
        </div>

        <!-- Dynamic Jobs Grid Loaded via Backend API /api/recruitment -->
        <div class="recruitment-jobs-grid" id="recruitmentJobsGrid">
          <div class="job-modal-loading" style="grid-column: 1 / -1; padding: 3rem 0;">
            <div class="modal-spinner-ring"></div>
            <span>Đang kết nối API Backend để tải danh sách các vị trí tuyển dụng...</span>
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- Job Detail & Application Modal Popup -->
  <div class="modal-overlay" id="jobModalOverlay" aria-hidden="true">
    <div class="modal-card job-modal-card">
      <button class="modal-close-btn" id="closeJobModal" aria-label="Đóng popup">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <div class="job-modal-content" id="jobModalBody">
        <!-- Content will be fetched from BE API & injected dynamically -->
      </div>
    </div>
  </div>

  <!-- Footer -->
  <%- include("partials/footer") %>

  <!-- FE Script: Calls Backend APIs (/api/recruitment & /api/recruitment/:id) -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const jobsGrid = document.getElementById("recruitmentJobsGrid");
      const modalOverlay = document.getElementById("jobModalOverlay");
      const closeBtn = document.getElementById("closeJobModal");
      const modalBody = document.getElementById("jobModalBody");

      // 1. Fetch recruitment list from Backend API /api/recruitment
      async function fetchRecruitmentJobsList() {
        try {
          console.log("[FE] Fetching jobs list from Backend API: GET /api/recruitment");
          const response = await fetch("/api/recruitment");
          const result = await response.json();

          if (result.success && Array.isArray(result.data)) {
            renderJobsGrid(result.data);
          } else {
            jobsGrid.innerHTML = `
              <div style="grid-column: 1 / -1; text-align: center; color: #c0392b; padding: 2rem;">
                <p>⚠️ Không thể tải danh sách bài tuyển dụng từ máy chủ API.</p>
              </div>
            `;
          }
        } catch (err) {
          console.error("API Error fetching jobs list:", err);
          jobsGrid.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; color: #c0392b; padding: 2rem;">
              <p>⚠️ Lỗi kết nối API Backend khi tải danh sách tuyển dụng.</p>
            </div>
          `;
        }
      }

      // Render job cards into grid dynamically
      function renderJobsGrid(jobs) {
        if (!jobs || jobs.length === 0) {
          jobsGrid.innerHTML = '<p style="grid-column: 1 / -1; text-align: center;">Hiện chưa có vị trí tuyển dụng mới.</p>';
          return;
        }

        jobsGrid.innerHTML = jobs.map(job => `
          <div class="job-card-v2" data-job-id="${job.id}">
            <div class="job-card-thumb">
              <img src="${job.thumbnail}" alt="${job.title}" loading="lazy" width="400" height="250" />
            </div>
            <div class="job-card-body">
              <h3 class="job-card-title">${job.title}</h3>
              <p class="job-card-summary">${job.summary || ''}</p>
              
              <div class="job-card-footer">
                <div class="job-card-meta">
                  <span class="meta-item">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    ${job.location || 'Hà Nội'}
                  </span>
                  <span class="meta-item">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                    ${job.workType || 'Toàn thời gian'}
                  </span>
                </div>

                <button class="btn-job-xem-them open-job-modal" data-job-id="${job.id}">
                  Xem thêm
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        `).join('');

        // Attach event listeners to newly rendered "Xem thêm" buttons & card clicks
        const openBtns = jobsGrid.querySelectorAll(".open-job-modal");
        openBtns.forEach(btn => {
          btn.addEventListener("click", function (e) {
            e.preventDefault();
            e.stopPropagation();
            const jobId = this.getAttribute("data-job-id");
            if (jobId) fetchAndShowJobDetail(jobId);
          });
        });

        const cards = jobsGrid.querySelectorAll(".job-card-v2");
        cards.forEach(card => {
          card.addEventListener("click", function (e) {
            if (e.target.closest(".open-job-modal")) return;
            const jobId = this.getAttribute("data-job-id");
            if (jobId) fetchAndShowJobDetail(jobId);
          });
        });

        // Check if deep link URL is present (/tuyen-dung/:id)
        checkDeepLinkUrl();
      }

      // 2. Fetch single job post detail from Backend API GET /api/recruitment/:id
      async function fetchAndShowJobDetail(jobId) {
        console.log("[FE] Fetching single job detail from Backend API: GET /api/recruitment/" + jobId);
        modalOverlay.classList.add("active");
        document.body.style.overflow = "hidden";

        modalBody.innerHTML = `
          <div class="job-modal-loading">
            <div class="modal-spinner-ring"></div>
            <span>Đang tải thông tin chi tiết bài tuyển dụng từ máy chủ API...</span>
          </div>
        `;

        try {
          const response = await fetch(`/api/recruitment/${jobId}`);
          const result = await response.json();

          if (result.success && result.data) {
            renderJobDetailModal(result.data);
          } else {
            modalBody.innerHTML = `
              <div class="job-modal-loading" style="color: #c0392b;">
                <p>⚠️ Không tìm thấy chi tiết bài tuyển dụng (${result.message || ''}).</p>
              </div>
            `;
          }
        } catch (err) {
          console.error("API Error fetching job detail:", err);
          modalBody.innerHTML = `
            <div class="job-modal-loading" style="color: #c0392b;">
              <p>⚠️ Lỗi kết nối API khi tải chi tiết bài tuyển dụng.</p>
            </div>
          `;
        }
      }

      // Render detailed job post inside modal
      function renderJobDetailModal(job) {
        let sectionsHtml = "";

        if (job.fullHtmlContent) {
          sectionsHtml = job.fullHtmlContent;
        } else if (job.sections && Array.isArray(job.sections)) {
          sectionsHtml = `
            <div class="old-web-article">
              <p class="article-intro">${job.summary || ""}</p>
              <div class="article-image-box">
                <img src="${job.thumbnail}" alt="${job.title}" class="article-main-img" />
              </div>
              ${job.sections.map(sec => `
                <h2 id="${sec.id || ''}" class="article-heading">${sec.title}</h2>
                ${sec.items ? `
                  <ul class="article-list">
                    ${sec.items.map(item => `<li>${item}</li>`).join('')}
                  </ul>
                ` : ''}
              `).join('')}
            </div>
          `;
        } else {
          sectionsHtml = `
            <div class="job-modal-section">
              <h3>📌 Mô tả công việc</h3>
              <ul>${(job.description || []).map(i => `<li>${i}</li>`).join('')}</ul>
            </div>
            <div class="job-modal-section">
              <h3>🎯 Yêu cầu ứng viên</h3>
              <ul>${(job.requirements || []).map(i => `<li>${i}</li>`).join('')}</ul>
            </div>
            <div class="job-modal-section">
              <h3>🎁 Quyền lợi được hưởng</h3>
              <ul>${(job.benefits || []).map(i => `<li>${i}</li>`).join('')}</ul>
            </div>
          `;
        }

        modalBody.innerHTML = `
          <div class="job-modal-header">
            <span class="job-modal-badge">${job.isHot ? '🔥 ĐANG HOT' : 'TUYỂN DỤNG'}</span>
            <h2 class="job-modal-title">${job.title}</h2>
            
            <div class="old-web-meta">
              <span>✍️ <strong>Viết bởi:</strong> ${job.author || 'Lê Sang'}</span>
              <span>📅 <strong>Ngày đăng:</strong> ${job.date || '29/06/2024'}</span>
              <span>📂 <strong>Danh mục:</strong> ${job.category || 'Tuyển dụng'}</span>
            </div>

            <div class="job-modal-quick-info">
              <span>💰 <strong>Mức lương:</strong> ${job.salary || 'Thỏa thuận'}</span>
              <span>📍 <strong>Địa điểm:</strong> ${job.location || 'Hà Nội'}</span>
              <span>💼 <strong>Hình thức:</strong> ${job.workType || 'Toàn thời gian'}</span>
              <span>⏳ <strong>Hạn nộp:</strong> ${job.deadline || '30/10/2026'}</span>
            </div>
          </div>

          <div class="job-modal-body-container">
            ${sectionsHtml}
          </div>

          <div class="job-modal-apply-box" style="background: #171717; color: #FFFFFF; padding: 1.25rem; border-radius: 12px; margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem;">
            <div class="apply-info">
              <h4 style="color: #C89B4B; margin: 0 0 0.35rem 0; font-size: 0.9375rem;">Gửi hồ sơ ứng tuyển ngay</h4>
              <p style="margin: 0 0 0.2rem 0; font-size: 0.8125rem; color: #DDDDDD;">Email tiếp nhận: <strong style="color: #FFF;">shomeluxurydesign@gmail.com</strong></p>
              <p style="margin: 0; font-size: 0.8125rem; color: #DDDDDD;">Hotline / Zalo tuyển dụng: <strong style="color: #FFF;">079999 7700</strong></p>
            </div>
            <a href="mailto:shomeluxurydesign@gmail.com?subject=Ứng tuyển ${encodeURIComponent(job.title)}" class="btn-cta-gold" style="align-self: flex-start;">
              Nộp hồ sơ ngay
            </a>
          </div>
        `;
      }

      function closeModal() {
        modalOverlay.classList.remove("active");
        document.body.style.overflow = "";
      }

      if (closeBtn) closeBtn.addEventListener("click", closeModal);
      if (modalOverlay) {
        modalOverlay.addEventListener("click", function (e) {
          if (e.target === modalOverlay) closeModal();
        });
      }

      function checkDeepLinkUrl() {
        const pathParts = window.location.pathname.split("/").filter(Boolean);
        if (pathParts.length >= 2 && pathParts[0] === "tuyen-dung") {
          const urlJobId = pathParts[1];
          if (urlJobId) fetchAndShowJobDetail(urlJobId);
        }
      }

      // Trigger initial Backend API fetch for recruitment jobs list
      fetchRecruitmentJobsList();
    });
  </script>

</body>
</html>
