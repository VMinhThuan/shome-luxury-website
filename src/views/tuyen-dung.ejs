<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no, viewport-fit=cover" />
  <title><%= title %></title>
  <meta name="description" content="Tuyển dụng SHOME LUXURY - Khám phá cơ hội nghề nghiệp trong ngành thiết kế kiến trúc và thi công nội thất gỗ công nghiệp cao cấp." />
  <meta name="theme-color" content="#171717" />

  <!-- Performance Preload Resource Hints -->
  <link rel="preload" href="/css/style.css?v=6.4.0" as="style" />
  <link rel="preload" href="/js/main.js?v=1.9.0" as="script" />
  <link rel="preload" href="/images/shome-logo.png" as="image" />
  <link rel="preload" href="/images/recruitment-hero-clean.png" as="image" />

  <!-- CSS Stylesheet -->
  <link rel="stylesheet" href="/css/style.css?v=6.4.0" />
  <script src="/js/main.js?v=1.9.0" defer></script>
</head>
<body class="page-recruitment">

  <!-- Header -->
  <%- include("partials/header") %>
  <%- include("partials/mobile-drawer") %>

  <main class="main-content">
    <!-- Recruitment Hero Banner (Full Width & Attached directly under Header) -->
    <!-- Recruitment Hero Banner (Full Width & Attached directly under Header) -->
    <section class="recruitment-banner-section">
      <div class="recruitment-banner-card">
        <img src="/images/recruitment-hero-clean.png" alt="Không gian nội thất cao cấp SHOME LUXURY" class="recruitment-banner-bg" width="1672" height="941" />
        
        <div class="recruitment-banner-overlay">
          <!-- Left Text Block -->
          <div class="recruitment-banner-text">
            <h1 class="recruitment-hero-title-main">Tuyển dụng</h1>
            <div class="recruitment-hero-script font-script">cùng kiến tạo</div>
            <div class="recruitment-hero-title-sub">giá trị!</div>

            <p class="recruitment-hero-subtext">
              GIA NHẬP SHOME LUXURY,<br>
              NƠI TÀI NĂNG ĐƯỢC TRÂN TRỌNG<br>
              VÀ PHÁT TRIỂN MỖI NGÀY
            </p>
          </div>

          <div class="recruitment-hero-top-right" aria-label="Thông điệp thương hiệu">
            <span>CON NGƯỜI</span>
            <span>KHÔNG GIAN</span>
            <span>GIÁ TRỊ</span>
          </div>

          <!-- Bottom Right Cursive Accent Text -->
          <div class="recruitment-hero-bottom-right font-script">
            More than Interior
          </div>
        </div>
      </div>

      <!-- Bottom Floating White Card Bar (4 Features Grid) -->
      <div class="recruitment-features-bar">
        <div class="container">
          <div class="features-card-inner">
            <div class="feature-col">
              <div class="feature-icon-badge">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 22 8.5 12 22 2 8.5 12 2"></polygon>
                  <line x1="2" y1="8.5" x2="22" y2="8.5"></line>
                  <line x1="12" y1="2" x2="8" y2="8.5"></line>
                  <line x1="12" y1="2" x2="16" y2="8.5"></line>
                  <line x1="8" y1="8.5" x2="12" y2="22"></line>
                  <line x1="16" y1="8.5" x2="12" y2="22"></line>
                </svg>
              </div>
              <div class="feature-text">
                <h3 class="feature-title">MÔI TRƯỜNG CHUYÊN NGHIỆP</h3>
                <p class="feature-desc">Đội ngũ tài năng, truyền cảm hứng</p>
              </div>
            </div>

            <div class="feature-col">
              <div class="feature-icon-badge">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
              </div>
              <div class="feature-text">
                <h3 class="feature-title">CƠ HỘI PHÁT TRIỂN</h3>
                <p class="feature-desc">Lộ trình rõ ràng, thăng tiến bền vững</p>
              </div>
            </div>

            <div class="feature-col">
              <div class="feature-icon-badge">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.78-8.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </div>
              <div class="feature-text">
                <h3 class="feature-title">PHÚC LỢI TOÀN DIỆN</h3>
                <p class="feature-desc">Thu nhập xứng đáng, chế độ hấp dẫn</p>
              </div>
            </div>

            <div class="feature-col">
              <div class="feature-icon-badge">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div class="feature-text">
                <h3 class="feature-title">VĂN HÓA NHÂN VĂN</h3>
                <p class="feature-desc">Cùng tạo nên những giá trị tốt đẹp</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="container">
      <!-- Recruitment Positions Section -->
      <section class="recruitment-jobs-section" id="cac-vi-tri-tuyen-dung">
        <div class="recruitment-header">
          <h2 class="gallery-v2-title">Vị trí đang tuyển dụng</h2>
          <p class="section-v2-desc" style="font-size: 0.875rem; color: #111111; margin: 0 0 0.5rem 0;">
            Khám phá cơ hội nghề nghiệp tại SHOME LUXURY
          </p>
        </div>

        <!-- Dynamic Jobs Grid Loaded via Backend API /api/recruitment -->
        <div class="recruitment-jobs-grid" id="recruitmentJobsGrid">
          <div class="job-modal-loading" style="grid-column: 1 / -1; padding: 3rem 0;">
            <div class="modal-spinner-ring"></div>
            <span>Đang tải danh sách các vị trí tuyển dụng...</span>
          </div>
        </div>
      </section>
    </div>
  </main>

  <!-- Footer -->
  <%- include("partials/footer") %>

  <!-- FE Script: Calls Backend API (/api/recruitment) and renders direct links -->
  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const jobsGrid = document.getElementById("recruitmentJobsGrid");

      // 1. Fetch recruitment list from Backend API /api/recruitment
      async function fetchRecruitmentJobsList() {
        try {
          console.log("[FE] Fetching jobs list from Backend API: GET /api/recruitment");
          const response = await fetch("/api/recruitment");
          const result = await response.json();

          if (result.success && Array.isArray(result.data)) {
            renderJobsGrid(result.data);
          } else {
            jobsGrid.innerHTML = `
              <div style="grid-column: 1 / -1; text-align: center; color: #c0392b; padding: 2rem;">
                <p>⚠️ Không thể tải danh sách bài tuyển dụng.</p>
              </div>
            `;
          }
        } catch (err) {
          console.error("API Error fetching jobs list:", err);
          jobsGrid.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; color: #c0392b; padding: 2rem;">
              <p>⚠️ Lỗi kết nối khi tải danh sách tuyển dụng.</p>
            </div>
          `;
        }
      }

      // Render job cards into grid dynamically with direct navigation links
      function renderJobsGrid(jobs) {
        if (!jobs || jobs.length === 0) {
          jobsGrid.innerHTML = '<p style="grid-column: 1 / -1; text-align: center;">Hiện chưa có vị trí tuyển dụng mới.</p>';
          return;
        }

        jobsGrid.innerHTML = jobs.map(job => `
          <div class="job-card-v2" onclick="window.location.href='/tuyen-dung/${job.id}'" style="cursor: pointer;">
            <a href="/tuyen-dung/${job.id}" class="job-card-thumb-link">
              <div class="job-card-thumb">
                <img src="${job.thumbnail}" alt="${job.title}" loading="lazy" width="400" height="250" />
              </div>
            </a>
            <div class="job-card-body">
              <h3 class="job-card-title"><a href="/tuyen-dung/${job.id}">${job.title}</a></h3>
              <p class="job-card-summary">${job.summary || ''}</p>
              
              <div class="job-card-footer">
                <div class="job-card-meta">
                  <span class="meta-item">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    ${job.location || 'Hà Nội'}
                  </span>
                  <span class="meta-item">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                      <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                    </svg>
                    ${job.workType || 'Toàn thời gian'}
                  </span>
                </div>

              </div>
            </div>
          </div>
        `).join('');
      }

      // Trigger initial Backend API fetch for recruitment jobs list
      fetchRecruitmentJobsList();
    });
  </script>

</body>
</html>
