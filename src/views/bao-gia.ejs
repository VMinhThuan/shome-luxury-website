    @media (max-width: 559px) { .quote-page .quote-workshop { width: 100%; }.quote-page .quote-workshop-main { aspect-ratio: 16 / 9; }.quote-page .quote-workshop-gallery { gap: .7rem; }.quote-page .quote-workshop-stats { margin-bottom: .9rem; }.quote-page .quote-workshop-stats div { padding: 0 .3rem; }.quote-page .quote-workshop-stats span { font-size: .6rem; }.quote-page .quote-workshop-main > span { bottom: 1.15rem; } }
