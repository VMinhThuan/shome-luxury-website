        border-radius: 0 13px 13px 0 !important;
        object-fit: cover !important;
        object-position: center !important;
      }
      .quote-page .quote-construction-copy {
        order: 1 !important;
        min-width: 0 !important;
        padding: .65rem .45rem .65rem .6rem !important;
      }
      .quote-page .quote-construction-copy .quote-kicker {
        margin-bottom: .18rem !important;
        font-size: clamp(.7rem, 3.2vw, .95rem) !important;
        line-height: 1 !important;
        white-space: nowrap !important;
      }
      .quote-page .quote-construction-copy h2 {
        margin-bottom: .3rem !important;
        font-size: clamp(1.05rem, 4.8vw, 1.65rem) !important;
        line-height: 1 !important;
        white-space: nowrap !important;
      }
      .quote-page .quote-construction-copy > p {
        margin-bottom: .35rem !important;
        font-size: clamp(.52rem, 2.1vw, .72rem) !important;
        line-height: 1.25 !important;
      }
      .quote-page .quote-construction-points {
        grid-template-columns: 1fr !important;
        gap: .2rem !important;
        margin-bottom: .45rem !important;
        font-size: clamp(.42rem, 1.8vw, .58rem) !important;
        line-height: 1.15 !important;
      }
      .quote-page .quote-construction-points span {
        gap: .3rem !important;
      }
      .quote-page .quote-construction-points i {
        width: .88rem !important;
        height: .88rem !important;
      }
      .quote-page .quote-construction-copy .quote-button {
        gap: .3rem !important;
        min-height: 26px !important;
        padding: .3rem .55rem !important;
        font-size: clamp(.42rem, 1.7vw, .56rem) !important;
      }
      .quote-page .quote-workshop-heading h2 { font-size: clamp(1.1rem, 5.25vw, 1.55rem); white-space: nowrap; }
      .quote-page .quote-workshop-heading h2 em { display: inline-block; margin: 0 0 0 .2em; font-size: 1.1em; line-height: 1; vertical-align: baseline; }
      /* Keep every paired brand-yellow heading on one compact mobile line. */
      .quote-page :is(.quote-heading, .quote-category-featured-heading, .quote-featured-heading, .quote-completed-heading, .quote-craftsmanship-heading, .quote-handover-heading) h2 { white-space: nowrap; }
      .quote-page .quote-heading h2 { font-size: clamp(1rem, 4.75vw, 1.42rem); }
      .quote-page .quote-category-featured-heading h2,
      .quote-page .quote-featured-heading h2,
      .quote-page .quote-completed-heading h2,
      .quote-page .quote-craftsmanship-heading h2,
      .quote-page .quote-handover-heading h2 { font-size: clamp(1.05rem, 5vw, 1.5rem); }
      .quote-page :is(.quote-heading, .quote-category-featured-heading, .quote-featured-heading, .quote-completed-heading, .quote-craftsmanship-heading, .quote-handover-heading) h2 em { display: inline-block; margin: 0 0 0 .18em !important; padding: 0 !important; font-size: 1.05em !important; line-height: 1; vertical-align: baseline; }
    }
    .quote-page .quote-featured-view-all { margin-top: clamp(1.25rem, 2.5vw, 2rem); text-align: center; }
    .quote-page .quote-featured-view-all a { display: inline-flex; align-items: center; gap: .65rem; min-height: 44px; padding: .65rem 1.35rem; border: 1px solid var(--accent-gold, #C89B4B); border-radius: 999px; background: var(--accent-gold, #C89B4B); color: #111111; font-family: var(--font-heading); font-size: clamp(.72rem, 1vw, .84rem); font-weight: 700; letter-spacing: .02em; box-shadow: 0 4px 14px rgba(200, 155, 75, 0.28); transition: all .25s ease; }
    .quote-page .quote-featured-view-all a:hover { background: var(--accent-gold-hover, #D2A653); border-color: var(--accent-gold-hover, #D2A653); color: #000000; transform: translateY(-2px); box-shadow: 0 6px 20px rgba(200, 155, 75, 0.45); }
    .quote-page .quote-featured-view-all span { color: #111111; font-size: 1.25em; transition: transform .2s ease; }
    .quote-page .quote-featured-view-all a:hover span { transform: translateX(3px); }
    .quote-page .quote-price-area b { display: inline-grid; width: 1.2em; height: 1.2em; margin-right: .55em; place-items: center; vertical-align: -.16em; }
    .quote-page .quote-free-estimate-copy li i {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 44px !important;
      height: 44px !important;
      min-width: 44px !important;
      min-height: 44px !important;
      max-width: 44px !important;
      max-height: 44px !important;
      flex: 0 0 44px !important;
      border-radius: 50% !important;
      border: 1.5px solid var(--quote-brand-yellow, #c47a1c) !important;
      color: var(--quote-brand-yellow, #c47a1c) !important;
      background: rgba(255, 255, 255, 0.85) !important;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }
    .quote-page .quote-free-estimate-copy li i svg {
      width: 22px !important;
      height: 22px !important;
      stroke: currentColor !important;
      stroke-width: 1.8 !important;
      fill: none !important;
    }
    .quote-page .quote-free-estimate-copy li {
      display: flex !important;
      align-items: center !important;
      gap: clamp(.65rem, 1.2vw, .95rem) !important;
      font-size: clamp(.85rem, 1.15vw, 1.02rem) !important;
      line-height: 1.35 !important;
      color: #2b2520 !important;
    }
    .quote-page .quote-free-estimate-copy li span {
      white-space: normal !important;
      flex: 1 1 auto;
    }
    @media (min-width: 768px) {
      /* The script lettering has a long descender, so reserve space before the supporting line. */
      .quote-page .quote-featured-heading h2 { margin: .25rem 0 2rem; }
      .quote-page .quote-featured-heading strong { margin: 0 auto; }

      /* Use the same desktop width as the navigation while preserving two detail cards per row. */
      .quote-page .quote-craftsmanship-inner {
        display: grid;
        width: 100%;
        max-width: var(--container-max);
        grid-template-columns: repeat(2, minmax(0, 1fr));
        align-items: start;
        gap: clamp(1.75rem, 3vw, 3rem) clamp(1.25rem, 2.5vw, 2.5rem);
      }
      .quote-page .quote-craftsmanship-heading { grid-column: 1 / -1; margin-bottom: 0; }
      .quote-page .quote-craft-group + .quote-craft-group { margin-top: 0; }
      .quote-page .quote-craft-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

      /* Compact FAQ cards to match the reference layout. */
      .quote-page .quote-final-faq-list { gap: clamp(.8rem, 1.2vw, 1.1rem); }
      .quote-page .quote-final-faq summary {
        grid-template-columns: auto minmax(0, 1fr) 20px !important;
        align-items: center !important;
        gap: .85rem;
        min-height: 72px;
        padding: .7rem 1.05rem;
      }
      .quote-page .quote-final-faq summary b {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        align-self: center !important;
        width: auto;
        min-width: 18px;
        height: auto;
        margin: 0 !important;
        background: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        color: var(--quote-brand-yellow) !important;
        font-family: var(--font-heading);
        font-size: clamp(1.1rem, 1.3vw, 1.3rem);
        font-weight: 700;
        line-height: 1;
      }
      .quote-page .quote-final-faq summary span {
        font-size: clamp(.95rem, 1.1vw, 1.1rem);
        line-height: 1.2;
      }
      .quote-page .quote-final-faq details p {
        margin: 0 1.05rem 1rem calc(1.05rem + 24px + .85rem);
        padding-left: 0;
      }
      .quote-page .quote-final-faq-chevron { width: 20px; height: 20px; }
      .quote-page .quote-final-faq-chevron svg { display: none; }
      .quote-page .quote-final-faq-chevron::before { content: '+'; color: currentColor; font-size: 1.7rem; font-style: normal; font-weight: 400; line-height: 1; }
      .quote-page .quote-final-faq details[open] .quote-final-faq-chevron { transform: none; }

      /* Keep the desktop page compact between consecutive content sections. */
      .quote-page > section:not(.quote-hero) {
        padding-top: clamp(.6rem, .8vw, 1rem) !important;
        padding-bottom: clamp(.6rem, .8vw, 1rem) !important;
      }
    }
    @media (max-width: 767px) {
      .quote-page .quote-price-copy h3 { font-size: clamp(1.35rem, 6vw, 1.65rem); }
      .quote-page .quote-free-estimate-copy h2 { font-size: clamp(1.75rem, 8vw, 2.35rem); white-space: nowrap; }
      .quote-page .quote-free-estimate-copy h2 em { white-space: normal; }
    }

    /* Tất cả các ảnh nội dung và khung ảnh trên trang báo giá có tỷ lệ 16:9 */
    .quote-page :is(
      .quote-featured-project-image,
      .quote-completed-video,
      .quote-workshop-main,
      .quote-workshop-gallery img,
      .quote-craft-photo,
      .quote-video-card,
      .quote-video-frame
    ) {
      aspect-ratio: 16 / 9 !important;
    }

    /* Keep the two full-width videos at compact cinematic ratio on desktop, normal 16:9 on mobile */
    @media (min-width: 768px) {
      .quote-page .quote-brand-video .quote-video-card,
      .quote-page .quote-brand-video .quote-video-frame,
      .quote-page .quote-workshop-video-card,
      .quote-page .quote-workshop-video-card .quote-video-frame {
        aspect-ratio: 32 / 9 !important;
      }
    }

    @media (max-width: 767px) {
      .quote-page .quote-brand-video .quote-video-card,
      .quote-page .quote-brand-video .quote-video-frame,
      .quote-page .quote-workshop-video-card,
      .quote-page .quote-workshop-video-card .quote-video-frame {
        aspect-ratio: 16 / 9 !important;
        border-radius: 14px;
      }
    }

    .quote-page :is(
      .quote-completed-video img,
      .quote-featured-project-image img,
      .quote-workshop-main img,
      .quote-workshop-gallery img,
      .quote-video-card > img
    ) {
      width: 100%;
      height: 100%;
      aspect-ratio: 16 / 9 !important;
      object-fit: cover;
    }

    /* Hiển thị 1 hàng 3 card cho section công trình chung cư nổi bật */
    .quote-page .quote-featured-project-list {
      display: grid;
      width: 100%;
      max-width: var(--container-max);
      gap: clamp(1rem, 1.8vw, 1.75rem);
      margin: 0 auto;
    }
    @media (min-width: 768px) {
      .quote-page .quote-featured-project-list {
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      }
    }

    /* Đồng bộ toàn bộ button nền vàng trang báo giá về màu vàng thương hiệu chuẩn */
    .quote-page :is(
      .quote-button,
      .quote-booking-button,
      .quote-construction-copy .quote-button,
      .quote-featured-view-all a,
      .quote-free-estimate-button,
      .quote-free-estimate-copy .quote-free-estimate-button
    ) {
      background: var(--accent-gold, #C89B4B) !important;
      background-color: var(--accent-gold, #C89B4B) !important;
      border: 1px solid var(--accent-gold, #C89B4B) !important;
      color: #111111 !important;
      font-weight: 700 !important;
      box-shadow: 0 4px 14px rgba(200, 155, 75, 0.28) !important;
    }
    .quote-page :is(
      .quote-button,
      .quote-booking-button,
      .quote-construction-copy .quote-button,
      .quote-featured-view-all a,
      .quote-free-estimate-button,
      .quote-free-estimate-copy .quote-free-estimate-button
    ):hover {
      background: var(--accent-gold-hover, #D2A653) !important;
      background-color: var(--accent-gold-hover, #D2A653) !important;
      border-color: var(--accent-gold-hover, #D2A653) !important;
      color: #000000 !important;
      transform: translateY(-2px) !important;
      box-shadow: 0 6px 20px rgba(200, 155, 75, 0.45) !important;
    }
    .quote-page :is(
      .quote-button,
      .quote-booking-button,
      .quote-construction-copy .quote-button,
      .quote-featured-view-all a,
      .quote-free-estimate-button,
      .quote-free-estimate-copy .quote-free-estimate-button
    ) :is(span, svg) {
      color: #111111 !important;
      stroke: #111111 !important;
    }
    .quote-page :is(
      .quote-button,
      .quote-booking-button,
      .quote-construction-copy .quote-button,
      .quote-featured-view-all a,
      .quote-free-estimate-button,
      .quote-free-estimate-copy .quote-free-estimate-button
    ):hover :is(span, svg) {
      color: #000000 !important;
      stroke: #000000 !important;
    }

    /* Chữ script góc phải hero */
    .quote-page .quote-hero-corner-script {
      position: absolute !important;
      z-index: 2 !important;
      right: 24px !important;
      bottom: clamp(1.8rem, 3.8vw, 3.5rem) !important;
      display: inline-flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      width: auto !important;
      max-width: none !important;
      color: var(--accent-gold, #C89B4B) !important;
      font-family: var(--font-script) !important;
      font-size: clamp(1.6rem, 2.7vw, 2.8rem) !important;
      font-weight: 500 !important;
      line-height: .88 !important;
      text-align: left !important;
      white-space: nowrap !important;
      transform: rotate(-10deg) !important;
      pointer-events: none !important;
      filter: drop-shadow(0 2px 8px rgba(255, 255, 255, 0.7)) !important;
    }
    .quote-page .quote-hero-corner-script .quote-hero-corner-line1 {
      display: block !important;
      padding-left: .25em !important;
      white-space: nowrap !important;
    }
    .quote-page .quote-hero-corner-script .quote-hero-corner-line2 {
      display: block !important;
      white-space: nowrap !important;
      position: relative !important;
    }
    .quote-page .quote-hero-corner-script .quote-hero-corner-line2::after {
      content: '' !important;
      display: block !important;
      width: 110% !important;
      height: 1.5px !important;
      background: linear-gradient(90deg, var(--accent-gold, #C89B4B) 0%, rgba(200, 155, 75, 0.15) 100%) !important;
      margin-top: 3px !important;
      border-radius: 2px !important;
    }
    @media (max-width: 1023px) {
      .quote-page .quote-hero-corner-script {
        right: 20px !important;
        bottom: 1.6rem !important;
        font-size: clamp(1.3rem, 2.6vw, 1.8rem) !important;
      }
    }
    @media (max-width: 767px) {
      .quote-page .quote-hero-corner-script {
        right: var(--mobile-page-spacing) !important;
        bottom: .8rem !important;
        font-size: clamp(1rem, 3.8vw, 1.25rem) !important;
        transform: rotate(-8deg) !important;
      }
    }

    /* Kích thước tiêu đề Câu hỏi thường gặp bằng chính xác tiêu đề Thiết kế thi công nội thất */
    .quote-page .quote-final-faq h2 {
      font-size: clamp(1.55rem, 3vw, 2.6rem) !important;
      font-weight: 800 !important;
      letter-spacing: -.055em !important;
      line-height: 1.1 !important;
    }
    @media (max-width: 767px) {
      .quote-page .quote-final-faq h2 {
        font-size: clamp(1.3rem, 6vw, 1.7rem) !important;
      }
    }

    /* Đảm bảo số 1. 2. 3. căn giữa tuyệt đối theo chiều dọc với khối nội dung (cả mobile & desktop) */
    .quote-page .quote-final-faq details summary {
      display: grid !important;
      grid-template-columns: auto minmax(0, 1fr) auto !important;
      align-items: center !important;
    }
    .quote-page .quote-final-faq details summary b {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      align-self: center !important;
      line-height: 1 !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .quote-page .quote-final-faq details summary span {
      align-self: center !important;
    }
    .quote-page .quote-final-faq details summary i,
    .quote-page .quote-final-faq details summary .quote-final-faq-chevron {
      align-self: center !important;
      display: grid !important;
      place-items: center !important;
      margin: 0 !important;
    }
    .quote-page .quote-handover-list .quote-handover-item {
      display: grid !important;
      grid-template-columns: auto 1fr !important;
      align-items: center !important;
    }
    .quote-page .quote-handover-list .quote-handover-item b {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      align-self: center !important;
      line-height: 1 !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .quote-page .quote-handover-list .quote-handover-item > div {
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-self: center !important;
    }
  </style>
  <script src="/js/main.js?v=1.9.1" defer></script>
  <script src="/js/quote-page.js?v=1.2.1" defer></script>
</head>
<body>
  <%- include('partials/header') %>
  <%- include('partials/mobile-drawer') %>
  <main id="main-content" class="quote-page">
    <% if (sections.hero?.isVisible !== false) { %>
      <section class="quote-hero" style="--quote-hero-image: url('<%= sections.hero.image %>')">
        <div class="container quote-hero-inner">
          <div class="quote-hero-copy quote-brochure-copy">
            <% const quoteTitleMatch = /^(.*)\s+(trọn gói)$/i.exec(quoteTitle); %>
            <h1>
              <em><%= quoteScript || 'Nội thất' %></em>
              <span class="quote-hero-title-main">
                <span class="quote-title-line1"><%= quoteTitleMatch ? quoteTitleMatch[1] : quoteTitle %></span>
                <% if (quoteTitleMatch) { %>
                  <span class="quote-title-line2"><%= quoteTitleMatch[2] %></span>
                <% } %>
              </span>
            </h1>
            <p class="quote-lead"><%= sections.hero.description %></p>
            <div class="quote-hero-traits">
              <span>TINH TẾ</span>
              <i></i>
              <span>ĐẲNG CẤP</span>
              <i></i>
              <span>KHÁC BIỆT</span>
            </div>
          </div>
          <%
            const cornerScriptRaw = sections.hero.cornerScript || 'Không gian\nkiến tạo hạnh phúc';
            const cornerScriptLines = cornerScriptRaw.trim().split(/\r?\n/);
            const line1 = cornerScriptLines[0] || 'Không gian';
            const line2 = cornerScriptLines.slice(1).join(' ') || 'kiến tạo hạnh phúc';
          %>
          <div class="quote-hero-corner-script">
            <span class="quote-hero-corner-line1"><%= line1 %></span>
            <span class="quote-hero-corner-line2"><%= line2 %></span>
          </div>
        </div>
      </section>
    <% } %>

    <% if (sections.benefits?.isVisible !== false) { %>
      <section class="quote-section quote-benefits">
        <div class="container">
          <header class="quote-heading quote-heading-center quote-benefits-heading"><p class="quote-kicker"><%= sections.benefits.title %></p><h2><%= sections.benefits.script %></h2><p><%= sections.benefits.description %></p></header>
          <div class="quote-benefit-grid">
            <% sections.benefits.items.filter(item => item.isVisible !== false).forEach((item, index) => { %>
              <% const benefitIcons = ['/images/icon-1-baogia.png', '/images/icon-2-bg.png', '/images/ic3-bg.png']; %>
              <article class="quote-benefit-card"><span class="quote-number">0<%= index + 1 %></span><div class="quote-benefit-icon" aria-hidden="true"><img src="<%= benefitIcons[index] %>" alt="" /></div><div class="quote-benefit-copy"><h3><%= item.title %></h3><p><%= item.description %></p></div></article>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (sections.pricing?.isVisible !== false) { %>
      <section class="quote-section quote-pricing" id="bao-gia-tham-khao"><div class="container"><header class="quote-heading quote-heading-center"><p class="quote-kicker"><%= sections.pricing.eyebrow %></p><h2><%= sections.pricing.title %> <em><%= sections.pricing.script %></em></h2><p><%= sections.pricing.description %></p></header><div class="quote-pricing-list"><% sections.pricing.items.filter(item => item.isVisible !== false).sort((a,b) => (a.order||0)-(b.order||0)).forEach((item, index) => { %><article class="quote-price-card"><div class="quote-price-image" role="img" aria-label="<%= item.title %>" style="--pricing-image-position: <%= index === 0 ? 'left' : index === 1 ? 'center' : 'right' %>"></div><div class="quote-price-copy"><span class="quote-price-title"><%= item.title %></span><h3><span class="quote-price-prefix">Chỉ từ</span><%= item.price || '' %></h3><p><%= item.description %></p><span class="quote-price-area"><b aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M9 3H3v6m0-6 6 6M15 3h6v6m0-6-6 6M9 21H3v-6m0 6 6-6m6 6-6-6"/></svg></b><%= item.area || '' %></span><a class="quote-text-link" href="<%= item.ctaHref %>"><%= item.ctaLabel %> <span>→</span></a></div></article><% }) %></div></div></section>
    <% } %>

    <% if (sections.constructionCta?.isVisible !== false) { %>
      <section class="quote-construction-cta">
        <div class="container">
          <div class="quote-construction-card">
            <div class="quote-construction-copy">
              <p class="quote-kicker"><%= sections.constructionCta.eyebrow %></p>
              <h2><%= sections.constructionCta.title %></h2>
              <p><%= sections.constructionCta.description %></p>
              <div class="quote-construction-points">
                <span><i aria-hidden="true"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="7" rx="6.5" ry="2.5"/><path d="M5.5 7v5c0 1.4 2.9 2.5 6.5 2.5s6.5-1.1 6.5-2.5V7M5.5 12v5c0 1.4 2.9 2.5 6.5 2.5s6.5-1.1 6.5-2.5v-5"/></svg></i>Tối ưu chi phí</span>
                <span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 3 7 5-7 13L5 8l7-5Z"/><path d="m5 8 7 4 7-4M12 12v9"/></svg></i>Đồng bộ thẩm mỹ</span>
                <span><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V20H4v-9.5Z"/><path d="M9 20v-5h6v5"/></svg></i>Trọn gói cho căn hộ, nhà phố, văn phòng</span>
              </div>
              <a class="quote-button quote-booking-button" href="/dat-lich-ngay"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg><span>Đặt lịch ngay</span></a>
            </div>
            <img src="<%= sections.constructionCta.image %>" alt="Thi công nội thất Shome Luxury" loading="lazy" />
          </div>
        </div>
      </section>
    <% } %>

    <% if (sections.categories?.isVisible !== false) { %>
      <section class="quote-section quote-category-section" id="cong-trinh-thiet-ke">
        <div class="container">
          <header class="quote-featured-heading"><h2>Thiết kế <em>Chung Cư</em></h2><strong>Nội thất căn hộ chung cư hiện đại, tối ưu công năng từng phòng chức năng.</strong></header>
          <% if (highlightProjects.length) { %>
            <div class="quote-featured-project-list">
              <% highlightProjects.slice(0, 3).forEach((project, index) => {
                   const projectImage = project.thumbnail || '/images/quote-featured-villa-living-room.png';
                   const fallbackGalleryImages = ['/images/project_apartment.jpg', '/images/project_villa.jpg', '/images/hero_interior.jpg', '/images/hero_sofa_light.jpg', '/images/service_interior.jpg'];
