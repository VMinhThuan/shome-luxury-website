        min-height: 236px;
        place-items: center;
        margin-top: clamp(1.1rem, 1.5vw, 1.4rem) !important;
        padding: 2rem !important;
        border-radius: 18px !important;
        box-sizing: border-box;
      }
      .quote-page .home-faq-cta h3 {
        /* Match the black FAQ heading's exact visual hierarchy. */
        font-family: var(--font-heading) !important;
        font-size: 40px !important;
        font-weight: 800 !important;
        line-height: 1.25 !important;
      }
      .quote-page .home-faq-cta p {
        font-size: clamp(.96rem, 1.1vw, 1.08rem) !important;
      }
      .quote-page .home-faq-cta button {
        width: min(100%, 544px) !important;
        min-height: 54px !important;
        font-size: .98rem !important;
      }
    }

    /* Keep the three assurance cards pure white; avoid warm translucent fills
       picking up a cream cast from their previous background layers. */
    .quote-page .quote-benefits,
    .quote-page .quote-benefit-grid,
    .quote-page .quote-benefit-card,
    .quote-page .quote-benefit-icon {
      background: #FFFFFF !important;
    }
    .quote-page .quote-benefit-card {
      border-color: #ECECEC !important;
      box-shadow: 0 8px 22px rgba(20, 20, 20, .06) !important;
    }

    /* One black type system for quotation headings and card labels. */
    .quote-page :is(
      .quote-heading h2,
      .quote-featured-heading h2,
      .quote-completed-heading h2,
      .quote-workshop-heading h2,
      .quote-craftsmanship-heading h2,
      .quote-handover-heading h2,
      .quote-benefit-card h3,
      .quote-price-title,
      .quote-featured-project-info h3,
      .home-faq-item summary,
      .home-faq-cta h3
    ) {
      color: #1D1D1D !important;
      font-family: var(--font-heading) !important;
      font-weight: 700 !important;
    }
    .quote-page .home-faq-cta h3 { font-weight: 800 !important; }

    /* Inline quotation-page styles load after the shared stylesheet, so make
       its handwritten gold labels obey the same brand token and stroke. */
    .quote-page :is(.font-script, [class*="script"], h1 em, h2 em) {
      color: var(--accent-gold) !important;
      font-family: var(--font-script) !important;
      font-weight: 700 !important;
      font-synthesis: weight;
      -webkit-text-stroke: .85px currentColor;
      text-stroke: .85px currentColor;
      text-shadow: 0 0 .45px currentColor;
    }
    .quote-page .quote-completed-heading h2 .font-script {
      letter-spacing: 0 !important;
      text-transform: none !important;
    }
    @media (min-width: 768px) {
      .quote-page :is(
        .quote-heading h2,
        .quote-featured-heading h2,
        .quote-completed-heading h2,
        .quote-workshop-heading h2,
        .quote-craftsmanship-heading h2,
        .quote-handover-heading h2,
        .quote-construction-copy h2,
        .quote-free-estimate-copy h2
      ),
      .quote-page :is(
        .quote-heading h2 em,
        .quote-featured-heading h2 em,
        .quote-completed-heading h2 em,
        .quote-workshop-heading h2 em,
        .quote-craftsmanship-heading h2 em,
        .quote-handover-heading h2 em,
        .quote-construction-copy h2 em,
        .quote-free-estimate-copy h2 em
      ) {
        font-size: 40px !important;
      }
    }
    @media (max-width: 767px) {
      .quote-page .quote-completed-heading h2 {
        font-size: clamp(.9rem, 4.3vw, 1.25rem) !important;
      }
    }
    .quote-page :is(
      .quote-kicker,
      .quote-completed-heading p,
      .quote-category-featured-heading > p,
      .quote-price-copy h3,
      .quote-price-area b,
      .quote-construction-points i,
      .quote-video-heading p,
      .quote-featured-heading p,
      .quote-final-faq-chevron
    ) { color: var(--accent-gold) !important; }

    /* Keep the original interior artwork visible; only add a soft dark scrim
       behind the left-hand copy instead of washing the banner out in white. */
    .quote-page .quote-hero-carousel .quote-hero-slide::before {
      background: linear-gradient(90deg, rgba(16, 12, 8, .78) 0%, rgba(16, 12, 8, .58) 34%, rgba(16, 12, 8, .2) 57%, transparent 75%) !important;
    }
    .quote-page .quote-hero-carousel .quote-brochure-copy {
      background: transparent !important;
    }
    .quote-page .quote-hero-carousel .quote-brochure-copy h1 .quote-title-line1,
    .quote-page .quote-hero-carousel .quote-brochure-copy h1 .quote-title-line2 {
      color: #ffffff !important;
      text-shadow: 0 2px 12px rgba(0, 0, 0, .62) !important;
    }
    .quote-page .quote-hero-carousel .quote-brochure-copy .quote-lead {
      color: rgba(255, 255, 255, .9) !important;
      text-shadow: 0 1px 8px rgba(0, 0, 0, .55) !important;
    }
    .quote-page .quote-hero-carousel .quote-hero-corner-script {
      color: #e1aa3e !important;
      font-weight: 700 !important;
      -webkit-text-stroke: .35px currentColor;
      text-stroke: .35px currentColor;
      filter: drop-shadow(0 2px 3px rgba(0, 0, 0, .82)) !important;
      opacity: 1 !important;
    }
    .quote-page .quote-hero-carousel .quote-hero-corner-script .quote-hero-corner-line2::after {
      background: linear-gradient(90deg, #e1aa3e 0%, rgba(225, 170, 62, .8) 100%) !important;
    }

    /* Pricing amounts use the same gold handwritten treatment as the paired headings. */
    .quote-page .quote-price-copy h3 {
      display: flex;
      align-items: baseline;
      gap: .16em;
      font-family: var(--font-heading) !important;
      letter-spacing: 0 !important;
    }
    .quote-page .quote-price-prefix {
      margin-right: 0 !important;
      color: var(--accent-gold) !important;
    }
    .quote-page .quote-price-amount {
      display: inline-block;
      color: var(--accent-gold) !important;
      font-family: var(--font-heading) !important;
      font-size: 1.18em;
      font-weight: 800;
      line-height: 1;
      letter-spacing: 0;
      white-space: nowrap;
    }

    /* The script word starts after a deliberate gap instead of touching the title. */
    .quote-page .quote-completed-heading h2 em {
      display: inline-block !important;
      margin-left: .32em !important;
      vertical-align: baseline;
    }
    @media (max-width: 767px) {
      .quote-page .quote-completed-heading h2 em { margin-left: .25em !important; }
      .quote-page .quote-price-amount { font-size: 1.1em; }
    }

    /* On desktop, keep the apartment package title on one line and use the
       same sans-serif heading family as the black section headings below. */
    @media (min-width: 768px) {
      .quote-page .quote-hero-carousel .quote-brochure-copy h1 .quote-hero-title-main {
        white-space: nowrap !important;
      }
      .quote-page .quote-hero-carousel .quote-brochure-copy h1 .quote-title-line1,
      .quote-page .quote-hero-carousel .quote-brochure-copy h1 .quote-title-line2 {
        display: inline !important;
        font-family: var(--font-heading) !important;
        font-size: clamp(2rem, 3.2vw, 3.45rem) !important;
        font-weight: 800 !important;
        letter-spacing: -.035em !important;
        line-height: 1 !important;
        text-transform: none !important;
      }
      .quote-page .quote-hero-carousel .quote-brochure-copy h1 .quote-title-line2 {
        margin: 0 0 0 .24em !important;
      }
    }

    /* The carousel previously used an auto-height scroll track on phones.
       Because its slides are background-only elements, the track could
       collapse to zero height and hide all three banners. Keep one explicit
       16:9 viewport, then let the shared hero slider scroll its three slides. */
    @media (max-width: 767px) {
      .quote-page .quote-hero.quote-hero-carousel {
        position: relative !important;
        height: 56.25vw !important;
        min-height: 0 !important;
        overflow: hidden !important;
      }
      .quote-page .quote-hero-carousel .quote-hero-slider-track {
        position: absolute !important;
        inset: 0 !important;
        height: 100% !important;
      }
      .quote-page .quote-hero-carousel .quote-hero-slide {
        display: flex !important;
        height: 100% !important;
        min-height: 100% !important;
        aspect-ratio: auto !important;
        /* The desktop banner is a background fallback. On phones the
           picture/source pair below must be the only visible artwork. */
        background: none !important;
      }
      .quote-page .quote-hero-carousel .quote-hero-media {
        position: absolute;
        inset: 0;
        display: block;
        z-index: 0;
      }
      .quote-page .quote-hero-carousel .quote-hero-media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
      }

      /* Keep this paired heading intentionally on two readable lines only
         on phones; desktop retains the single editorial line. */
      .quote-page .quote-handover-heading h2 {
        display: block !important;
        white-space: normal !important;
        line-height: 1.05 !important;
      }
      .quote-page .quote-handover-heading h2 em {
        display: block !important;
        margin: .12em 0 0 !important;
        font-size: 1.15em !important;
        line-height: .85 !important;
      }
    }
    @media (min-width: 768px) {
      .quote-page .quote-hero-carousel .quote-hero-media { display: none; }
    }
    /* Complimentary-design feature: retain the wide composition and give the room
       photo more vertical room without turning the entire promotion into a 16:9 card. */
    @media (min-width: 768px) {
      .quote-page .quote-construction-card {
        aspect-ratio: auto !important;
        min-height: clamp(360px, 27vw, 460px) !important;
      }
      .quote-page .quote-construction-copy {
        padding: clamp(1.5rem, 3vw, 3rem) clamp(1.4rem, 3.2vw, 3.2rem) !important;
      }
      .quote-page .quote-construction-copy .quote-kicker {
        font-size: clamp(1rem, 1.55vw, 1.6rem) !important;
      }
      .quote-page .quote-construction-copy h2 {
        font-size: clamp(1.8rem, 3.25vw, 3.25rem) !important;
      }
      .quote-page .quote-construction-copy > p {
        font-size: clamp(.78rem, 1.25vw, 1.18rem) !important;
        line-height: 1.4 !important;
      }
      .quote-page .quote-construction-points {
        gap: clamp(.4rem, .8vw, .75rem) !important;
        font-size: clamp(.67rem, 1vw, .98rem) !important;
      }
      .quote-page .quote-construction-copy .quote-button {
        min-height: clamp(36px, 3vw, 50px) !important;
        font-size: clamp(.62rem, .92vw, .9rem) !important;
      }
    }
    /* Use the same refined, lighter handwritten gold accent as the other
       site pages. Price figures are intentionally a little quieter. */
    .quote-page :is(
      .quote-brochure-copy h1 em,
      .quote-hero-corner-script,
      .customer-stories-script,
      .home-faq-script,
      .quote-heading h2 em,
      .quote-featured-heading h2 em,
      .quote-completed-heading h2 em,
      .quote-workshop-heading h2 em,
      .quote-craftsmanship-heading h2 em,
      .quote-handover-heading h2 em,
      .quote-construction-copy h2,
      .quote-video-copy h3,
      .quote-free-estimate-copy h2 em
    ) {
      font-weight: 400 !important;
      font-synthesis: none !important;
      -webkit-text-stroke: 0 !important;
      text-stroke: 0 !important;
      text-shadow: none !important;
    }

    @media (min-width: 768px) {
      .quote-page .quote-completed-heading h2 em {
        margin-left: .58em !important;
      }

      .quote-page .quote-price-copy h3 {
        font-size: clamp(1.35rem, 2vw, 1.95rem) !important;
      }

      .quote-page .quote-price-amount {
        font-size: 1.04em;
      }

      .quote-page .quote-construction-image-section,
      .quote-page .quote-construction-image-only {
        height: 50dvh;
        min-height: 50dvh;
      }
    }

    .quote-page .quote-construction-image-section {
      /* Match the content box of the three pricing cards above. The section
         also carries .container, so its 24px desktop inset is intentional. */
      padding: 0 24px !important;
      margin-top: -1px;
      width: 100% !important;
      max-width: var(--container-max) !important;
      margin-right: auto;
      margin-left: auto;
      box-sizing: border-box;
      height: var(--subpage-banner-height) !important;
      min-height: var(--subpage-banner-height) !important;
      max-height: var(--subpage-banner-height) !important;
      background: #fff;
    }

    .quote-page .quote-pricing {
      padding-bottom: 0 !important;
    }

    .quote-page .quote-construction-image-only {
      display: block !important;
      width: 100%;
      height: 100%;
      min-height: 100%;
      margin: 0;
      overflow: hidden;
      border: 0 !important;
      border-radius: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
    }

    .quote-page .quote-construction-image-only > img {
      display: block;
      width: 100% !important;
      height: 100% !important;
      min-height: 100% !important;
      max-height: 100% !important;
      border-radius: 0 !important;
      object-fit: cover;
      object-position: center;
    }

    @media (max-width: 767px) {
      .quote-page .quote-construction-image-section,
      .quote-page .quote-construction-image-only {
        height: 56.25vw !important;
        min-height: 0 !important;
        max-height: none !important;
      }
      .quote-page .quote-construction-image-section {
        width: 100% !important;
        max-width: none !important;
        padding: 0 16px !important;
        margin-top: 1rem !important;
      }

      /* Keep the pricing cards as real stacked cards on phones. The previous
         image-only override forced the square source artwork into a 16:9
         crop, hid the copy and made consecutive cards look glued together. */
      .quote-page .quote-pricing-list {
        width: 100% !important;
        display: grid !important;
        grid-template-columns: 1fr !important;
        gap: 1rem !important;
      }

      .quote-page .quote-price-card {
        display: grid !important;
        grid-template-columns: 1fr !important;
        width: 100% !important;
        min-height: 0 !important;
        padding: 0 !important;
        border: 1px solid rgba(233, 223, 208, .95) !important;
        border-radius: 16px !important;
        background: rgba(255, 255, 255, .94) !important;
        box-shadow: 0 8px 22px rgba(72, 48, 23, .07) !important;
        aspect-ratio: auto !important;
      }

      .quote-page .quote-price-image {
        display: block !important;
        width: 100% !important;
        height: auto !important;
        min-width: 0 !important;
        min-height: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        border-radius: 15px 15px 0 0 !important;
        aspect-ratio: 16 / 9 !important;
        background-size: cover !important;
        background-position: center !important;
      }

      .quote-page .quote-price-image img {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 0 !important;
        border-radius: 15px 15px 0 0 !important;
        object-fit: cover !important;
        object-position: center !important;
      }

      .quote-page .quote-price-copy {
        display: flex !important;
        min-width: 0 !important;
        padding: .85rem 1rem 1rem !important;
        overflow: visible !important;
      }

      .quote-page .quote-price-copy::before {
        display: none !important;
      }

      .quote-page .quote-price-copy h3 {
        margin: .15rem 0 .3rem !important;
        font-size: clamp(1.45rem, 7vw, 2rem) !important;
      }

      .quote-page .quote-price-copy p {
        margin-bottom: .5rem !important;
        font-size: .78rem !important;
      }

      /* The construction artwork follows the pricing cards and should use
         the same rounded-card treatment instead of touching the next section. */
      .quote-page .quote-construction-image-only {
        height: 100% !important;
        min-height: 100% !important;
        border-radius: 16px !important;
        box-shadow: 0 8px 22px rgba(72, 48, 23, .07) !important;
      }

      .quote-page .quote-construction-image-only > img {
        border-radius: inherit !important;
      }
    }
  </style>
  <script src="/js/main.js?v=2.0.3" defer></script>
  <script src="/js/quote-page.js?v=1.2.3" defer></script>
</head>
<body>
  <% const quoteProjectUrls = { 'tk-kt-nha-cap-4': '/thiet-ke-kien-truc/nha-cap-4', 'tk-kt-nha-pho': '/thiet-ke-kien-truc/nha-pho', 'tk-kt-biet-thu': '/thiet-ke-kien-truc/biet-thu', 'tk-kt-villa': '/thiet-ke-kien-truc/villa', 'tk-nt-chung-cu': '/thiet-ke-noi-that/chung-cu', 'tk-nt-nha-pho': '/thiet-ke-noi-that/nha-pho', 'tk-nt-biet-thu': '/thiet-ke-noi-that/biet-thu', 'tk-nt-van-phong': '/thiet-ke-noi-that/van-phong' }; const dynamicProjectUrl = quoteProjectUrls[selectedCategory?.code] || '/thiet-ke-cong-trinh'; %>
  <%- include('partials/header') %>
  <%- include('partials/mobile-drawer') %>
  <main id="main-content" class="quote-page">
    <% if (sections.hero?.isVisible !== false) { %>
      <% /* Keep one source of truth for every slide so mobile and desktop show
             the same hero artwork; only the responsive crop may differ. */
         const quoteHeroSlides = [
           (locals.quoteImages && quoteImages.quote_hero_banner_1) || sections.hero.image,
           (locals.quoteImages && quoteImages.quote_hero_banner_2) || '/images/quote-hero-banner-bedroom.png',
           (locals.quoteImages && quoteImages.quote_hero_banner_3) || '/images/quote-hero-banner-dining.png'
         ]; %>
      <section class="quote-hero quote-hero-carousel subpage-banner-frame" aria-label="Banner báo giá">
        <div class="hero-slider-track quote-hero-slider-track" id="quoteHeroSliderTrack" data-hero-slider data-hero-dots="quoteHeroSliderDots" aria-label="Danh sách banner báo giá">
          <% quoteHeroSlides.forEach((image, index) => { %>
            <div class="hero-slide quote-hero-slide" data-slide-index="<%= index %>" aria-label="Banner báo giá <%= index + 1 %> trên 3" style="--quote-hero-image: url('<%= image %>')">
              <picture class="quote-hero-media" aria-hidden="true">
                <img src="<%= image %>" alt="" width="1536" height="1024" <%= index === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async" />
              </picture>
            </div>
          <% }) %>
        </div>
        <div class="hero-slider-dots" id="quoteHeroSliderDots" role="tablist" aria-label="Chọn banner báo giá"></div>
      </section>
    <% } %>

    <% if (sections.benefits?.isVisible !== false) { %>
      <section class="quote-section quote-benefits">
        <div class="container">
          <header class="quote-heading quote-heading-center quote-benefits-heading"><p class="quote-kicker"><%= sections.benefits.title %></p><h2><%= sections.benefits.script %></h2><p><%= sections.benefits.description %></p></header>
          <div class="quote-benefit-grid">
            <% sections.benefits.items.filter(item => item.isVisible !== false).forEach((item, index) => { %>
              <% const benefitIcons = [
                (locals.quoteImages && quoteImages.quote_benefit_icon_1) || '/images/icon-1-baogia.png',
                (locals.quoteImages && quoteImages.quote_benefit_icon_2) || '/images/icon-2-bg.png',
                (locals.quoteImages && quoteImages.quote_benefit_icon_3) || '/images/ic3-bg.png'
              ]; %>
              <article class="quote-benefit-card"><span class="quote-number">0<%= index + 1 %></span><div class="quote-benefit-icon" aria-hidden="true"><img src="<%= benefitIcons[index] %>" alt="" /></div><div class="quote-benefit-copy"><h3><%= item.title %></h3><p><%= item.description %></p></div></article>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (sections.pricing?.isVisible !== false) { %>
      <section class="quote-section quote-pricing" id="bao-gia-tham-khao">
        <div class="container">
          <header class="quote-heading quote-heading-center">
            <p class="quote-kicker"><%= sections.pricing.eyebrow %></p>
            <h2><%= quotePricingTitle || sections.pricing.title %> <em><%= featuredCategoryName || sections.pricing.script %></em></h2>
            <p><%= sections.pricing.description %></p>
          </header>
          <div class="quote-pricing-list">
            <% sections.pricing.items.filter(item => item.isVisible !== false).sort((a,b) => (a.order||0)-(b.order||0)).forEach((item, index) => {
                 const slotKey = `quote_pricing_image_${index + 1}`;
                 const defaultImg = `/images/quote-pricing-${index + 1}.png`;
                 const slotImg = (locals.quoteImages && quoteImages[slotKey]) || '';
                 const itemImg = item.image && !item.image.includes('anh_san_pham_') ? item.image : '';
                 const isSlotCustom = Boolean(slotImg && slotImg !== defaultImg);
                 const isItemCustom = Boolean(itemImg && itemImg !== defaultImg);
                 const cardImage = isSlotCustom ? slotImg : (isItemCustom ? itemImg : (slotImg || itemImg || defaultImg));
            %>
              <article class="quote-price-card">
                <div class="quote-price-image" role="img" aria-label="<%= item.title %>" style="background-image: url('<%= cardImage %>'); background-size: cover; background-position: center;">
                  <img src="<%= cardImage %>" alt="<%= item.title %>" loading="lazy" />
                </div>
                <div class="quote-price-copy">
                  <span class="quote-price-title"><%= item.title %></span>
                  <h3><span class="quote-price-prefix">Chỉ từ</span><span class="quote-price-amount"><%= item.price || '' %></span></h3>
                  <p><%= item.description %></p>
                  <span class="quote-price-area">Diện tích <%= (item.area || '').replace(/^70 - 100m²$/, '= 70 - 100m²') %></span>
                  <a class="quote-text-link" href="<%= item.ctaHref %>"><%= item.ctaLabel %> <span>→</span></a>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <% if (sections.constructionCta?.isVisible !== false) { %>
      <% const quoteConstructionImage = (locals.quoteImages && quoteImages.quote_construction_cta_image)
        || sections.constructionCta.image
        || '/images/quote-construction-interior.png'; %>
      <section class="quote-construction-image-section container" aria-label="Hình ảnh thi công nội thất">
        <figure class="quote-construction-image-only">
          <img src="<%= quoteConstructionImage %>" alt="Hình ảnh thi công nội thất Shome Luxury" loading="lazy" decoding="async" />
        </figure>
      </section>
    <% } %>

    <% /* Restored legacy featured-project section from the pre-8876c5a layout. */ %>
    <% if (selectedCategory) { %>
      <section class="quote-section quote-category-section quote-category-overview" id="cong-trinh-thiet-ke">
        <div class="container">
          <header class="quote-featured-heading">
            <h2>Một số công trình <em>tiêu biểu</em></h2>
            <strong>Các công trình <%= quoteScript.toLowerCase() %> <%= featuredCategoryName.toLowerCase() %> được hoàn thiện chỉn chu, tối ưu công năng và thẩm mỹ.</strong>
          </header>
          <% if (highlightProjects.length) { %>
            <div class="quote-featured-project-list">
              <% highlightProjects.slice(0, 5).forEach((project, index) => {
                   const projectImage = project.thumbnail || '';
                   const galleryImages = [...new Set([projectImage, ...(project.gallery || [])].filter(Boolean))];
                   const costLabel = project.cost ? `${Math.round(project.cost / 1000000)} triệu` : 'Liên hệ tư vấn';
                   const overlays = [
                     { title: 'Không gian truyền cảm hứng', sub: 'Mỗi góc nhỏ đều kể một câu chuyện' },
                     { title: 'Tinh giản cho cuộc sống trọn vẹn', sub: 'Sống thoải mái trong không gian dành cho bạn' },
                     { title: 'Đẳng cấp trong từng chi tiết', sub: 'Kiến tạo tổ ấm sang trọng và tiện nghi' }
                   ];
                   const overlay = overlays[index % overlays.length];
              %>
                <article class="quote-featured-project-card">
                  <button class="quote-featured-project-image" type="button" data-quote-project-gallery data-project-title="<%= project.title %>" data-gallery-images="<%= JSON.stringify(galleryImages) %>" aria-label="Xem thư viện ảnh dự án <%= project.title %>">
                    <% if (projectImage) { %><img src="<%= projectImage %>" alt="<%= project.title %>" loading="lazy" /><% } else { %><span class="quote-featured-project-image-placeholder">Chưa có ảnh</span><% } %>
                    <div class="quote-featured-project-overlay">
                      <b><%= overlay.title %></b>
                      <span><%= overlay.sub %></span>
                    </div>
                    <span class="quote-featured-project-view" aria-hidden="true">Xem ảnh <i>↗</i></span>
                  </button>
                  <div class="quote-featured-project-info">
                    <h3><a href="/cong-trinh/<%= project.slug %>"><%= project.title %></a></h3>
                    <dl>
                      <div><dt>Diện tích:</dt><dd><%= project.area || 'Đang cập nhật' %></dd></div>
                      <div><dt>Loại hình:</dt><dd><%= project.propertyType || 'Chung cư' %></dd></div>
                      <div><dt>Phong cách:</dt><dd><%= project.style || 'Hiện đại' %></dd></div>
                      <div><dt>Chi phí:</dt><dd><%= costLabel %></dd></div>
                    </dl>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } else { %>
            <p class="quote-empty-state">Các công trình nổi bật sẽ được cập nhật tại đây.</p>
          <% } %>
          <div class="quote-featured-view-all"><a href="<%= dynamicProjectUrl %>">Xem tất cả dự án <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    <% } %>

    <% if (sections.brandVideo?.isVisible !== false) { %>
      <% const brandVideoTitle = String(sections.brandVideo.title || '').trim().toLowerCase() === 'đơn vị thiết kế & thi công nội thất hàng đầu việt nam' ? 'Đơn vị thiết kế & thi công nội thất uy tín chất lượng' : sections.brandVideo.title; %>
      <% const brandVideoUrl = sections.brandVideo.videoUrl || 'https://www.youtube.com/watch?v=hoUvh1w9tII'; %>
      <% const brandVideoId = String(brandVideoUrl).match(/(?:youtu\.be\/|youtube(?:-nocookie)?\.com\/(?:watch\?(?:[^#&]+&)*v=|embed\/|shorts\/))([\w-]{11})/)?.[1] || 'hoUvh1w9tII'; %>
      <section class="quote-brand-video">
        <div class="container">
          <header class="quote-video-heading">
            <p><%= sections.brandVideo.eyebrow %></p>
            <h2><%= brandVideoTitle %></h2>
            <strong><%= sections.brandVideo.description %></strong>
          </header>
          <div class="quote-video-card">
            <div class="quote-video-frame">
              <iframe
                src="https://www.youtube-nocookie.com/embed/<%= brandVideoId %>?rel=0&modestbranding=1"
                title="Video thương hiệu Shome Luxury"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </section>
    <% } %>

    <% /* Show five projects from the exact design category selected in the
           quotation menu, immediately before the real-project videos. */ %>
    <% if (selectedCategory) { %>
      <section class="quote-section quote-category-section" id="cong-trinh-thiet-ke-moi">
        <div class="container">
          <header class="quote-featured-heading"><h2>Các công trình <em>tiêu biểu</em></h2><strong>Các công trình <%= quoteScript.toLowerCase() %> <%= featuredCategoryName.toLowerCase() %> được hoàn thiện chỉn chu, tối ưu công năng và thẩm mỹ.</strong></header>
          <% if (highlightProjects.length) { %>
            <div class="quote-featured-project-list">
              <% highlightProjects.slice(0, 5).forEach((project, index) => {
                   const galleryImages = [...new Set([project.thumbnail, ...(project.gallery || [])].filter(Boolean))];
                   const projectImage = galleryImages[0] || '';
                   const costLabel = project.cost ? `${Math.round(project.cost / 1000000)} triệu` : 'Liên hệ tư vấn';
                   const overlays = [
                     { title: 'Không gian truyền cảm hứng', sub: 'Mỗi góc nhỏ đều kể một câu chuyện' },
                     { title: 'Tinh giản cho cuộc sống trọn vẹn', sub: 'Sống thoải mái trong không gian dành cho bạn' },
                     { title: 'Đẳng cấp trong từng chi tiết', sub: 'Kiến tạo tổ ấm sang trọng và tiện nghi' }
                   ];
                   const overlay = overlays[index % overlays.length];
              %>
                <article class="quote-featured-project-card quote-featured-project-card--inline-gallery">
                  <section class="project-showcase-gallery quote-featured-project-gallery" data-quote-inline-gallery data-project-title="<%= project.title %>" data-gallery-images="<%= encodeURIComponent(JSON.stringify(galleryImages)) %>" aria-label="Thư viện ảnh công trình <%= project.title %>">
                    <div class="project-gallery-stage" data-quote-inline-stage tabindex="0" aria-label="Ảnh công trình <%= project.title %>">
                      <% if (projectImage) { %>
                        <img src="<%= projectImage %>" alt="<%= project.title %> - ảnh 1" data-quote-inline-image loading="lazy" draggable="false" />
                      <% } else { %>
                        <div class="project-gallery-empty">Công trình chưa có hình ảnh</div>
                      <% } %>
                      <div class="project-gallery-stage-shade" aria-hidden="true"></div>
                      <div class="quote-featured-project-overlay">
                        <b><%= overlay.title %></b>
                        <span><%= overlay.sub %></span>
                      </div>
                      <div class="project-gallery-count" aria-live="polite"><span data-quote-inline-current><%= galleryImages.length ? '01' : '00' %></span><span>/</span><span data-quote-inline-total><%= String(galleryImages.length).padStart(2, '0') %></span></div>
                      <button class="project-gallery-control previous" type="button" data-quote-inline-prev aria-label="Ảnh trước" <%= galleryImages.length < 2 ? 'hidden' : '' %>>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                      </button>
                      <button class="project-gallery-control next" type="button" data-quote-inline-next aria-label="Ảnh tiếp theo" <%= galleryImages.length < 2 ? 'hidden' : '' %>>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </button>
                    </div>
                    <div class="project-gallery-thumbnails" data-quote-inline-thumbnails role="list" aria-label="Chọn ảnh công trình">
                      <% galleryImages.forEach((image, imageIndex) => { %>
                        <button class="project-gallery-thumbnail <%= imageIndex === 0 ? 'is-active' : '' %>" type="button" data-quote-inline-thumb data-index="<%= imageIndex %>" aria-label="Xem ảnh <%= imageIndex + 1 %>" aria-current="<%= imageIndex === 0 ? 'true' : 'false' %>" role="listitem">
                          <img src="<%= image %>" alt="<%= project.title %> - thumbnail <%= imageIndex + 1 %>" loading="lazy" />
                        </button>
                      <% }) %>
                    </div>
                  </section>
                  <div class="quote-featured-project-info">
                    <h3><a href="/cong-trinh/<%= project.slug %>"><%= project.title %></a></h3>
                    <dl>
                      <div><dt>Diện tích:</dt><dd><%= project.area || 'Đang cập nhật' %></dd></div>
                      <div><dt>Loại hình:</dt><dd><%= project.propertyType || 'Chung cư' %></dd></div>
                      <div><dt>Phong cách:</dt><dd><%= project.style || 'Hiện đại' %></dd></div>
                      <div><dt>Chi phí:</dt><dd><%= costLabel %></dd></div>
                    </dl>
                  </div>
                </article>
              <% }) %>
            </div>
            <div class="quote-project-gallery-modal" data-quote-project-gallery-modal hidden role="dialog" aria-modal="true" aria-label="Thư viện ảnh công trình">
              <div class="quote-project-gallery-modal-backdrop" data-quote-gallery-close></div>
              <div class="quote-project-gallery-dialog">
                <div class="quote-project-gallery-stage" data-quote-gallery-stage>
                  <img src="" alt="" data-quote-gallery-image draggable="false" />
                  <button class="quote-project-gallery-close" type="button" data-quote-gallery-close aria-label="Đóng thư viện ảnh">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                  </button>
                  <span class="quote-project-gallery-count"><b data-quote-gallery-current>01</b>/<span data-quote-gallery-total>01</span></span>
                  <button class="quote-project-gallery-control previous" type="button" data-quote-gallery-prev aria-label="Ảnh trước">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                  </button>
                  <button class="quote-project-gallery-control next" type="button" data-quote-gallery-next aria-label="Ảnh tiếp theo">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                  </button>
                </div>
                <div class="quote-project-gallery-thumbnails" data-quote-gallery-thumbnails aria-label="Chọn ảnh công trình"></div>
              </div>
            </div>
          <% } else { %>
            <p class="quote-empty-state">Các công trình nổi bật sẽ được cập nhật tại đây.</p>
          <% } %>
          <div class="quote-featured-view-all"><a href="<%= dynamicProjectUrl %>">Xem tất cả dự án <span aria-hidden="true">→</span></a></div>
        </div>
      </section>
    <% } %>

    <% if (sections.completed?.isVisible !== false) { %>
      <%
        const videoData = (typeof completedVideosData !== 'undefined' && completedVideosData) ? completedVideosData : require('../data/completedVideosData');
        const catList = videoData?.categories || [];
        const rawCat = (typeof categoryQuery !== 'undefined' && categoryQuery) || (typeof selectedCategory !== 'undefined' && selectedCategory?.code) || '';
        const currentCatCode = String(rawCat).toLowerCase();
        
        let activeCatId = 'chung-cu';
        if (currentCatCode.includes('biet-thu') || currentCatCode.includes('villa')) {
          activeCatId = 'biet-thu';
        } else if (currentCatCode.includes('cafe') || currentCatCode.includes('tra-sua')) {
          activeCatId = 'cafe';
        } else if (currentCatCode.includes('nha-pho') || currentCatCode.includes('nha-cap-4')) {
          activeCatId = 'biet-thu';
        } else {
          activeCatId = 'chung-cu';
        }

        const isSubMenuPage = Boolean(currentCatCode);
        const activeCategoryData = catList.find(c => c.id === activeCatId) || catList[0] || { name: 'Công trình hoàn thiện', videos: [] };
        const selectedCategoryCode = selectedCategory?.code || rawCat;
        const seeAllUrl = quoteProjectUrls[selectedCategoryCode] || dynamicProjectUrl;
      %>
      <section class="quote-section quote-completed" id="thuoc-phim-thuc-te">
        <div class="container">
          <header class="quote-completed-heading">
            <h2>Thước phim thực tế <em class="font-script"><%= featuredCategoryName %></em></h2>
            <span>Ghi lại những khoảnh khắc thực tế từ công trình, nơi từng chi tiết được hoàn thiện chỉn chu cho tổ ấm của mỗi gia đình.</span>
          </header>

          <% if (!isSubMenuPage) { %>
            <!-- Sub-tabs filter only shown on general /bao-gia page when no specific category is selected -->
            <nav class="quote-completed-nav" role="tablist" aria-label="Danh mục thước phim công trình">
              <% catList.forEach((cat) => { %>
                <% const isCurrentActive = (activeCatId === cat.id); %>
                <button
                  type="button"
                  class="quote-completed-tab-btn <%= isCurrentActive ? 'active' : '' %>"
                  data-tab-id="<%= cat.id %>"
                  role="tab"
                  aria-selected="<%= isCurrentActive ? 'true' : 'false' %>"
                  aria-controls="quote-videos-<%= cat.id %>"
                >
                  <span class="quote-tab-label"><%= cat.name %></span>
                  <span class="quote-completed-tab-badge"><%= cat.count %> video</span>
                </button>
              <% }) %>
            </nav>

            <div class="quote-completed-panels">
              <% catList.forEach((cat) => { %>
                <% const isCurrentActive = (activeCatId === cat.id); %>
                <div
                  id="quote-videos-<%= cat.id %>"
                  class="quote-completed-tab-panel <%= isCurrentActive ? 'active' : '' %>"
                  role="tabpanel"
                  data-panel-id="<%= cat.id %>"
                >
                  <div class="quote-completed-videos-grid">
                    <% (cat.id === 'chung-cu' ? (cat.videos || []).slice(0, 6) : (cat.videos || [])).forEach((vid, vIdx) => { %>
                      <article class="quote-video-card quote-completed-video-card">
                        <div class="quote-video-frame">
                          <iframe
                            src="https://www.youtube-nocookie.com/embed/<%= vid.videoId %>?rel=0&modestbranding=1&playsinline=1"
                            title="<%= vid.title %>"
                            loading="eager"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allowfullscreen
                          ></iframe>
                        </div>
                      </article>
                    <% }) %>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <!-- When on a specific sub-menu page (e.g. Báo giá nội thất chung cư), render directly that category's videos -->
            <div class="quote-completed-container" id="quote-videos-<%= activeCategoryData.id %>">
              <div class="quote-completed-videos-grid">
                <% (activeCategoryData.id === 'chung-cu' ? (activeCategoryData.videos || []).slice(0, 6) : (activeCategoryData.videos || [])).forEach((vid, vIdx) => { %>
                  <article class="quote-video-card quote-completed-video-card">
                    <div class="quote-video-frame">
                      <iframe
                        src="https://www.youtube-nocookie.com/embed/<%= vid.videoId %>?rel=0&modestbranding=1&playsinline=1"
                        title="<%= vid.title %>"
                        loading="eager"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen
                      ></iframe>
                    </div>
                  </article>
                <% }) %>
              </div>
            </div>
          <% } %>

          <div class="quote-featured-view-all">
            <a href="<%= seeAllUrl %>">Xem tất cả dự án <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </section>
    <% } %>

    <% if (sections.capability?.isVisible !== false) { %>
      <section class="quote-capability">
        <div class="container quote-workshop">
          <header class="quote-workshop-heading">
            <h2><%= sections.capability.eyebrow %> <em><%= sections.capability.title %></em></h2>
            <p><%= sections.capability.description %></p>
          </header>
          <figure class="quote-video-card quote-workshop-video-card">
            <div class="quote-video-frame">
              <img
                src="<%= (locals.quoteImages && quoteImages.quote_capability_image) || sections.capability.image || '/images/factory_workers.jpg' %>"
                alt="<%= sections.capability.caption || 'Xưởng sản xuất Shome Luxury - Đơn vị thiết kế thi công tại Hà Nội' %>"
                loading="lazy"
                decoding="async"
              />
            </div>
          </figure>
          <div class="quote-workshop-stats">
            <% sections.capability.stats.forEach(stat => { %>
              <div><b><%= stat.value %></b><span><%= stat.label %></span></div>
            <% }) %>
          </div>
          <div class="quote-workshop-gallery">
            <% (sections.capability.gallery || []).forEach((item, index) => {
                 const gallerySlotKey = `quote_capability_gallery_${index + 1}`;
                 const galleryImage = (locals.quoteImages && quoteImages[gallerySlotKey]) || item.image;
            %>
              <figure>
                <img src="<%= galleryImage %>" alt="<%= item.alt %>" loading="lazy" />
                <figcaption><%= item.title %><% if (item.description) { %><span><%= item.description %></span><% } %></figcaption>
              </figure>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <% const craftsmanshipGroups = [
      { number: '1', title: 'Bề mặt & góc cạnh', imageKey: 'quote_craftsmanship_1', image: '/images/craftsmanship-surface-details-grid.png', items: [['Dán cạnh gọn đẹp', 'Mép dán sạch, liền mạch.'], ['Góc nối khít', 'Chăm chút từng điểm tiếp giáp.'], ['Bo cạnh mềm mại', 'Mượt tay ở những điểm chạm.'], ['Bề mặt chỉn chu', 'Rà soát vân gỗ và lớp hoàn thiện.']] },
      { number: '2', title: 'Phụ kiện & chuyển động', imageKey: 'quote_craftsmanship_2', image: '/images/craftsmanship-hardware-details-grid.png', items: [['Căn chỉnh bản lề', 'Cánh cân, đóng mở nhẹ nhàng.'], ['Ray trượt êm thuận', 'Kéo mở mượt, vận hành ổn định.'], ['Khe cánh đều đẹp', 'Đồng nhất tại mọi điểm.'], ['Tay nắm ngay ngắn', 'Đúng độ cao và vị trí lắp đặt.']] },
      { number: '3', title: 'Lắp đặt & hoàn thiện', imageKey: 'quote_craftsmanship_3', image: '/images/craftsmanship-finishing-details-grid.png', items: [['Căn chỉnh thẳng bằng', 'Kiểm tra độ phẳng và chắc chắn.'], ['Tiếp giáp gọn gàng', 'Chỉnh chu nơi tủ gặp tường.'], ['Đi dây ngăn nắp', 'Gọn đường dây, thuận tiện sử dụng.'], ['Vệ sinh hoàn thiện', 'Sạch từng góc trước bàn giao.']] },
      { number: '4', title: 'Kiểm tra & bàn giao', imageKey: 'quote_craftsmanship_4', image: '/images/craftsmanship-final-inspection-details-grid.png', items: [['Kiểm tra khe tủ', 'Độ hở đều, đóng mở chuẩn xác.'], ['Rà soát ngăn kéo', 'Chuyển động mượt mà, chắc chắn.'], ['Chỉnh điểm tiếp giáp', 'Tủ ôm khít, liền mạch với tường.'], ['Hoàn thiện phụ kiện', 'Tháo bảo vệ và lau sạch trước bàn giao.']] }
    ];
    const craftsmanshipCards = craftsmanshipGroups
      .flatMap(group => group.items.map(item => ({
        item,
        image: (locals.quoteImages && quoteImages[group.imageKey]) || group.image
      })))
      .slice(0, 6);
    %>
    <section class="quote-craftsmanship"><div class="container quote-craftsmanship-inner"><header class="quote-craftsmanship-heading"><h2>Tinh tế <em>Từng góc nhỏ</em></h2><p>Từ bề mặt, góc cạnh đến phụ kiện và lắp đặt.<br />Mỗi chi tiết đều được chăm chút để tổng thể đẹp và dùng bền lâu.</p></header><div class="quote-craft-grid quote-craft-grid--all"><% craftsmanshipCards.forEach(({ item, image }) => { %><article class="quote-craft-card"><div class="quote-craft-photo"><img src="<%= image %>" alt="<%= item[0] %>" loading="lazy" /></div><h4><%= item[0] %></h4><p><%= item[1] %></p></article><% }) %></div></div></section>

    <% const factoryActivities = [
      ['activity-01.webp', 'Lắp đặt chuẩn xác', 'quote_factory_activity_01'],
      ['activity-02.webp', 'Hoàn thiện tinh xảo', 'quote_factory_activity_02'],
      ['activity-03.webp', 'Kiểm tra vật liệu', 'quote_factory_activity_03'],
      ['activity-04.webp', 'Gia công CNC', 'quote_factory_activity_04'],
      ['activity-05.webp', 'Dán cạnh chuẩn', 'quote_factory_activity_05'],
      ['activity-06.webp', 'Lắp ráp đồng bộ', 'quote_factory_activity_06'],
      ['activity-07.webp', 'Cân chỉnh bản lề', 'quote_factory_activity_07'],
      ['activity-08.webp', 'Kiểm tra ray trượt', 'quote_factory_activity_08'],
      ['activity-09.webp', 'Hoàn thiện bề mặt', 'quote_factory_activity_09'],
      ['activity-10.webp', 'Đóng gói cẩn thận', 'quote_factory_activity_10'],
      ['activity-11.webp', 'Vận chuyển an toàn', 'quote_factory_activity_11'],
      ['activity-12.webp', 'Lắp đặt phòng khách', 'quote_factory_activity_12'],
      ['activity-13.webp', 'Hoàn thiện phòng ngủ', 'quote_factory_activity_13'],
      ['activity-14.webp', 'Kiểm tra bàn giao', 'quote_factory_activity_14'],
      ['activity-15.webp', 'Vận hành đồng bộ', 'quote_factory_activity_15']
    ]; %>
    <section class="quote-factory-activities" aria-labelledby="quote-factory-activities-title">
      <div class="container">
        <header class="quote-factory-activities-heading">
          <h2 id="quote-factory-activities-title"><span>Hình ảnh hoạt động</span> <em class="font-script">Sản xuất</em></h2>
        </header>
        <div class="quote-factory-activities-carousel">
          <div class="quote-factory-activity-track" data-carousel-autoplay="2000" data-carousel-autoplay-mobile="2000" data-carousel-step="card" aria-label="Hình ảnh hoạt động sản xuất">
            <% factoryActivities.forEach(([image, title, imageKey], index) => { %>
              <article class="quote-factory-activity-card">
                <figure>
                  <img src="<%= (locals.quoteImages && quoteImages[imageKey]) || `/images/quote-factory-activities/${image}` %>" alt="<%= title %> tại xưởng và công trình Shome Luxury" loading="lazy" decoding="async" width="1672" height="941" draggable="false" />
                  <figcaption><span><%= index + 1 %></span><b><%= title %></b></figcaption>
                </figure>
              </article>
            <% }) %>
          </div>
        </div>
        <div class="quote-factory-activity-dots testimonial-dots" aria-label="Chọn nhóm ảnh hoạt động"></div>
      </div>
    </section>

      <section class="quote-handover-check"><div class="container quote-handover-inner"><header class="quote-handover-heading"><h2>Kiểm tra bàn giao <em>Chăm chút từng bước</em></h2><p class="quote-handover-desc">Từng hạng mục được rà soát kỹ lưỡng trước khi bàn giao.<br />Đảm bảo công trình hoàn thiện chỉn chu, sẵn sàng sử dụng.</p></header><div class="quote-handover-list"><article class="quote-handover-item"><b>1.</b><div><h3>Đo kiểm kích thước</h3><p>Đối chiếu chỉ số với bản vẽ.</p></div></article><article class="quote-handover-item"><b>2.</b><div><h3>Lắp thử &amp; căn chỉnh</h3><p>Kiểm tra liên kết, bản lề và ray trượt.</p></div></article><article class="quote-handover-item"><b>3.</b><div><h3>Rà soát &amp; đóng gói</h3><p>Vệ sinh bề mặt, bảo vệ góc cạnh khi vận chuyển.</p></div></article></div></div></section>

    <% if (sections.estimate?.isVisible !== false) { %>
      <section class="quote-free-estimate" id="nhan-du-toan"><div class="container"><div class="quote-free-estimate-card"><img class="quote-free-estimate-image" src="<%= (locals.quoteImages && quoteImages.quote_estimate_image) || '/images/quote-free-estimate-interior.png' %>" alt="Nhận dự toán miễn phí từ SHome Luxury" loading="lazy" /><div class="quote-free-estimate-copy"><h2>Nhận dự toán <em>miễn phí</em></h2><p>Để lại thông tin, chuyên gia <strong>SHome Luxury</strong> sẽ liên hệ tư vấn trong 24h.</p><ul><li><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 13V9a7 7 0 0 1 14 0v4"/><path d="M5 13H3v4a2 2 0 0 0 2 2h2v-6H5Zm14 0h2v4a2 2 0 0 1-2 2h-2v-6h2Zm-2 6c0 1.4-1.6 2-3 2h-2"/></svg></i><span>Tư vấn nhanh trong 24h</span></li><li><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v5h5M9 12h6M9 16h6"/></svg></i><span>Báo giá chi tiết, minh bạch</span></li><li><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.4 8.2-8 10-4.6-1.8-8-5-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></i><span>Không cam kết, không ràng buộc</span></li></ul><a class="quote-free-estimate-button trigger-consult-modal" href="#consultModal">Đặt lịch tư vấn</a></div></div></div></section>
    <% } %>

    <%- include('partials/sections/customer-stories') %>
    <%- include('partials/sections/home-faq') %>

    <section class="quote-final-faq" aria-labelledby="quote-final-faq-title"><div class="container quote-final-faq-inner"><h2 id="quote-final-faq-title">Câu hỏi thường gặp</h2><div class="quote-final-faq-list"><details><summary><b>1.</b><span>Thời gian thiết kế và thi công mất bao lâu?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Tiến độ được xây dựng theo quy mô và hiện trạng công trình. SHome Luxury sẽ gửi lộ trình chi tiết sau khi khảo sát và chốt phương án.</p></details><details><summary><b>2.</b><span>Báo giá có phát sinh thêm chi phí không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Báo giá được lập rõ theo hạng mục, vật liệu và khối lượng. Mọi thay đổi phát sinh chỉ được thực hiện khi có xác nhận từ bạn.</p></details><details><summary><b>3.</b><span>SHome Luxury có chính sách bảo hành không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Chúng tôi bảo hành theo từng hạng mục thi công và đồng hành hỗ trợ sau bàn giao để công trình luôn vận hành ổn định.</p></details><details><summary><b>4.</b><span>Tôi có thể điều chỉnh thiết kế trước khi thi công không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Có. Đội ngũ sẽ tiếp nhận góp ý, điều chỉnh phương án và chỉ triển khai khi bạn đã thống nhất về thiết kế, vật liệu và chi phí.</p></details><details><summary><b>5.</b><span>Quy trình triển khai dự án diễn ra như thế nào?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Quy trình gồm khảo sát, tư vấn phương án, thiết kế, chốt dự toán, sản xuất tại xưởng và nghiệm thu bàn giao.</p></details><details><summary><b>6.</b><span>Tôi có được lựa chọn vật liệu và phụ kiện không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Có. Chúng tôi tư vấn các lựa chọn phù hợp ngân sách, phong cách và nhu cầu sử dụng để bạn dễ dàng quyết định.</p></details><details><summary><b>7.</b><span>Có thể nhận báo giá trước khi khảo sát không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Bạn có thể nhận mức dự toán tham khảo. Báo giá chi tiết sẽ được hoàn thiện sau khi có thông tin hiện trạng và yêu cầu cụ thể.</p></details><details><summary><b>8.</b><span>Làm thế nào để đặt lịch tư vấn tại nhà?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Hãy để lại thông tin liên hệ hoặc gọi trực tiếp cho SHome Luxury. Đội ngũ sẽ xác nhận thời gian khảo sát thuận tiện với bạn.</p></details></div></div></section>

    <section class="quote-faq-consult" aria-labelledby="quote-faq-consult-title"><div class="container"><div class="quote-faq-consult-inner"><div><h2 id="quote-faq-consult-title">Bạn còn băn khoăn?</h2><p>Chia sẻ nhu cầu để được tư vấn cụ thể.</p><a class="trigger-consult-modal" href="#consultModal">Đặt lịch tư vấn</a></div></div></div></section>

  </main>
  <%- include('partials/footer') %>
</body>
</html>
