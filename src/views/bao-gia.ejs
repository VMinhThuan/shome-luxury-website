                   const costLabel = project.cost ? `${Math.round(project.cost / 1000000)} triệu` : 'Liên hệ tư vấn';
                   const overlays = [
                     { title: 'Không gian truyền cảm hứng', sub: 'Mỗi góc nhỏ đều kể một câu chuyện' },
                     { title: 'Tinh giản cho cuộc sống trọn vẹn', sub: 'Sống thoải mái trong không gian dành cho bạn' },
                     { title: 'Đẳng cấp trong từng chi tiết', sub: 'Kiến tạo tổ ấm sang trọng và tiện nghi' }
