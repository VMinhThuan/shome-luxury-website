          </header>
          <figure class="quote-video-card quote-workshop-video-card">
            <div class="quote-video-frame">
              <iframe
                src="<%= capabilityVideoEmbedUrl %>"
                title="<%= sections.capability.caption || 'Video xưởng sản xuất Shome Luxury - Đơn vị thiết kế thi công tại Hà Nội' %>"
                loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            </div>
          </figure>
          <div class="quote-workshop-stats">
            <% sections.capability.stats.forEach(stat => { %>
              <div><b><%= stat.value %></b><span><%= stat.label %></span></div>
            <% }) %>
          </div>
          <div class="quote-workshop-gallery">
            <% (sections.capability.gallery || []).forEach(item => { %>
              <figure>
                <img src="<%= item.image %>" alt="<%= item.alt %>" loading="lazy" />
                <figcaption><%= item.title %><% if (item.description) { %><span><%= item.description %></span><% } %></figcaption>
              </figure>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <% const craftsmanshipGroups = [
      { number: '1', title: 'Bề mặt & góc cạnh', image: '/images/craftsmanship-surface-details-grid.png', items: [['Dán cạnh gọn đẹp', 'Mép dán sạch, liền mạch.'], ['Góc nối khít', 'Chăm chút từng điểm tiếp giáp.'], ['Bo cạnh mềm mại', 'Mượt tay ở những điểm chạm.'], ['Bề mặt chỉn chu', 'Rà soát vân gỗ và lớp hoàn thiện.']] },
      { number: '2', title: 'Phụ kiện & chuyển động', image: '/images/craftsmanship-hardware-details-grid.png', items: [['Căn chỉnh bản lề', 'Cánh cân, đóng mở nhẹ nhàng.'], ['Ray trượt êm thuận', 'Kéo mở mượt, vận hành ổn định.'], ['Khe cánh đều đẹp', 'Đồng nhất tại mọi điểm.'], ['Tay nắm ngay ngắn', 'Đúng độ cao và vị trí lắp đặt.']] },
      { number: '3', title: 'Lắp đặt & hoàn thiện', image: '/images/craftsmanship-finishing-details-grid.png', items: [['Căn chỉnh thẳng bằng', 'Kiểm tra độ phẳng và chắc chắn.'], ['Tiếp giáp gọn gàng', 'Chỉnh chu nơi tủ gặp tường.'], ['Đi dây ngăn nắp', 'Gọn đường dây, thuận tiện sử dụng.'], ['Vệ sinh hoàn thiện', 'Sạch từng góc trước bàn giao.']] },
      { number: '4', title: 'Kiểm tra & bàn giao', image: '/images/craftsmanship-final-inspection-details-grid.png', items: [['Kiểm tra khe tủ', 'Độ hở đều, đóng mở chuẩn xác.'], ['Rà soát ngăn kéo', 'Chuyển động mượt mà, chắc chắn.'], ['Chỉnh điểm tiếp giáp', 'Tủ ôm khít, liền mạch với tường.'], ['Hoàn thiện phụ kiện', 'Tháo bảo vệ và lau sạch trước bàn giao.']] }
    ]; %>
    <section class="quote-craftsmanship"><div class="container quote-craftsmanship-inner"><header class="quote-craftsmanship-heading"><h2>Tinh tế <em>Từng góc nhỏ</em></h2><p>Từ bề mặt, góc cạnh đến phụ kiện và lắp đặt.<br />Mỗi chi tiết đều được chăm chút để tổng thể đẹp và dùng bền lâu.</p></header><% craftsmanshipGroups.forEach(group => { %><section class="quote-craft-group"><header class="quote-craft-group-heading"><b><%= group.number %></b><h3><%= group.title %></h3></header><div class="quote-craft-grid"><% group.items.forEach((item, index) => { %><article class="quote-craft-card"><div class="quote-craft-photo"><img src="<%= group.image %>" alt="<%= item[0] %>" loading="lazy" /></div><h4><%= item[0] %></h4><p><%= item[1] %></p></article><% }) %></div></section><% }) %></div></section>

      <section class="quote-handover-check"><div class="container quote-handover-inner"><header class="quote-handover-heading"><p>Kiểm tra trước khi bàn giao</p><h2>Từng bước đều được <em>chăm chút</em></h2></header><div class="quote-handover-list"><article class="quote-handover-item"><b>1.</b><div><h3>Đo kiểm kích thước</h3><p>Đối chiếu chỉ số với bản vẽ.</p></div></article><article class="quote-handover-item"><b>2.</b><div><h3>Lắp thử &amp; căn chỉnh</h3><p>Kiểm tra liên kết, bản lề và ray trượt.</p></div></article><article class="quote-handover-item"><b>3.</b><div><h3>Rà soát &amp; đóng gói</h3><p>Vệ sinh bề mặt, bảo vệ góc cạnh khi vận chuyển.</p></div></article></div></div></section>

    <% if (sections.estimate?.isVisible !== false) { %>
      <section class="quote-free-estimate" id="nhan-du-toan"><div class="container"><div class="quote-free-estimate-card"><img class="quote-free-estimate-image" src="/images/quote-free-estimate-interior.png" alt="Nhận dự toán miễn phí từ SHome Luxury" loading="lazy" /><div class="quote-free-estimate-copy"><h2>Nhận dự toán <em>miễn phí</em></h2><p>Để lại thông tin, chuyên gia <strong>SHome Luxury</strong> sẽ liên hệ tư vấn trong 24h.</p><ul><li><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 13V9a7 7 0 0 1 14 0v4"/><path d="M5 13H3v4a2 2 0 0 0 2 2h2v-6H5Zm14 0h2v4a2 2 0 0 1-2 2h-2v-6h2Zm-2 6c0 1.4-1.6 2-3 2h-2"/></svg></i><span>Tư vấn nhanh trong 24h</span></li><li><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M15 3v5h5M9 12h6M9 16h6"/></svg></i><span>Báo giá chi tiết, minh bạch</span></li><li><i aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3 20 6v5c0 5-3.4 8.2-8 10-4.6-1.8-8-5-8-10V6l8-3Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg></i><span>Không cam kết, không ràng buộc</span></li></ul><a class="quote-free-estimate-button trigger-consult-modal" href="#consultModal">LIÊN HỆ ĐỂ NHẬN BÁO GIÁ</a></div></div></div></section>
    <% } %>

    <section class="quote-final-faq" aria-labelledby="quote-final-faq-title"><div class="container quote-final-faq-inner"><h2 id="quote-final-faq-title">Câu hỏi thường gặp</h2><div class="quote-final-faq-list"><details><summary><b>1.</b><span>Thời gian thiết kế và thi công mất bao lâu?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Tiến độ được xây dựng theo quy mô và hiện trạng công trình. SHome Luxury sẽ gửi lộ trình chi tiết sau khi khảo sát và chốt phương án.</p></details><details><summary><b>2.</b><span>Báo giá có phát sinh thêm chi phí không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Báo giá được lập rõ theo hạng mục, vật liệu và khối lượng. Mọi thay đổi phát sinh chỉ được thực hiện khi có xác nhận từ bạn.</p></details><details><summary><b>3.</b><span>SHome Luxury có chính sách bảo hành không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Chúng tôi bảo hành theo từng hạng mục thi công và đồng hành hỗ trợ sau bàn giao để công trình luôn vận hành ổn định.</p></details><details><summary><b>4.</b><span>Tôi có thể điều chỉnh thiết kế trước khi thi công không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Có. Đội ngũ sẽ tiếp nhận góp ý, điều chỉnh phương án và chỉ triển khai khi bạn đã thống nhất về thiết kế, vật liệu và chi phí.</p></details><details><summary><b>5.</b><span>Quy trình triển khai dự án diễn ra như thế nào?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Quy trình gồm khảo sát, tư vấn phương án, thiết kế, chốt dự toán, sản xuất tại xưởng và nghiệm thu bàn giao.</p></details><details><summary><b>6.</b><span>Tôi có được lựa chọn vật liệu và phụ kiện không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Có. Chúng tôi tư vấn các lựa chọn phù hợp ngân sách, phong cách và nhu cầu sử dụng để bạn dễ dàng quyết định.</p></details><details><summary><b>7.</b><span>Có thể nhận báo giá trước khi khảo sát không?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Bạn có thể nhận mức dự toán tham khảo. Báo giá chi tiết sẽ được hoàn thiện sau khi có thông tin hiện trạng và yêu cầu cụ thể.</p></details><details><summary><b>8.</b><span>Làm thế nào để đặt lịch tư vấn tại nhà?</span><i class="quote-final-faq-chevron" aria-hidden="true"><svg viewBox="0 0 16 10" focusable="false"><path d="m1 1 7 7 7-7" /></svg></i></summary><p>Hãy để lại thông tin liên hệ hoặc gọi trực tiếp cho SHome Luxury. Đội ngũ sẽ xác nhận thời gian khảo sát thuận tiện với bạn.</p></details></div></div></section>

