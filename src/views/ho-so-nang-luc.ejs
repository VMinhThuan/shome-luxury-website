<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Hồ sơ năng lực của SHOME LUXURY." />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css?v=6.4.6" />
  <script src="/js/main.js?v=1.9.0" defer></script>
  <script src="/js/company-profile.js?v=1.0.0" defer></script>
</head>
<body>
  <%- include("partials/header") %>
  <%- include("partials/mobile-drawer") %>

  <main id="main-content" class="company-profile-page">
    <section class="company-profile-hero">
      <div class="container">
        <h1>Hồ sơ <em>năng lực</em></h1>
        <span>Khám phá hành trình, năng lực và các công trình tiêu biểu của chúng tôi.</span>
      </div>
    </section>

    <section class="company-profile-viewer-section">
      <div class="company-profile-viewer" id="companyProfileViewer" data-pdf="/images/S-HOME-trang-doi_compressed.pdf">
        <div class="company-profile-book-shell">
          <button type="button" class="profile-nav profile-nav--prev" aria-label="Trang trước" data-profile-prev>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 5-7 7 7 7"></path></svg>
          </button>

          <div class="company-profile-book" aria-live="polite" aria-label="Trình xem hồ sơ năng lực">
            <div class="company-profile-loading" data-profile-loading>Đang tải hồ sơ năng lực…</div>
            <canvas class="profile-page-canvas" data-profile-page="left"></canvas>
            <canvas class="profile-page-canvas" data-profile-page="right"></canvas>
          </div>

          <button type="button" class="profile-nav profile-nav--next" aria-label="Trang tiếp theo" data-profile-next>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 5 7 7-7 7"></path></svg>
          </button>
        </div>

        <div class="company-profile-toolbar">
          <output class="profile-page-count" data-profile-count>— / —</output>
          <button type="button" title="Trang trước" aria-label="Trang trước" data-profile-prev><svg viewBox="0 0 24 24"><path d="m14.5 5-7 7 7 7"></path></svg></button>
          <button type="button" title="Trang tiếp theo" aria-label="Trang tiếp theo" data-profile-next><svg viewBox="0 0 24 24"><path d="m9.5 5 7 7-7 7"></path></svg></button>
          <button type="button" title="Toàn màn hình" aria-label="Xem toàn màn hình" data-profile-fullscreen><svg viewBox="0 0 24 24"><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5"></path></svg></button>
          <a href="/images/S-HOME-trang-doi_compressed.pdf" target="_blank" rel="noopener noreferrer" title="Mở PDF" aria-label="Mở PDF trong tab mới"><svg viewBox="0 0 24 24"><path d="M12 3v12"></path><path d="m7 10 5 5 5-5"></path><path d="M5 21h14"></path></svg></a>
        </div>
      </div>
    </section>
  </main>

  <%- include("partials/footer") %>
</body>
</html>
