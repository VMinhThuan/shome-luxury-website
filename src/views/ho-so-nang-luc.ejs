<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Hồ sơ năng lực của SHOME LUXURY." />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css?v=6.5.65" />
  <link rel="stylesheet" href="/vendor/dearflip/css/dflip.min.css?v=2.3.53" />
  <script>
    window.dFlipLocation = '/vendor/dearflip/';
    window.dFlipWPGlobal = {
      viewerType: 'flipbook',
      webgl: true,
      duration: 800,
      pageMode: 2,
      singlePageMode: 2,
      backgroundColor: 'transparent',
      allControls: 'altPrev,pageNumber,altNext,download',
      controlsPosition: 'bottom',
      controlsFloating: true,
      enableSound: false,
      scrollWheel: false
    };
  </script>
  <script src="https://code.jquery.com/jquery-3.7.1.min.js" defer></script>
  <script src="/vendor/dearflip/js/dflip.min.js?v=2.3.53" defer></script>
  <script src="/js/main.js?v=1.9.0" defer></script>
</head>
<body>
  <%- include("partials/header") %>
  <%- include("partials/mobile-drawer") %>

  <main id="main-content" class="company-profile-page">
    <section class="company-profile-hero">
      <div class="container">
        <h1>Hồ sơ <em>năng lực</em></h1>
        <span>Khám phá hành trình, năng lực và các công trình tiêu biểu của chúng tôi.</span>
      </div>
    </section>

    <section class="company-profile-viewer-section">
      <div class="company-profile-viewer">
        <div id="companyProfileFlipbook" class="_df_book df-lite company-profile-flipbook" source="/images/S-HOME-trang-doi_compressed.pdf" aria-label="Hồ sơ năng lực SHOME LUXURY"></div>
      </div>
    </section>
  </main>

  <%- include("partials/footer") %>
</body>
</html>
