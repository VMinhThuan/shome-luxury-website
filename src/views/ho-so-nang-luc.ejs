<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Hồ sơ năng lực của SHOME LUXURY." />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css?v=6.5.99" />
  <!-- DearFlip 3D FlipBook Viewer (Same as old web) -->
  <link rel="stylesheet" href="/vendor/dflip/css/dflip.min.css" />
  <link rel="stylesheet" href="/vendor/dflip/css/themify-icons.min.css" />
  <script src="/js/main.js?v=1.9.1" defer></script>
  <script src="/vendor/dflip/js/libs/jquery.min.js"></script>
  <script>
    window.dFlipLocation = '/vendor/dflip/';
    window.dFlipWPGlobal = {
      text: {
        toggleSound: "Bật/Tắt âm thanh",
        toggleThumbnails: "Thu nhỏ trang",
        toggleOutline: "Mục lục",
        previousPage: "Trang trước",
        nextPage: "Trang sau",
        toggleFullscreen: "Toàn màn hình",
        zoomIn: "Phóng to",
        zoomOut: "Thu nhỏ",
        toggleHelp: "Trợ giúp",
        singlePageMode: "Trang đơn",
        doublePageMode: "Trang đôi",
        downloadPDFFile: "Tải về PDF",
        gotoFirstPage: "Trang đầu",
        gotoLastPage: "Trang cuối",
        share: "Chia sẻ",
        loading: "Đang tải hồ sơ năng lực..."
      },
      viewerType: "flipbook",
      moreControls: "download,pageMode,startPage,endPage,sound",
      hideControls: "",
      scrollWheel: false,
      backgroundColor: "transparent",
      height: "auto",
      controlsPosition: "bottom",
      duration: 800,
      soundEnable: true,
      enableSound: true,
      enableDownload: true,
      webgl: true,
      hard: "none",
      maxTextureSize: 1600,
      rangeChunkSize: 524288,
      zoomRatio: 1.5,
      stiffness: 3,
      pageMode: "0",
      singlePageMode: "0",
      pageSize: "0",
      autoPlay: false,
      linkTarget: 2
    };
    window.option_df_profile = {
      outline: [],
      autoEnableOutline: false,
      autoEnableThumbnail: false,
      overwritePDFOutline: false,
      direction: "1",
      pageSize: "0",
      source: "/images/S-HOME-trang-doi_compressed.pdf",
      wpOptions: "true",
      webgl: true,
      duration: 800,
      stiffness: 3,
      soundEnable: true,
      enableSound: true,
      backgroundColor: "transparent"
    };
  </script>
  <script src="/vendor/dflip/js/dflip.min.js" defer></script>
</head>
<body>
  <%- include("partials/header") %>
  <%- include("partials/mobile-drawer") %>

  <main id="main-content" class="company-profile-page">
    <section class="company-profile-hero">
      <div class="container">
        <h1>Hồ sơ <em>năng lực</em></h1>
        <span>Khám phá hành trình, năng lực và các công trình tiêu biểu của chúng tôi.</span>
      </div>
    </section>

    <section class="company-profile-viewer-section">
      <div class="company-profile-viewer-container">
        <div class="_df_book df-lite" id="df_profile" source="/images/S-HOME-trang-doi_compressed.pdf" wpoptions="true"></div>
      </div>
    </section>
  </main>

  <%- include("partials/footer") %>
</body>
</html>
