<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= title %></title>
  <meta name="description" content="<%= article.summary %>" />
  <meta name="theme-color" content="#171717" />

  <link rel="stylesheet" href="/css/style.css?v=6.5.79" />
  <script src="/js/main.js?v=1.9.0" defer></script>
</head>
<body class="page-news-detail">

  <%- include("partials/header") %>
  <%- include("partials/mobile-drawer") %>

  <main id="main-content" class="recruitment-detail-main">
    <div class="container">
      <div class="recruitment-back-bar">
        <a href="/tin-tuc" class="btn-back-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Quay lại danh sách tin tức
        </a>
      </div>

      <!-- Main Layout Grid (Reusing job-detail-grid UI layout) -->
      <div class="job-detail-grid">
        <!-- Main Content Area -->
        <article class="job-detail-content">
          <!-- Article Header Information -->
          <header class="job-detail-header">
            <span class="job-detail-badge"><%= article.category || 'TIN TỨC' %></span>
            <h1 class="job-detail-title"><%= article.title %></h1>
            
            <div class="job-detail-meta">
              <span><strong>Tác giả:</strong> <%= article.author || 'Lê Sang' %></span>
              <span><strong>Ngày đăng:</strong> <%= article.date %></span>
              <span><strong>Danh mục:</strong> <%= article.category %></span>
            </div>

            <!-- Key Quick Info Bar -->
            <div class="job-quick-info-grid">
              <div class="quick-info-card">
                <span class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                </span>
                <div>
                  <span class="info-label">Tác giả</span>
                  <strong class="info-val text-accent"><%= article.author || 'Lê Sang' %></strong>
                </div>
              </div>
              <div class="quick-info-card">
                <span class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                </span>
                <div>
                  <span class="info-label">Ngày phát hành</span>
                  <strong class="info-val"><%= article.date %></strong>
                </div>
              </div>
              <div class="quick-info-card">
                <span class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                  </svg>
                </span>
                <div>
                  <span class="info-label">Chuyên mục</span>
                  <strong class="info-val"><%= article.category %></strong>
                </div>
              </div>
              <div class="quick-info-card">
                <span class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 16 14"></polyline>
                  </svg>
                </span>
                <div>
                  <span class="info-label">Thời gian đọc</span>
                  <strong class="info-val"><%= article.readTime || '5 phút' %></strong>
                </div>
              </div>
            </div>
          </header>

          <!-- Main Article Body -->
          <div class="job-article-body">
            <% if (article.fullHtmlContent) { %>
              <%- article.fullHtmlContent %>
            <% } else if (article.sections && Array.isArray(article.sections)) { %>
              <div class="old-web-article">
                <p class="article-intro"><%= article.summary %></p>
                <% if (article.thumbnail) { %>
                  <div class="article-image-box">
                    <img src="<%= article.thumbnail %>" alt="<%= article.title %>" class="article-main-img" />
                  </div>
                <% } %>
                
                <% article.sections.forEach(function(sec) { %>
                  <h2 id="<%= sec.id || '' %>" class="article-heading"><%= sec.title %></h2>
                  <% if (sec.items && sec.items.length) { %>
                    <ul class="article-list">
                      <% sec.items.forEach(function(item) { %>
                        <li><%= item %></li>
                      <% }); %>
                    </ul>
                  <% } %>
                <% }); %>
              </div>
            <% } %>
          </div>

          <!-- Consultation Bottom Box -->
          <div class="job-detail-apply-box">
            <div class="apply-box-header">
              <h3>Tư vấn thiết kế &amp; thi công nội thất SHOME LUXURY</h3>
              <p>Liên hệ ngay với chúng tôi để nhận giải pháp tối ưu không gian sống cùng dự toán chi tiết miễn phí!</p>
            </div>

            <div class="apply-box-contacts">
              <div class="contact-item">
                <span class="icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </span>
                <div>
                  <span class="label">Email tư vấn:</span>
                  <strong>shomeluxurydesign@gmail.com</strong>
                </div>
              </div>
              <div class="contact-item">
                <span class="icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </span>
                <div>
                  <span class="label">Hotline / Zalo tư vấn:</span>
                  <strong>079999 7700</strong>
                </div>
              </div>
            </div>

            <div class="apply-box-actions">
              <a href="/dat-lich-ngay" class="btn-cta-gold-full">
                Nhận dự toán &amp; Tư vấn miễn phí
              </a>
              <a href="https://zalo.me/0799997700" target="_blank" rel="noopener" class="btn-cta-zalo">
                Tư vấn trực tiếp qua Zalo
              </a>
            </div>
          </div>
        </article>

      </div>
    </div>
  </main>

  <%- include("partials/footer") %>

</body>
</html>
