<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= title %></title>
  <meta name="description" content="Chi tiết bài tuyển dụng <%= job.title %> tại SHOME LUXURY - Môi trường làm việc chuyên nghiệp, đãi ngộ hấp dẫn." />
  <meta name="theme-color" content="#171717" />

  <link rel="stylesheet" href="/css/style.css?v=6.2.8" />
  <script src="/js/main.js?v=1.9.0" defer></script>
</head>
<body class="page-recruitment-detail">

  <%- include("partials/header") %>
  <%- include("partials/mobile-drawer") %>

  <main id="main-content" class="recruitment-detail-main">
    <div class="container">
      <div class="recruitment-back-bar">
        <a href="/tuyen-dung" class="btn-back-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Quay lại danh sách tuyển dụng
        </a>
      </div>

      <!-- Main Layout Grid -->
      <div class="job-detail-grid">
        <!-- Main Content Area -->
        <article class="job-detail-content">
          <!-- Job Header Information -->
          <header class="job-detail-header">
            <span class="job-detail-badge"><%= job.isHot ? 'ĐANG HOT' : 'TUYỂN DỤNG' %></span>
            <h1 class="job-detail-title"><%= job.title %></h1>
            
            <div class="job-detail-meta">
              <span><strong>Người đăng:</strong> <%= job.author || 'Lê Sang' %></span>
              <span><strong>Ngày đăng:</strong> <%= job.date || '29/06/2024' %></span>
              <span><strong>Danh mục:</strong> <%= job.category || 'Tuyển dụng' %></span>
            </div>

            <!-- Key Quick Info Bar -->
            <div class="job-quick-info-grid">
              <div class="quick-info-card">
                <span class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M6 12h.01M18 12h.01"></path>
                  </svg>
                </span>
                <div>
                  <span class="info-label">Mức lương</span>
                  <strong class="info-val text-accent"><%= job.salary || 'Thỏa thuận' %></strong>
                </div>
              </div>
              <div class="quick-info-card">
                <span class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </span>
                <div>
                  <span class="info-label">Địa điểm</span>
                  <strong class="info-val"><%= job.location || 'Hà Nội' %></strong>
                </div>
              </div>
              <div class="quick-info-card">
                <span class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                    <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                  </svg>
                </span>
                <div>
                  <span class="info-label">Hình thức</span>
                  <strong class="info-val"><%= job.workType || 'Toàn thời gian' %></strong>
                </div>
              </div>
              <div class="quick-info-card">
                <span class="info-icon">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                </span>
                <div>
                  <span class="info-label">Hạn nộp hồ sơ</span>
                  <strong class="info-val"><%= job.deadline || '30/10/2026' %></strong>
                </div>
              </div>
            </div>
          </header>

          <!-- Main Job Article Body -->
          <div class="job-article-body">
            <% if (job.fullHtmlContent) { %>
              <%- job.fullHtmlContent %>
            <% } else if (job.sections && Array.isArray(job.sections)) { %>
              <div class="old-web-article">
                <p class="article-intro"><%= job.summary %></p>
                <% if (job.thumbnail) { %>
                  <div class="article-image-box">
                    <img src="<%= job.thumbnail %>" alt="<%= job.title %>" class="article-main-img" />
                  </div>
                <% } %>
                
                <% job.sections.forEach(function(sec) { %>
                  <h2 id="<%= sec.id || '' %>" class="article-heading"><%= sec.title %></h2>
                  <% if (sec.items && sec.items.length) { %>
                    <ul class="article-list">
                      <% sec.items.forEach(function(item) { %>
                        <li><%= item %></li>
                      <% }); %>
                    </ul>
                  <% } %>
                <% }); %>
              </div>
            <% } %>
          </div>

          <!-- Application Bottom Box -->
          <div class="job-detail-apply-box">
            <div class="apply-box-header">
              <h3>Ứng tuyển vị trí <%= job.title %></h3>
              <p>Hãy gửi CV của bạn để trở thành một phần của đại gia đình SHOME LUXURY!</p>
            </div>

            <div class="apply-box-contacts">
              <div class="contact-item">
                <span class="icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                    <polyline points="22,6 12,13 2,6"></polyline>
                  </svg>
                </span>
                <div>
                  <span class="label">Email nhận CV:</span>
                  <strong>shomeluxurydesign@gmail.com</strong>
                </div>
              </div>
              <div class="contact-item">
                <span class="icon">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </span>
                <div>
                  <span class="label">Hotline / Zalo Tuyển dụng:</span>
                  <strong>079999 7700</strong>
                </div>
              </div>
            </div>

            <div class="apply-box-actions">
              <a href="mailto:shomeluxurydesign@gmail.com?subject=Ứng tuyển <%= encodeURIComponent(job.title) %>" class="btn-cta-gold-full">
                Nộp hồ sơ ngay qua Email
              </a>
              <a href="https://zalo.me/0799997700" target="_blank" rel="noopener" class="btn-cta-zalo">
                Ứng tuyển qua Zalo
              </a>
            </div>
          </div>
        </article>

      </div>
    </div>
  </main>

  <%- include("partials/footer") %>

</body>
</html>
