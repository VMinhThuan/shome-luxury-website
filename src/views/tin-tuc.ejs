<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= title %></title>
  <meta name="description" content="Cập nhật xu hướng thiết kế, kinh nghiệm thi công và phong cách sống cùng SHOME LUXURY." />
  <link rel="stylesheet" href="/css/style.css?v=6.8.15" />
  <script src="/js/main.js?v=1.9.9" defer></script>
</head>
<body class="page-news">
  <%- include("partials/header") %>
  <%- include("partials/mobile-drawer") %>

  <main id="main-content" class="news-page">
    <section class="news-hero subpage-banner-frame">
      <div class="news-hero-image" aria-hidden="true">
        <img src="/images/hero_sofa_sharp.jpg" alt="" width="1376" height="768" fetchpriority="high" />
      </div>
    </section>

    <% if (articles && articles.length > 0) { %>
      <!-- Featured Article Section (Alternating Cream Background) -->
      <section class="news-featured-section">
        <div class="container">
          <article class="news-featured" onclick="window.location.href='/tin-tuc/<%= articles[0].id %>'" style="cursor: pointer;">
            <a href="/tin-tuc/<%= articles[0].id %>">
              <img src="<%= articles[0].image %>" alt="<%= articles[0].title %>" width="900" height="480" />
            </a>
            <div class="news-featured-copy">
              <span class="news-label">BÀI VIẾT NỔI BẬT</span>
              <h2><a href="/tin-tuc/<%= articles[0].id %>" style="color: inherit; text-decoration: none;"><%= articles[0].title %></a></h2>
              <p><%= articles[0].excerpt %></p>
              <div class="news-featured-meta"><span>◷ <%= articles[0].date %></span><span>◈ <%= articles[0].category %></span></div>
            </div>
          </article>
        </div>
      </section>
    <% } %>

    <!-- Latest Articles Section (Crisp White Background) -->
    <section class="news-latest-section">
      <div class="container">
        <div class="news-section-heading" id="moi-nhat">
          <div><h2>Bài viết mới nhất</h2></div>
        </div>

        <div class="news-article-list">
          <% articles.forEach((article) => { %>
            <article class="news-list-card" onclick="window.location.href='/tin-tuc/<%= article.id %>'" style="cursor: pointer;">
              <a class="news-list-image" href="/tin-tuc/<%= article.id %>" aria-label="<%= article.title %>"><img src="<%= article.image %>" alt="<%= article.title %>" width="300" height="190" loading="lazy" /></a>
              <div class="news-list-body">
                <span class="news-list-category"><%= article.category %></span>
                <h3><a href="/tin-tuc/<%= article.id %>"><%= article.title %></a></h3>
                <p><%= article.excerpt %></p>
                <div class="news-list-meta"><span>◷ <%= article.date %></span><span>◈ <%= article.category %></span></div>
              </div>
            </article>
          <% }); %>
        </div>
      </div>
    </section>
  </main>

  <%- include("partials/footer") %>
</body>
</html>
