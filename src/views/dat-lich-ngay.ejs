<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= title %></title>
  <meta name="description" content="Đăng ký nhận tư vấn và dự toán thiết kế, thi công nội thất miễn phí từ Shome Luxury." />
  <link rel="stylesheet" href="/css/style.css?v=6.8.10" />
  <script src="/js/main.js?v=1.9.9" defer></script>
</head>
<body>
  <%- include("partials/header") %>
  <%- include("partials/mobile-drawer") %>

  <main id="main-content" class="booking-page">
    <section class="booking-hero">
      <% const bookingHeroSlides = [
        '/images/booking-luxury-interior.png',
        '/images/booking-hero-banner-bedroom.png',
        '/images/booking-hero-banner-dining.png'
      ]; %>
      <div class="hero-slider-track booking-hero-slider-track" id="bookingHeroSliderTrack" data-hero-slider data-hero-dots="bookingHeroSliderDots" aria-label="Danh sách banner nhận dự toán">
        <% bookingHeroSlides.forEach((image, index) => { %>
          <div class="hero-slide booking-hero-slide" data-slide-index="<%= index %>" aria-label="Banner nhận dự toán <%= index + 1 %> trên 3">
            <div class="booking-hero-media" aria-hidden="true">
              <img src="<%= image %>" alt="" width="2048" height="2048" <%= index === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async" draggable="false" />
            </div>
          </div>
        <% }) %>
      </div>
      <div class="container booking-hero-grid">
        <div class="booking-hero-copy">
          <h1>Nhận dự toán <em>Miễn Phí</em></h1>
          <p>Để lại thông tin, chuyên gia SHOME sẽ liên hệ tư vấn trong 24h.</p>
          <div class="booking-hero-points">
            <span>✓ Dự toán rõ ràng</span><span>✓ Không phát sinh</span><span>✓ Bảo mật thông tin</span>
          </div>
          <button class="booking-submit trigger-consult-modal" type="button">Đặt lịch ngay</button>
        </div>
      </div>
      <div class="hero-slider-dots" id="bookingHeroSliderDots" role="tablist" aria-label="Chọn banner nhận dự toán"></div>
    </section>

    <section class="booking-process-section">
      <div class="container">
        <div class="booking-process-heading"><span class="booking-process-kicker">Quy trình</span><h2>Thiết kế <i>&amp;</i> Thi công</h2><p>Đơn giản <b>·</b> Minh bạch <b>·</b> Chuyên nghiệp</p></div>
        <div class="booking-process-list">
          <article><b>01</b><div><h3>Tư vấn &amp; khảo sát</h3><p>Lắng nghe nhu cầu, khảo sát thực tế không gian.</p></div></article>
          <article><b>02</b><div><h3>Thiết kế 2D/3D</h3><p>Lên phương án bố trí, phối cảnh chi tiết theo nhu cầu.</p></div></article>
          <article><b>03</b><div><h3>Thi công sản xuất</h3><p>Sản xuất tại xưởng, thi công đúng tiến độ, đảm bảo chất lượng.</p></div></article>
          <article><b>04</b><div><h3>Nghiệm thu bàn giao</h3><p>Kiểm tra, hoàn thiện và bàn giao đúng cam kết.</p></div></article>
        </div>
      </div>
    </section>

    <section class="booking-estimate">
      <div class="container">
        <div class="booking-estimate-header">
          <h2>Báo giá chi tiết cân đối<br><em>ngân sách của bạn</em></h2>
        </div>
        <div class="booking-estimate-content">
          <div class="booking-estimate-col-left">
            <ul class="booking-estimate-features">
              <li>
                <span class="feat-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></span>
                <span>Minh bạch chủng loại vật liệu</span>
              </li>
              <li>
                <span class="feat-icon"><svg viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4z"></path></svg></span>
                <span>Tối ưu ngân sách</span>
              </li>
              <li>
                <span class="feat-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></span>
                <span>Hạn chế tối đa chi phí phát sinh</span>
              </li>
              <li>
                <span class="feat-icon"><svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></span>
                <span>Cam kết tiến độ &amp; chất lượng</span>
              </li>
            </ul>
          </div>
          <div class="booking-estimate-col-right">
            <div class="booking-estimate-image-wrap">
              <img src="/images/booking-estimate-visual.png" alt="Báo giá chi tiết cân đối ngân sách Shome Luxury" class="booking-estimate-img" width="600" height="340" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="booking-faq">
      <div class="container">
        <div class="booking-faq-header">
          <h2>CÂU HỎI THƯỜNG GẶP</h2>
        </div>
        <div class="booking-faq-list">
          <details>
            <summary><i>1</i>Bao lâu hoàn thiện?</summary>
            <p>Thời gian phụ thuộc quy mô và hiện trạng công trình. Shome Luxury sẽ gửi lộ trình thi công chi tiết cho từng giai đoạn.</p>
          </details>
          <details>
            <summary><i>2</i>Có phát sinh chi phí không?</summary>
            <p>Mọi chi phí được thống nhất trước khi triển khai, cam kết không tự ý phát sinh chi phí ngoài hợp đồng.</p>
          </details>
          <details>
            <summary><i>3</i>Có bảo hành không?</summary>
            <p>Công trình được bảo hành chính hãng theo từng hạng mục và vật liệu, kèm hỗ trợ bảo trì dài hạn.</p>
          </details>
          <details>
            <summary><i>4</i>Có được chỉnh sửa thiết kế không?</summary>
            <p>Bạn được trao đổi và điều chỉnh phương án trong giai đoạn thiết kế 2D/3D đến khi hoàn toàn hài lòng.</p>
          </details>
          <details>
            <summary><i>5</i>Quy trình thanh toán như thế nào?</summary>
            <p>Thanh toán được chia làm nhiều đợt linh hoạt theo từng mốc tiến độ thi công thực tế và nghiệm thu từng hạng mục.</p>
          </details>
          <details>
            <summary><i>6</i>Shome Luxury có xưởng sản xuất trực tiếp không?</summary>
            <p>Công ty sở hữu 3 xưởng sản xuất quy mô lớn tại Hà Nội với máy móc CNC hiện đại giúp tối ưu giá thành tận gốc và kiểm soát chất lượng nghiêm ngặt.</p>
          </details>
          <details>
            <summary><i>7</i>Vật liệu thi công có đúng cam kết ban đầu?</summary>
            <p>Cam kết 100% vật liệu chuẩn chính hãng theo đúng hợp đồng (gỗ An Cường, phụ kiện Hafele/Blum...), khách hàng được kiểm tra vật liệu trước khi lắp đặt.</p>
          </details>
          <details>
            <summary><i>8</i>Tỉnh xa có được hỗ trợ thiết kế & thi công không?</summary>
            <p>Shome Luxury nhận thiết kế và thi công trọn gói trên toàn quốc. Đội ngũ KTS sẵn sàng tới tận nơi tư vấn và khảo sát hiện trạng.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="booking-testimonial">
      <div class="container">
        <div class="testimonial-heading">
          <span class="testimonial-kicker">PHẢN HỒI KHÁCH HÀNG</span>
          <h2>Khách hàng <em>chia sẻ</em></h2>
          <p>Những phản hồi được trích từ cuộc trò chuyện thực tế cùng khách hàng.</p>
        </div>

        <div class="testimonial-slider-wrapper">
          <div class="testimonial-slider" id="testimonialSlider">
            <% const zaloFeedbacks = [
              { name: 'Chị Linh', project: 'Biệt thự sân vườn', image: '1792222115348_6043215661779559246_6043215661779559246_01b44922101989e305f01bad5accb18d.jpg' },
              { name: 'Chị Thắm', project: 'Chuỗi cafe', image: '1792222116061_6043215661779559246_6043215661779559246_5125bee0bd4dc54dccea59475e93e70e.jpg', quote: 'Bên em làm có tâm, chị còn muốn nhờ setup thêm cơ sở nữa.' },
              { name: 'Chị Huyền', project: 'Văn phòng The Address', image: '1792222116666_6043215661779559246_6043215661779559246_43f8098458f4b617f70e0543f424e99c.jpg', quote: 'Xưởng làm có tâm, đội ngũ thi công tỉ mỉ nên cả anh chị đều rất thích.' },
              { name: 'Anh Thắng', project: 'Công trình Hoàn Kiếm', image: '1792222117834_6043215661779559246_6043215661779559246_538359c82f5edaadd11615b29b92b4ee.jpg', quote: 'Mọi giai đoạn thực hiện chuyên nghiệp, công trình hoàn thiện trọn vẹn.' },
              { name: 'Bác Kiên', project: 'Biệt thự Ecopark', image: '1792222118526_6043215661779559246_6043215661779559246_2b8d5dd9b1bdc6fb1f3c7e477b96d548.jpg', quote: 'Phòng khách đẹp, long lanh và rất ưng ý.' }
            ]; %>
            <% zaloFeedbacks.forEach((feedback) => { %>
              <article class="testimonial-card testimonial-card-zalo">
                <div class="testimonial-zalo-copy">
                  <div class="testimonial-user">
                    <div>
                      <h3 class="user-name"><%= feedback.name %></h3>
                      <p><%= feedback.project %></p>
                      <div class="user-stars" aria-label="5 trên 5 sao">★★★★★</div>
                    </div>
                  </div>
                  <% if (feedback.quote) { %>
                    <div class="testimonial-body"><p>“<%= feedback.quote %>”</p></div>
                  <% } %>
                  <small>Phản hồi qua Zalo</small>
                </div>
                <figure class="testimonial-zalo-proof">
                  <img src="/images/feedback/<%= feedback.image %>" alt="Ảnh chụp phản hồi Zalo của <%= feedback.name %>" loading="lazy" />
                </figure>
              </article>
            <% }) %>
          </div>

          <div class="testimonial-dots" aria-label="Chọn nhóm đánh giá"></div>
        </div>
      </div>
    </section>
  </main>

  <%- include("partials/footer") %>
  
  <script>

    (function() {
      const slider = document.getElementById('testimonialSlider');
      if (!slider) return;
      const initialiseReviews = () => window.ShomeluxuryReviewCarousel?.(
        slider,
        slider.closest('.testimonial-slider-wrapper')?.querySelector('.testimonial-dots')
      );
      if (window.ShomeluxuryReviewCarousel) initialiseReviews();
      else document.addEventListener('shomeluxuryreviewcarouselready', initialiseReviews, { once: true });
    })();
  </script>
</body>
</html>
