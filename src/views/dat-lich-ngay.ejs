<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title><%= title %></title>
  <meta name="description" content="Đăng ký nhận tư vấn và dự toán thiết kế, thi công nội thất miễn phí từ Shome Luxury." />
  <link rel="stylesheet" href="/css/style.css?v=6.2.8" />
  <script src="/js/main.js?v=1.9.0" defer></script>
</head>
<body>
  <%- include("partials/header") %>
  <%- include("partials/mobile-drawer") %>

  <main id="main-content" class="booking-page">
    <section class="booking-hero">
      <div class="container booking-hero-grid">
        <div class="booking-hero-copy">
          <h1>Nhận dự toán <em>Miễn Phí</em></h1>
          <p>Để lại thông tin, chuyên gia SHOME sẽ liên hệ tư vấn trong 24h.</p>
          <div class="booking-hero-points">
            <span>✓ Dự toán rõ ràng</span><span>✓ Không phát sinh</span><span>✓ Bảo mật thông tin</span>
          </div>
        </div>

        <form class="booking-form-card" id="bookingForm">
          <label class="booking-field"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 11 9-7 9 7v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1v-9Z"></path><path d="M9 21v-6h6v6"></path></svg><select name="service" aria-label="Loại căn hộ"><option value="Thiết kế nội thất">Loại căn hộ</option><option value="Thiết kế kiến trúc">Thiết kế kiến trúc</option><option value="Thi công trọn gói">Thi công trọn gói</option></select></label>
          <label class="booking-field"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 3H5a2 2 0 0 0-2 2v4M15 3h4a2 2 0 0 1 2 2v4M21 15v4a2 2 0 0 1-2 2h-4M3 15v4a2 2 0 0 0 2 2h4"></path></svg><input name="message" type="text" placeholder="Diện tích (m²)" aria-label="Diện tích mét vuông" /></label>
          <label class="booking-field"><svg viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="5" rx="7" ry="3"></ellipse><path d="M5 5v7c0 1.7 3.1 3 7 3s7-1.3 7-3V5M5 12v7c0 1.7 3.1 3 7 3s7-1.3 7-3v-7"></path></svg><select name="budget" aria-label="Ngân sách dự kiến"><option value="">Ngân sách dự kiến</option><option>Dưới 300 triệu</option><option>300 – 700 triệu</option><option>Trên 700 triệu</option></select></label>
          <label class="booking-field"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"></path></svg><input name="phone" type="tel" placeholder="Số điện thoại" aria-label="Số điện thoại" required /></label>
          <input name="fullname" type="hidden" value="Khách hàng Shome Luxury" />
          <button class="booking-submit" type="submit">Gửi thông tin <span>→</span></button>
          <p class="booking-form-status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section class="booking-process-section">
      <div class="container">
        <div class="booking-process-heading"><span class="booking-process-kicker">Quy trình</span><h2>Thiết kế <i>&amp;</i> Thi công</h2><p>Đơn giản <b>·</b> Minh bạch <b>·</b> Chuyên nghiệp</p></div>
        <div class="booking-process-list">
          <article><b>01</b><div><h3>Tư vấn &amp; khảo sát</h3><p>Lắng nghe nhu cầu, khảo sát thực tế không gian.</p></div></article>
          <article><b>02</b><div><h3>Thiết kế 2D/3D</h3><p>Lên phương án bố trí, phối cảnh chi tiết theo nhu cầu.</p></div></article>
          <article><b>03</b><div><h3>Thi công sản xuất</h3><p>Sản xuất tại xưởng, thi công đúng tiến độ, đảm bảo chất lượng.</p></div></article>
          <article><b>04</b><div><h3>Nghiệm thu bàn giao</h3><p>Kiểm tra, hoàn thiện và bàn giao đúng cam kết.</p></div></article>
        </div>
      </div>
    </section>

    <section class="booking-estimate">
      <div class="container">
        <div class="booking-estimate-header">
          <h2>Báo giá chi tiết cân đối<br><em>ngân sách của bạn</em></h2>
        </div>
        <div class="booking-estimate-content">
          <div class="booking-estimate-col-left">
            <ul class="booking-estimate-features">
              <li>
                <span class="feat-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg></span>
                <span>Minh bạch chủng loại vật liệu</span>
              </li>
              <li>
                <span class="feat-icon"><svg viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path><path d="M18 12a2 2 0 0 0 0 4h4v-4z"></path></svg></span>
                <span>Tối ưu ngân sách</span>
              </li>
              <li>
                <span class="feat-icon"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg></span>
                <span>Hạn chế tối đa chi phí phát sinh</span>
              </li>
            </ul>
          </div>
          <div class="booking-estimate-col-right">
            <div class="booking-estimate-image-wrap">
              <img src="/images/booking-estimate-visual.png" alt="Báo giá chi tiết cân đối ngân sách Shome Luxury" class="booking-estimate-img" width="600" height="340" loading="lazy" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="booking-faq">
      <div class="container">
        <div class="booking-faq-header">
          <h2>CÂU HỎI THƯỜNG GẶP</h2>
        </div>
        <div class="booking-faq-list">
          <details>
            <summary><i>01</i>Bao lâu hoàn thiện?</summary>
            <p>Thời gian phụ thuộc quy mô và hiện trạng công trình. Shome Luxury sẽ gửi lộ trình thi công chi tiết cho từng giai đoạn.</p>
          </details>
          <details>
            <summary><i>02</i>Có phát sinh chi phí không?</summary>
            <p>Mọi chi phí được thống nhất trước khi triển khai, cam kết không tự ý phát sinh chi phí ngoài hợp đồng.</p>
          </details>
          <details>
            <summary><i>03</i>Có bảo hành không?</summary>
            <p>Công trình được bảo hành chính hãng theo từng hạng mục và vật liệu, kèm hỗ trợ bảo trì dài hạn.</p>
          </details>
          <details>
            <summary><i>04</i>Có được chỉnh sửa thiết kế không?</summary>
            <p>Bạn được trao đổi và điều chỉnh phương án trong giai đoạn thiết kế 2D/3D đến khi hoàn toàn hài lòng.</p>
          </details>
          <details>
            <summary><i>05</i>Quy trình thanh toán như thế nào?</summary>
            <p>Thanh toán được chia làm nhiều đợt linh hoạt theo từng mốc tiến độ thi công thực tế và nghiệm thu từng hạng mục.</p>
          </details>
          <details>
            <summary><i>06</i>Shome Luxury có xưởng sản xuất trực tiếp không?</summary>
            <p>Công ty sở hữu 3 xưởng sản xuất quy mô lớn tại Hà Nội với máy móc CNC hiện đại giúp tối ưu giá thành tận gốc và kiểm soát chất lượng nghiêm ngặt.</p>
          </details>
          <details>
            <summary><i>07</i>Vật liệu thi công có đúng cam kết ban đầu?</summary>
            <p>Cam kết 100% vật liệu chuẩn chính hãng theo đúng hợp đồng (gỗ An Cường, phụ kiện Hafele/Blum...), khách hàng được kiểm tra vật liệu trước khi lắp đặt.</p>
          </details>
          <details>
            <summary><i>08</i>Tỉnh xa có được hỗ trợ thiết kế & thi công không?</summary>
            <p>Shome Luxury nhận thiết kế và thi công trọn gói trên toàn quốc. Đội ngũ KTS sẵn sàng tới tận nơi tư vấn và khảo sát hiện trạng.</p>
          </details>
        </div>
      </div>
    </section>

    <section class="booking-testimonial">
      <div class="container">
        <div class="testimonial-heading">
          <span class="testimonial-kicker">Ý KIẾN KHÁCH HÀNG</span>
          <h2>Nghe khách hàng <em>nói rõ chất lượng</em></h2>
          <p>Cảm nhận chân thực từ những gia chủ đã tin tưởng Shome Luxury</p>
        </div>

        <div class="testimonial-slider-wrapper">
          <div class="testimonial-slider" id="testimonialSlider">
            <!-- Review 1 -->
            <div class="testimonial-card">
              <div class="testimonial-user">
                <img src="/images/avatars/avatar-anh-vu.jpg" alt="Anh Vũ" class="user-avatar-img" width="48" height="48" />
                <div>
                  <h3 class="user-name">Anh Vũ</h3>
                  <div class="user-stars">★★★★★</div>
                </div>
              </div>
              <div class="testimonial-body">
                <p>Tôi tới phút này cảm nhận quyết định đúng vì đã chọn bên em.</p>
              </div>
              <div class="testimonial-card-footer">
                <div class="testimonial-reply">
                  <div class="reply-content">
                    <strong>Minh Hiếu</strong>
                    <span>@minhhieu Dạ em cảm ơn anh nhiều nha.</span>
                  </div>
                </div>
                <div class="testimonial-gold-quote">”</div>
              </div>
            </div>

            <!-- Review 2 -->
            <div class="testimonial-card">
              <div class="testimonial-user">
                <img src="/images/avatars/avatar-hue-luong.jpg" alt="Chị Hue Luong" class="user-avatar-img" width="48" height="48" />
                <div>
                  <h3 class="user-name">Chị Hue Luong</h3>
                  <div class="user-stars">★★★★★</div>
                </div>
              </div>
              <div class="testimonial-body">
                <p>Chị gửi lời cảm ơn đến đội ngũ Nội thất Shome Luxury, cả nhà chị đều hài lòng với tư vấn thiết kế cũng như đội ngũ thi công của bên em.</p>
              </div>
              <div class="testimonial-card-footer">
                <div class="testimonial-reply">
                  <div class="reply-content">
                    <strong>Shome Luxury</strong>
                    <span>@shome Dạ cảm ơn chị đã tin tưởng ủng hộ đội ngũ!</span>
                  </div>
                </div>
                <div class="testimonial-gold-quote">”</div>
              </div>
            </div>

            <!-- Review 3 -->
            <div class="testimonial-card">
              <div class="testimonial-user">
                <img src="/images/avatars/avatar-rena-ngoc-thuy.jpg" alt="Chị Rena Ngọc Thùy" class="user-avatar-img" width="48" height="48" />
                <div>
                  <h3 class="user-name">Chị Rena Ngọc Thùy</h3>
                  <div class="user-stars">★★★★★</div>
                </div>
              </div>
              <div class="testimonial-body">
                <p>Cảm ơn đội ngũ Nội thất Shome Luxury đã đem đến 1 sản phẩm hoàn mỹ về chất lượng, giá cả, mẫu mã thiết kế và đặc biệt là thái độ làm việc rất tích cực.</p>
              </div>
              <div class="testimonial-card-footer">
                <div class="testimonial-reply">
                  <div class="reply-content">
                    <strong>Tuấn Anh</strong>
                    <span>@tuananh KTS Chúc gia đình chị Thùy luôn hạnh phúc!</span>
                  </div>
                </div>
                <div class="testimonial-gold-quote">”</div>
              </div>
            </div>

            <!-- Review 4 -->
            <div class="testimonial-card">
              <div class="testimonial-user">
                <img src="/images/avatars/avatar-bich-thu.jpg" alt="Chị Bích Thu" class="user-avatar-img" width="48" height="48" />
                <div>
                  <h3 class="user-name">Chị Bích Thu</h3>
                  <div class="user-stars">★★★★★</div>
                </div>
              </div>
              <div class="testimonial-body">
                <p>Bảng dự toán chi tiết rõ ràng, không phát sinh chi phí ngoài hợp đồng. Rất an tâm khi làm việc.</p>
              </div>
              <div class="testimonial-card-footer">
                <div class="testimonial-reply">
                  <div class="reply-content">
                    <strong>Shome Luxury</strong>
                    <span>@shome Cảm ơn sự đồng hành quý báu của chị Thu ạ.</span>
                  </div>
                </div>
                <div class="testimonial-gold-quote">”</div>
              </div>
            </div>

            <!-- Review 5 -->
            <div class="testimonial-card">
              <div class="testimonial-user">
                <img src="/images/avatars/avatar-viet-duc.jpg" alt="Anh Việt Đức" class="user-avatar-img" width="48" height="48" />
                <div>
                  <h3 class="user-name">Anh Việt Đức</h3>
                  <div class="user-stars">★★★★★</div>
                </div>
              </div>
              <div class="testimonial-body">
                <p>Kiến trúc sư lắng nghe ý kiến gia đình và xử lý ánh sáng không gian sống rất tinh tế.</p>
              </div>
              <div class="testimonial-card-footer">
                <div class="testimonial-reply">
                  <div class="reply-content">
                    <strong>Đức Anh</strong>
                    <span>@ducanh Dạ em cảm ơn anh Đức nhiều ạ!</span>
                  </div>
                </div>
                <div class="testimonial-gold-quote">”</div>
              </div>
            </div>
          </div>

          <!-- Slider Pagination Dots & Arrows -->
          <div class="testimonial-nav">
            <button class="nav-prev" aria-label="Review trước">‹</button>
            <div class="slider-dots">
              <span class="dot active"></span>
              <span class="dot"></span>
              <span class="dot"></span>
              <span class="dot"></span>
              <span class="dot"></span>
            </div>
            <button class="nav-next" aria-label="Review tiếp">›</button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%- include("partials/footer") %>
  
  <script>
    document.getElementById('bookingForm')?.addEventListener('submit', async event => {
      event.preventDefault();
      const form = event.currentTarget;
      const button = form.querySelector('button');
      const status = form.querySelector('.booking-form-status');
      button.disabled = true; button.textContent = 'Đang gửi…';
      try {
        const data = Object.fromEntries(new FormData(form));
        const response = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const result = await response.json();
        status.textContent = result.message || 'Thông tin đã được gửi thành công.';
        form.reset();
      } catch { status.textContent = 'Chưa thể gửi thông tin. Vui lòng thử lại sau.'; }
      finally { button.disabled = false; button.innerHTML = 'Gửi thông tin <span>→</span>'; }
    });

    (function() {
      const slider = document.getElementById('testimonialSlider');
      if (!slider) return;
      const cards = slider.querySelectorAll('.testimonial-card');
      const dots = document.querySelectorAll('.slider-dots .dot');
      const prevBtn = document.querySelector('.testimonial-nav .nav-prev');
      const nextBtn = document.querySelector('.testimonial-nav .nav-next');

      function getStepWidth() {
        if (!cards.length) return 0;
        const cardWidth = cards[0].offsetWidth;
        const style = window.getComputedStyle(slider);
        const gap = parseFloat(style.gap) || 24;
        return cardWidth + gap;
      }

      function updateDots() {
        const step = getStepWidth();
        if (!step) return;
        const scrollPos = slider.scrollLeft;
        const maxScroll = slider.scrollWidth - slider.clientWidth;
        let activeIndex = Math.round(scrollPos / step);
        if (scrollPos >= maxScroll - 10) {
          activeIndex = cards.length - 1;
        }
        activeIndex = Math.max(0, Math.min(cards.length - 1, activeIndex));
        dots.forEach((dot, idx) => {
          dot.classList.toggle('active', idx === activeIndex);
        });
      }

      function scrollToCard(index) {
        if (index < 0) index = cards.length - 1;
        if (index >= cards.length) index = 0;
        const step = getStepWidth();
        const maxScroll = slider.scrollWidth - slider.clientWidth;
        const targetLeft = Math.min(index * step, maxScroll);
        slider.scrollTo({ left: targetLeft, behavior: 'smooth' });
        updateDots();
      }

      prevBtn?.addEventListener('click', () => {
        const step = getStepWidth();
        const currentIdx = Math.round(slider.scrollLeft / step);
        scrollToCard(currentIdx - 1);
      });

      nextBtn?.addEventListener('click', () => {
        const step = getStepWidth();
        const currentIdx = Math.round(slider.scrollLeft / step);
        scrollToCard(currentIdx + 1);
      });

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', () => scrollToCard(idx));
      });

      let scrollTimeout;
      slider.addEventListener('scroll', () => {
        window.clearTimeout(scrollTimeout);
        scrollTimeout = window.setTimeout(updateDots, 60);
      }, { passive: true });

      updateDots();
    })();
  </script>
</body>
</html>
