<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no, viewport-fit=cover" />
  <title><%= title %></title>
  <meta name="description" content="<%= project.excerpt ? project.excerpt.replace(/<[^>]*>?/gm, '').substring(0, 160) : project.title %>" />
  <meta name="theme-color" content="#171717" />

  <!-- CSS Stylesheet -->
  <link rel="stylesheet" href="/css/style.css?v=6.4.7" />
  <script src="/js/main.js?v=1.9.0" defer></script>
</head>
<body>

  <!-- Header -->
  <%- include("partials/header") %>

  <!-- Mobile Drawer -->
  <%- include("partials/mobile-drawer") %>

  <!-- Main Content -->
  <main id="main-content" class="project-detail-page" data-project-slug="<%= project.slug %>">
    <div class="container">
      <!-- Project Detail Header -->
      <header class="project-detail-header">
        <h1 class="project-detail-title" data-project-field="title"><%= project.title %></h1>
        <span class="project-detail-title-rule" aria-hidden="true"></span>
      </header>

      <% const detailMockImages = ['/images/project_apartment.jpg', '/images/project_villa.jpg', '/images/hero_interior.jpg', '/images/hero_sofa_light.jpg', '/images/service_interior.jpg']; %>
      <% const detailImageSrc = project.thumbnail || detailMockImages[(project.title || '').length % detailMockImages.length]; %>
      <% const projectGallery = project.gallery && project.gallery.length ? project.gallery : detailMockImages; %>
      <% const galleryImages = [...new Set([detailImageSrc, ...projectGallery].filter(Boolean))]; %>
      <aside class="project-info-banner" aria-label="Thông tin dự án">
        <div class="project-info-container">
          <div class="project-meta-grid">
            <% if (project.area) { %>
              <div class="meta-item">
                <span class="meta-label">Diện tích</span>
                <span class="meta-value" data-project-field="area"><%= project.area %></span>
              </div>
            <% } %>
            <% if (project.propertyType) { %>
              <div class="meta-item">
                <span class="meta-label">Loại hình</span>
                <span class="meta-value" data-project-field="propertyType"><%= project.propertyType %></span>
              </div>
            <% } %>
            <% if (project.style) { %>
              <div class="meta-item">
                <span class="meta-label">Phong cách</span>
                <span class="meta-value" data-project-field="style"><%= project.style %></span>
              </div>
            <% } %>
            <% if (Number.isFinite(Number(project.cost))) { %>
              <div class="meta-item">
                <span class="meta-label">Chi phí</span>
                <span class="meta-value" data-project-field="cost" data-project-cost><%= Math.round(Number(project.cost) / 1000000).toLocaleString('vi-VN') %> triệu</span>
              </div>
            <% } %>
          </div>
        </div>
      </aside>
      <section class="project-showcase-gallery" data-project-gallery aria-label="Thư viện ảnh công trình <%= project.title %>">
        <div class="project-gallery-stage">
          <img src="<%= galleryImages[0] %>" alt="<%= project.title %> - ảnh 1" class="hero-img" data-detail-image loading="eager" draggable="false"
               onerror="this.onerror=null;this.src='/images/project_apartment.jpg';" />
          <img class="project-gallery-drag-preview" data-gallery-drag-preview alt="" aria-hidden="true" draggable="false" />
          <div class="project-gallery-stage-shade" aria-hidden="true"></div>
          <div class="project-gallery-count" aria-live="polite"><span data-gallery-current>01</span><span>/</span><span data-gallery-total><%= String(galleryImages.length).padStart(2, '0') %></span></div>
          <button class="project-gallery-control previous" type="button" data-gallery-prev aria-label="Ảnh trước">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button class="project-gallery-control next" type="button" data-gallery-next aria-label="Ảnh tiếp theo">
            <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
        <div class="project-gallery-thumbnails" data-gallery-thumbnails role="list" aria-label="Chọn ảnh công trình">
          <% galleryImages.forEach((imgUrl, idx) => { %>
            <button class="project-gallery-thumbnail <%= idx === 0 ? 'is-active' : '' %>" type="button" data-gallery-thumb data-index="<%= idx %>" aria-label="Xem ảnh <%= idx + 1 %>" aria-current="<%= idx === 0 ? 'true' : 'false' %>" role="listitem">
              <img src="<%= imgUrl %>" alt="<%= project.title %> - thumbnail <%= idx + 1 %>" loading="lazy" />
            </button>
          <% }); %>
        </div>
      </section>

      <!-- Related Projects -->
      <% if (relatedProjects && relatedProjects.length > 0) { %>
        <section class="related-projects-section">
          <h2 class="section-title">DỰ ÁN LIÊN QUAN</h2>
          <div class="project-list-vertical">
            <% relatedProjects.forEach(relProj => { %>
              <%- include("partials/project-card", { project: relProj }) %>
            <% }); %>
          </div>
        </section>
      <% } %>
    </div>
  </main>

  <!-- Footer -->
  <%- include("partials/footer") %>

  <!-- Consult Modal -->
  

</body>
</html>
