<%
  const attrs = [];
  if (project.area) attrs.push(`Diện tích: ${project.area}`);
  if (project.style) attrs.push(`Phong cách: ${project.style}`);
  const attrText = attrs.join('   |   ');
  const projectDetailUrl = `/cong-trinh/${project.slug}`;
  const mockImages = [
    '/images/project_apartment.jpg',
    '/images/project_villa.jpg',
    '/images/hero_interior.jpg',
    '/images/hero_sofa_light.jpg',
    '/images/service_interior.jpg'
  ];
%>

<%
  const quotes = [
    { title: 'KIẾN TẠO\nTỔ ẤM HOÀN MỸ', desc: 'Nơi hạnh phúc bắt đầu từ những điều giản dị' },
    { title: 'SỐNG ĐẸP\nMỖI NGÀY', desc: 'Không gian phản chiếu phong cách sống của bạn' },
    { title: 'KHÔNG GIAN\nTRUYỀN CẢM HƯNG', desc: 'Mỗi góc nhỏ đều kể một câu chuyện' },
    { title: 'TINH GIẢN CHO CUỘC SỐNG\nTRỌN VẸN', desc: 'Sống thoải mái trong không gian gia đình riêng cho bạn' }
  ];
  const charSum = (project.title || '').split('').reduce((sum, ch) => sum + ch.charCodeAt(0), 0);
  const selectedQuote = quotes[charSum % quotes.length];
  const titleLines = selectedQuote.title.split('\n');
  const imageSrc = project.thumbnail || mockImages[charSum % mockImages.length];
%>

<article class="project-showcase-card">
  <a href="<%= projectDetailUrl %>" class="project-card-image-link" aria-label="<%= project.title %>">
    <div class="project-card-image-wrapper">
      <img src="<%= imageSrc %>" alt="<%= project.title %>" class="project-card-img" loading="lazy"
           onerror="this.onerror=null;this.src='/images/project_apartment.jpg';" />

      <!-- Typography Quote Overlay matching Reference Image -->
      <div class="project-card-quote-overlay">
        <div class="quote-title">
          <% titleLines.forEach(line => { %>
            <div><%= line %></div>
          <% }); %>
        </div>
        <div class="quote-line"></div>
        <div class="quote-desc"><%= selectedQuote.desc %></div>
      </div>
    </div>
  </a>

  <div class="project-card-info-bar">
    <div class="project-card-meta-left">
      <h2 class="project-card-title">
        <a href="<%= projectDetailUrl %>"><%= project.title %></a>
      </h2>
      <% if (attrText) { %>
        <div class="project-card-attributes">
          <%= attrText %>
        </div>
      <% } %>
    </div>

    <div class="project-card-action-right">
      <a href="<%= projectDetailUrl %>" class="project-card-arrow-btn" aria-label="Xem chi tiết <%= project.title %>">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>
</article>
