<%
  const attrs = [];
  if (project.area) attrs.push({ label: 'Diện tích', value: project.area });
  if (Number.isFinite(Number(project.cost))) attrs.push({ label: 'Chi phí', value: `${Math.round(Number(project.cost) / 1000000).toLocaleString('vi-VN')} triệu` });
  if (project.style) attrs.push({ label: 'Phong cách', value: project.style });
  if (project.propertyType) attrs.push({ label: 'Loại hình', value: project.propertyType });
  const attributeSlots = Array.from({ length: 4 }, (_, index) => attrs[index] || null);
  const projectDetailUrl = `/cong-trinh/${project.slug}`;
%>

<% const primaryImage = project.thumbnail || (Array.isArray(project.gallery) ? project.gallery[0] : ''); %>

<article class="project-showcase-card">
  <div class="project-card-image-wrapper">
    <a class="project-card-image-link" href="<%= projectDetailUrl %>" aria-label="Xem chi tiết <%= project.title %>">
      <div class="project-card-gallery-stage" aria-label="Ảnh chính công trình <%= project.title %>">
      <% if (primaryImage) { %>
        <img src="<%= primaryImage %>" alt="<%= project.title %>" class="project-card-img" loading="lazy" />
      <% } else { %>
        <div class="project-card-image-placeholder" role="img" aria-label="Chưa có ảnh đại diện"></div>
      <% } %>
      </div>
    </a>
  </div>

  <div class="project-card-info-bar">
    <div class="project-card-meta-left">
      <h2 class="project-card-title">
        <a href="<%= projectDetailUrl %>"><%= project.title %></a>
      </h2>
      <% if (attrs.length) { %>
        <div class="project-card-attributes">
          <% attributeSlots.forEach(attribute => { %>
            <span class="project-card-attribute <%= attribute ? '' : 'is-empty' %>">
              <% if (attribute) { %>
                <strong class="project-card-attribute-label"><%= attribute.label %>:</strong>
                <span class="project-card-attribute-value"> <%= attribute.value %></span>
              <% } %>
            </span>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</article>
