<header class="site-header">
  <div class="container header-container">
    <!-- Brand Logo with Slogan -->
    <div class="brand-logo-wrapper">
      <a href="/" class="brand-logo" aria-label="LUXURY HOME">
        <img src="/images/shome-logo.png" alt="LUXURY HOME" class="logo-img" width="160" height="48" />
      </a>
      <span class="logo-divider"></span>
      <span class="logo-slogan font-script">Nâng tầm cuộc sống</span>
    </div>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <% navigation.forEach(item => { %>
        <div class="nav-item <%= item.children ? 'has-dropdown' : '' %>">
          <a href="<%= item.href %>" class="nav-link">
            <%= item.label %>
            <% if (item.children) { %>
              <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% } %>
          </a>

          <% if (item.children) { %>
            <div class="desktop-dropdown">
              <% item.children.forEach(subItem => { %>
                <div class="<%= subItem.children ? 'dropdown-sub' : '' %>">
                  <a href="<%= subItem.href %>" class="dropdown-link"><%= subItem.label %></a>

                  <% if (subItem.children) { %>
                    <div class="dropdown-sub-menu">
                      <% subItem.children.forEach(nestedItem => { %>
                        <a href="<%= nestedItem.href %>" class="dropdown-link"><%= nestedItem.label %></a>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              <% }); %>
            </div>
          <% } %>
        </div>
      <% }); %>
    </nav>

    <!-- Right Header Actions (Hamburger button on mobile) -->
    <div class="header-actions">
      <button class="hamburger-btn" id="hamburgerBtn" aria-label="Open Mobile Menu">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>
      </button>
    </div>
  </div>
</header>
