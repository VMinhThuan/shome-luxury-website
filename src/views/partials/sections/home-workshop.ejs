<section class="home-workshop-section section-bg-white home-background-section home-background-section--dark" id="xuong-san-xuat-home" style="--section-background-image: url('<%= homeImages.home_workshop_background %>');">
  <div class="container">
    <header class="home-workshop-header">
      <h2 class="home-workshop-title">
        <span class="home-workshop-script font-script">Xưởng</span>
        <span class="home-workshop-main">SẢN XUẤT</span>
      </h2>
      <p class="home-workshop-subtitle">Thợ lành nghề, nhiều năm kinh nghiệm</p>
    </header>

    <div class="home-workshop-grid">
      <!-- Left Column: Visual -->
      <div class="home-workshop-visual">
        <img
          src="<%= homeImages.home_workshop_image %>"
          alt="Xưởng sản xuất Shome Luxury - Thợ lành nghề, quy mô hiện đại"
          loading="lazy"
          decoding="async"
          width="800"
          height="600"
        />
      </div>

      <!-- Right Column: 4 Feature Pills -->
      <div class="home-workshop-pills">
        <!-- 01 Thiết bị hiện đại -->
        <div class="home-workshop-pill">
          <div class="home-workshop-pill-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
          </div>
          <span class="home-workshop-pill-text">Thiết bị hiện đại</span>
        </div>

        <!-- 02 Đội ngũ tay nghề cao -->
        <div class="home-workshop-pill">
          <div class="home-workshop-pill-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <span class="home-workshop-pill-text">Đội ngũ tay nghề cao</span>
        </div>

        <!-- 03 Kiểm soát chất lượng nghiêm ngặt -->
        <div class="home-workshop-pill">
          <div class="home-workshop-pill-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <path d="m9 12 2 2 4-4"></path>
            </svg>
          </div>
          <span class="home-workshop-pill-text">Kiểm soát chất lượng nghiêm ngặt</span>
        </div>

        <!-- 04 Đáp ứng tiến độ nhanh chóng -->
        <div class="home-workshop-pill">
          <div class="home-workshop-pill-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="20" x2="18" y2="10"></line>
              <line x1="12" y1="20" x2="12" y2="4"></line>
              <line x1="6" y1="20" x2="6" y2="14"></line>
              <line x1="2" y1="20" x2="22" y2="20"></line>
            </svg>
          </div>
          <span class="home-workshop-pill-text">Đáp ứng tiến độ nhanh chóng</span>
        </div>
      </div>
    </div>
  </div>
</section>
