<section class="brand-story-section" id="cau-chuyen-thuong-hieu">
  <div class="container">
    <!-- Header -->
    <header class="brand-story-header">
      <h2 class="brand-story-title">
        <span class="story-title-script font-script">Lắng nghe câu chuyện</span>
        <span class="story-title-main">Shome Luxury</span>
      </h2>
      <div class="brand-story-subtitle">
        <span class="story-divider-line"></span>
        <p>Chuyện về con người, về nghề và những không gian được chăm chút.</p>
        <span class="story-divider-line"></span>
