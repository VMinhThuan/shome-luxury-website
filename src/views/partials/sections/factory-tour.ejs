<section class="factory-tour-section" id="mot-vong-quanh-xuong">
  <div class="container">
    <div class="factory-tour-header">
      <h2 class="factory-tour-title">
        <span class="factory-tour-main">Mỗi khu vực,</span>
        <span class="factory-tour-accent font-script">mỗi nhiệm vụ</span>
      </h2>
      <p>Sắp xếp theo công đoạn giúp theo dõi sản phẩm<br class="factory-tour-break"> từ vật liệu đầu vào đến khi xuất xưởng.</p>
    </div>

    <% const tourSteps = [
      {
        number: '01', title: 'Tiếp nhận & lưu trữ vật liệu',
        description: 'Phân loại vật liệu, kiểm tra bề mặt và bố trí vị trí lưu trữ.',
        image: (locals.factoryImages && factoryImages.factory_tour_1) || '/images/img-xuong-san-xuat/factory-tour-storage.png', alt: 'Khu vực tiếp nhận và lưu trữ vật liệu tại xưởng'
      },
      {
        number: '02', title: 'Gia công chi tiết',
        description: 'Gia công theo bản vẽ và nhận diện từng chi tiết.',
        image: (locals.factoryImages && factoryImages.factory_tour_2) || '/images/img-xuong-san-xuat/factory-tour-cnc.png', alt: 'Máy CNC gia công chi tiết nội thất'
      },
      {
        number: '03', title: 'Lắp thử & đối chiếu',
        description: 'Kiểm tra kích thước, liên kết và sự đồng bộ của sản phẩm.',
        image: (locals.factoryImages && factoryImages.factory_tour_3) || '/images/img-xuong-san-xuat/factory-tour-assembly.png', alt: 'Đội ngũ lắp thử sản phẩm tại xưởng'
      },
      {
        number: '04', title: 'Kiểm tra trước xuất xưởng',
        description: 'Đối chiếu số lượng, bề mặt và phụ kiện theo từng hạng mục.',
        image: (locals.factoryImages && factoryImages.factory_tour_4) || '/images/img-xuong-san-xuat/factory-tour-quality-check.png', alt: 'Kiểm tra chất lượng sản phẩm trước khi xuất xưởng'
      }
    ]; %>

    <div class="factory-tour-list">
      <% tourSteps.forEach(step => { %>
        <article class="factory-tour-item">
          <div class="factory-tour-media">
            <img src="<%= step.image %>" alt="<%= step.alt %>" loading="lazy" decoding="async" width="1200" height="675" />
          </div>
          <div class="factory-tour-step">
            <span class="factory-tour-number"><%= step.number %></span>
            <div>
              <h3><%= step.title %></h3>
              <p><%= step.description %></p>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>
