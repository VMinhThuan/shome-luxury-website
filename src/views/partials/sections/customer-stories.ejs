<section class="customer-stories-section" id="khach-hang-chia-se">
  <div class="container">
    <header class="customer-stories-header">
      <h2 class="customer-stories-title">
        <span class="customer-stories-script font-script">Khách hàng</span>
        <span class="customer-stories-main">CHIA SẺ</span>
      </h2>
      <p>Những phản hồi được trích từ cuộc trò chuyện thực tế cùng khách hàng.</p>
    </header>

    <% const feedbacks = [
      { name: 'Chị Linh', project: 'Biệt thự sân vườn', image: '1792222115348_6043215661779559246_6043215661779559246_01b44922101989e305f01bad5accb18d.jpg', quote: 'Hoàn công còn đẹp hơn thiết kế; đội ngũ làm việc rất chuyên nghiệp và tinh tế.' },
      { name: 'Chị Thắm', project: 'Chuỗi cafe', image: '1792222116061_6043215661779559246_6043215661779559246_5125bee0bd4dc54dccea59475e93e70e.jpg', quote: 'Bên em làm có tâm, chị còn muốn nhờ setup thêm cơ sở nữa.' },
      { name: 'Chị Huyền', project: 'Văn phòng The Address', image: '1792222116666_6043215661779559246_6043215661779559246_43f8098458f4b617f70e0543f424e99c.jpg', quote: 'Xưởng làm có tâm, đội ngũ thi công tỉ mỉ nên cả anh chị đều rất thích.' },
      { name: 'Anh Thắng', project: 'Công trình Hoàn Kiếm', image: '1792222117834_6043215661779559246_6043215661779559246_538359c82f5edaadd11615b29b92b4ee.jpg', quote: 'Mọi giai đoạn thực hiện chuyên nghiệp, công trình hoàn thiện trọn vẹn.' },
      { name: 'Bác Kiên', project: 'Biệt thự Ecopark', image: '1792222118526_6043215661779559246_6043215661779559246_2b8d5dd9b1bdc6fb1f3c7e477b96d548.jpg', quote: 'Phòng khách đẹp, long lanh và rất ưng ý.' },
      { name: 'Chị Thắm', project: 'Chuỗi cafe', image: '1792222119213_6043215661779559246_6043215661779559246_cad9e060752cce8d5c76e9f94ccb8b65.jpg', quote: 'Cảm ơn Shome nhiều, có tâm và trách nhiệm.' },
      { name: 'Anh Bình', project: 'Nhà phố Cầu Giấy', image: '1792222119987_6043215661779559246_6043215661779559246_fb0bc1d1403b47e6cc49cb513faae79b.jpg', quote: 'Thi công ngoài mong đợi; ai vào cũng khen nhà đẹp.' },
      { name: 'Anh Trọng', project: 'Công trình Thái Hà', image: '1792222120845_6043215661779559246_6043215661779559246_ecdfc43fcd12227cfe0033f43f12e196.jpg', quote: 'Thiết kế đẹp, thi công chất lượng và hoàn thiện nhanh chóng.' },
      { name: 'Cô Nga', project: 'Vinhomes Riverside', image: '1792222122127_6043215661779559246_6043215661779559246_3b34868292132fdc1c97d45410cc629a.jpg', quote: 'Hẹn 10 ngày mà mới 7 ngày đã xong; màu sơn và đồ sản xuất rất tỉ mỉ.' },
      { name: 'Chị Nhung', project: 'Công trình Bạch Mai', image: '1792222123036_6043215661779559246_6043215661779559246_2babcfde9a165d462a5ecea4d8538e0f.jpg', quote: 'Từ lúc thiết kế đã ưng, phần thi công cũng chuyên nghiệp.' },
      { name: 'Chị Lệ', project: 'Time City 703', image: '1792222123788_6043215661779559246_6043215661779559246_7ec6445f346f1b40a77466a09ae5aff5.jpg', quote: 'Sử dụng nội thất rất hài lòng, bảo hành chu đáo như mới làm hôm qua.' }
    ]; %>

    <div class="customer-testimonial-wrap">
      <div class="customer-testimonial-grid" aria-label="Các phản hồi khách hàng từ Zalo">
        <% feedbacks.forEach((feedback) => { %>
          <article class="customer-testimonial-card">
            <div class="customer-testimonial-copy">
              <div class="customer-testimonial-user">
                <div>
                  <h3><%= feedback.name %></h3>
                  <p><%= feedback.project %></p>
                  <span aria-label="5 trên 5 sao">★★★★★</span>
                </div>
              </div>
              <p class="customer-testimonial-message">“<%= feedback.quote %>”</p>
              <small class="customer-feedback-source">Phản hồi qua Zalo</small>
            </div>
            <figure class="customer-feedback-proof">
              <img src="/images/feedback/<%= feedback.image %>" alt="Ảnh chụp phản hồi Zalo của <%= feedback.name %>" loading="lazy" />
            </figure>
          </article>
        <% }); %>
      </div>
      <div class="testimonial-dots customer-testimonial-dots" aria-label="Chọn nhóm đánh giá"></div>
    </div>
  </div>
</section>
