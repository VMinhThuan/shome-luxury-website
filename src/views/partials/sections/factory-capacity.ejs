<section class="capacity-section-v2" id="xuong-san-xuat">
  <div class="capacity-bg-decor"></div>
  <div class="container">
    <!-- Header -->
    <div class="capacity-v2-header">
      <h2 class="capacity-v2-title">Trang thiết bị hiện đại</h2>
    </div>

    <!-- Equipment Cards List -->
    <div class="capacity-cards-list">
      <% const equipmentCards = [
        { image: '/images/cnc_machine.jpg', title: 'Máy cắt CNC\nhiện đại', description: 'Gia công chính xác cao, đáp ứng đa dạng nhu cầu sản xuất.', icon: 'home' },
        { image: '/images/factory_cnc.jpg', title: 'Dây chuyền\ntự động', description: 'Tối ưu năng suất, đảm bảo chất lượng.', icon: 'machine' },
        { image: '/images/factory_workers.jpg', title: 'Máy khoan – phay\nchính xác', description: 'Độ chính xác cao, đáp ứng các chi tiết.', icon: 'drill' }
      ]; %>
      <% equipmentCards.forEach(card => { %>
        <article class="capacity-card-v2">
          <!-- Khung dùng lại; chỉ cần thay image/title/description trong equipmentCards. -->
          <img src="/images/Minimal%20Cream%20Wave%20UI%20Card%20Template.png" alt="" class="capacity-card-frame" aria-hidden="true" />
          <img src="<%= card.image %>" alt="<%= card.title.replace(/\n/g, ' ') %> S-Home Luxury" class="capacity-card-media" loading="lazy" decoding="async" />
          <div class="capacity-card-overlay">
            <div class="capacity-card-icon" aria-hidden="true">
              <% if (card.icon === 'home') { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M3 10l5-4 5 4 5-4 3 2.4V21H3V10z"/><path d="M9 21v-4a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v4"/></svg>
              <% } else if (card.icon === 'machine') { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="8" rx="2"/><circle cx="6" cy="18" r="2"/><circle cx="12" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M6 14v2M12 14v2M18 14v2"/></svg>
              <% } else { %>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v10M9 6h6M7 12h10M5 22h14M8 18h8M10 14v4M14 14v4"/></svg>
              <% } %>
            </div>
            <h3 class="capacity-card-title"><%= card.title %></h3>
            <p class="capacity-card-desc"><%= card.description %></p>
            <div class="capacity-card-dots" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>
