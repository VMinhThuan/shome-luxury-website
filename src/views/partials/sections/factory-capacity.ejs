<section class="capacity-section-v2" id="xuong-san-xuat">
  <div class="container">
    <!-- Header -->
    <div class="capacity-v2-header">
      <h2 class="capacity-v2-title capacity-paired-title">
        <span class="capacity-paired-title-main">Trang thiết bị</span> <span class="capacity-paired-title-accent font-script">hiện đại</span>
      </h2>
      <p class="capacity-v2-desc">Hệ thống máy móc hiện đại giúp đảm bảo độ chính xác và chất lượng trong từng sản phẩm.</p>
    </div>

    <!-- Equipment Cards Grid -->
    <div class="capacity-cards-grid">
      <% const defaultImages = [
        (locals.factoryImages && factoryImages.factory_equip_1) || '/images/cnc_machine.jpg',
        (locals.factoryImages && factoryImages.factory_equip_2) || '/images/auto_line.jpg',
        (locals.factoryImages && factoryImages.factory_equip_3) || '/images/drill_machine.jpg',
        (locals.factoryImages && factoryImages.factory_equip_4) || '/images/edge_banding.jpg'
      ];
      const equipmentCards = (capacityItems || []).map((item, index) => ({
        ...item,
        image: defaultImages[index] || item.image || '/images/edge_banding.jpg',
        title: item.title,
        description: item.description
      })); %>
      <% equipmentCards.forEach(card => { %>
        <article class="capacity-equipment-card">
          <div class="equipment-card-image">
            <img src="<%= card.image %>" alt="<%= card.title %> - Shome Luxury" loading="lazy" decoding="async" />
          </div>
          <div class="equipment-card-body">
            <div class="equipment-header-row">
              <h3 class="equipment-card-title"><%= card.title %></h3>
            </div>
            <p class="equipment-card-desc"><%= card.description %></p>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>
