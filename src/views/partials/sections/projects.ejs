<section class="projects-section section-padding" id="du-an-noi-bat">
  <div class="container">
    <div class="projects-header">
      <div>
        <span class="eyebrow">Công trình tiêu biểu</span>
        <h2 class="section-title font-serif">Dự án nổi bật</h2>
      </div>

      <div class="project-filter-tabs">
        <button class="filter-btn active" data-filter="all">Tất cả</button>
        <button class="filter-btn" data-filter="chung-cu">Chung cư</button>
        <button class="filter-btn" data-filter="nha-pho">Nhà phố</button>
        <button class="filter-btn" data-filter="biet-thu">Biệt thự</button>
        <button class="filter-btn" data-filter="van-phong">Văn phòng</button>
      </div>
    </div>

    <div class="projects-grid">
      <% projects.forEach(project => { %>
        <%
          const projectAttributes = [];
          if (project.area) projectAttributes.push(`Diện tích: ${project.area}`);
          if (Number.isFinite(Number(project.cost))) {
            projectAttributes.push(`Chi phí: ${Math.round(Number(project.cost) / 1000000).toLocaleString('vi-VN')} triệu`);
          }
          if (project.style) projectAttributes.push(`Phong cách: ${project.style}`);
          if (project.propertyType) projectAttributes.push(`Loại hình: ${project.propertyType}`);
        %>
        <article class="project-card" data-category="<%= project.categorySlug %>">
          <img src="<%= project.image %>" alt="<%= project.title %>" class="project-img" loading="lazy" width="800" height="500" />
          <div class="project-overlay">
            <span class="project-category"><%= project.category %></span>
            <h3 class="project-name font-serif"><%= project.title %></h3>
            <% if (projectAttributes.length) { %>
              <div class="project-meta">
                <% projectAttributes.forEach((attribute, index) => { %>
                  <% if (index > 0) { %><span aria-hidden="true">•</span><% } %>
                  <span><%= attribute %></span>
                <% }); %>
              </div>
            <% } %>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>
