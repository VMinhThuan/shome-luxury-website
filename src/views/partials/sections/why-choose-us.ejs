<section class="why-choose-section section-bg-white home-background-section home-background-section--dark home-background-section--original" id="tai-sao-chon-chung-toi" style="--section-background-image: url('<%= homeImages.why_choose_background %>');">
  <div class="container">
    <header class="why-choose-header">
      <h2 class="why-choose-title">
        <span class="why-choose-script font-script">Tại sao chọn</span>
        <span class="why-choose-main">CHÚNG TÔI</span>
      </h2>
      <p class="why-choose-subtitle">
        Shome Luxury luôn đặt khách hàng làm trung tâm, mang đến những không gian sống đẳng cấp với chất lượng vượt trội và giá trị bền vững theo thời gian.
      </p>
    </header>

    <div class="why-choose-grid">
      <!-- Card 01 -->
      <article class="why-choose-card">
        <div class="why-choose-thumb">
          <img
            src="<%= homeImages.why_choose_architect %>"
            alt="Kiến trúc sư giàu kinh nghiệm - Shome Luxury"
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
        </div>
        <div class="why-choose-body">
          <div class="why-choose-meta">
            <span class="why-choose-num">01</span>
            <span class="why-choose-sep">|</span>
            <h3 class="why-choose-card-title">Kiến trúc sư giàu kinh nghiệm</h3>
          </div>
          <p class="why-choose-desc">
            Nhiều năm kinh nghiệm, am hiểu không gian và tư vấn giải pháp phù hợp.
          </p>
        </div>
      </article>

      <!-- Card 02 -->
      <article class="why-choose-card">
        <div class="why-choose-thumb">
          <img
            src="<%= homeImages.why_choose_warranty %>"
            alt="Thi công, bảo hành dài hạn - Shome Luxury"
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
        </div>
        <div class="why-choose-body">
          <div class="why-choose-meta">
            <span class="why-choose-num">02</span>
            <span class="why-choose-sep">|</span>
            <h3 class="why-choose-card-title">Thi công, bảo hành dài hạn</h3>
          </div>
          <p class="why-choose-desc">
            Thi công chỉnh chu, bảo hành dài hạn và hỗ trợ tận tâm.
          </p>
        </div>
      </article>

      <!-- Card 03 -->
      <article class="why-choose-card">
        <div class="why-choose-thumb">
          <img
            src="<%= homeImages.why_choose_craftsman %>"
            alt="Thợ sản xuất lành nghề - Shome Luxury"
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
        </div>
        <div class="why-choose-body">
          <div class="why-choose-meta">
            <span class="why-choose-num">03</span>
            <span class="why-choose-sep">|</span>
            <h3 class="why-choose-card-title">Thợ sản xuất lành nghề</h3>
          </div>
          <p class="why-choose-desc">
            Đôi tay lành nghề, tỉ mỉ trong từng công đoạn, chỉnh chu từng sản phẩm.
          </p>
        </div>
      </article>

      <!-- Card 04 -->
      <article class="why-choose-card">
        <div class="why-choose-thumb">
          <img
            src="<%= homeImages.why_choose_pricing %>"
            alt="Giá cả cạnh tranh - Shome Luxury"
            loading="lazy"
            decoding="async"
            width="600"
            height="400"
          />
        </div>
        <div class="why-choose-body">
          <div class="why-choose-meta">
            <span class="why-choose-num">04</span>
            <span class="why-choose-sep">|</span>
            <h3 class="why-choose-card-title">Giá cả cạnh tranh</h3>
          </div>
          <p class="why-choose-desc">
            Tối ưu chi phí, báo giá minh bạch, phù hợp với ngân sách của bạn.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
