<section class="project-types-section" id="cac-dang-cong-trinh">
  <div class="container">
    <!-- Section Header -->
    <div class="project-types-header">
      <h2 class="project-types-title">
        <span class="title-line-1">Mỗi công trình,</span>
        <span class="title-line-2">
          <span class="title-main">một</span>
          <span class="title-script font-script">dấu ấn</span>
        </span>
      </h2>
      <p class="project-types-desc">
        Thiết kế tinh tế · Thi công chỉn chu
      </p>
    </div>

    <!-- 4 Category Cards Grid -->
    <div class="project-types-grid">
      <!-- 01 Chung cư -->
      <article class="project-type-card">
        <div class="type-card-bg">
          <img
            src="/images/project-cat-chung-cu.jpg"
            alt="Thiết kế thi công nội thất Chung cư cao cấp SHOME LUXURY"
            loading="lazy"
            decoding="async"
            width="800"
            height="600"
          />
          <div class="type-card-gradient"></div>
        </div>
        <div class="type-card-content">
          <span class="type-card-number">| 01</span>
          <h3 class="type-card-name">Chung cư</h3>
          <div class="type-card-features">
            <p>Tối ưu diện tích</p>
            <p>Tiện nghi hiện đại</p>
          </div>
          <a href="/thiet-ke-noi-that/chung-cu" class="type-card-btn" aria-label="Xem tất cả dự án chung cư">
            Xem tất cả
          </a>
        </div>
      </article>

      <!-- 02 Nhà phố -->
      <article class="project-type-card project-type-card--reverse">
        <div class="type-card-bg">
          <img
            src="/images/project-cat-nha-pho.jpg"
            alt="Thiết kế thi công kiến trúc & nội thất Nhà phố SHOME LUXURY"
            loading="lazy"
            decoding="async"
            width="800"
            height="600"
          />
          <div class="type-card-gradient"></div>
        </div>
        <div class="type-card-content">
          <span class="type-card-number">| 02</span>
          <h3 class="type-card-name">Nhà phố</h3>
          <div class="type-card-features">
            <p>Hiện đại</p>
            <p>Gắn kết gia đình</p>
          </div>
          <a href="/thiet-ke-noi-that/nha-pho" class="type-card-btn" aria-label="Xem tất cả dự án nhà phố">
            Xem tất cả
          </a>
        </div>
      </article>

      <!-- 03 Biệt thự -->
      <article class="project-type-card">
        <div class="type-card-bg">
          <img
            src="/images/project-cat-biet-thu.jpg"
            alt="Thiết kế thi công kiến trúc & nội thất Biệt thự đẳng cấp SHOME LUXURY"
            loading="lazy"
            decoding="async"
            width="800"
            height="600"
          />
          <div class="type-card-gradient"></div>
        </div>
        <div class="type-card-content">
          <span class="type-card-number">| 03</span>
          <h3 class="type-card-name">Biệt thự</h3>
          <div class="type-card-features">
            <p>Sang trọng</p>
            <p>Dấu ấn riêng</p>
          </div>
          <a href="/thiet-ke-noi-that/biet-thu" class="type-card-btn" aria-label="Xem tất cả dự án biệt thự">
            Xem tất cả
          </a>
        </div>
      </article>

      <!-- 04 Văn phòng -->
      <article class="project-type-card project-type-card--reverse">
        <div class="type-card-bg">
          <img
            src="/images/project-cat-van-phong.jpg"
            alt="Thiết kế thi công nội thất Văn phòng hiện đại SHOME LUXURY"
            loading="lazy"
            decoding="async"
            width="800"
            height="600"
          />
          <div class="type-card-gradient"></div>
        </div>
        <div class="type-card-content">
          <span class="type-card-number">| 04</span>
          <h3 class="type-card-name">Văn phòng</h3>
          <div class="type-card-features">
            <p>Chuyên nghiệp</p>
            <p>Hiệu quả</p>
          </div>
          <a href="/thiet-ke-noi-that/van-phong" class="type-card-btn" aria-label="Xem tất cả dự án văn phòng">
            Xem tất cả
          </a>
        </div>
      </article>
    </div>

    <!-- Vật liệu & ĐỐI TÁC -->
    <div class="project-partners-block">
      <div class="partners-header">
        <span class="partners-divider">|</span>
        <h3 class="partners-title">
          <span class="partners-script font-script">Vật liệu &amp;</span>
          <span class="partners-main">ĐỐI TÁC</span>
        </h3>
      </div>
      <div class="partners-grid">
        <div class="partner-card" title="An Cường Wood - Working Materials">
          <img src="/images/partners/an-cuong.svg" alt="An Cường" loading="lazy" width="160" height="42" />
        </div>
        <div class="partner-card" title="HÄFELE">
          <img src="/images/partners/hafele.svg" alt="HÄFELE" loading="lazy" width="130" height="42" />
        </div>
        <div class="partner-card" title="blum">
          <img src="/images/partners/blum.svg" alt="blum" loading="lazy" width="110" height="42" />
        </div>
        <div class="partner-card" title="MALLOCA">
          <img src="/images/partners/malloca.svg" alt="MALLOCA" loading="lazy" width="140" height="42" />
        </div>
        <div class="partner-card" title="caesar">
          <img src="/images/partners/caesar.svg" alt="caesar" loading="lazy" width="120" height="42" />
        </div>
        <div class="partner-card" title="TOTO">
          <img src="/images/partners/toto.svg" alt="TOTO" loading="lazy" width="110" height="42" />
        </div>
      </div>
    </div>
  </div>
</section>
