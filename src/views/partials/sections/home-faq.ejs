<% const homeFaqBackground = (typeof homeImages !== 'undefined' && homeImages.home_faq_background) || '/images/background/1793129515218_6043215661779559246_6043215661779559246_bb3402190775a313002b3616fddfd2e4.jpg'; %>
<section class="home-faq-section home-background-section home-background-section--dark" id="cau-hoi-thuong-gap" style="--section-background-image: url('<%= homeFaqBackground %>');">
  <div class="container">
    <header class="home-faq-header">
      <h2 class="home-faq-title">
        <span class="home-faq-script font-script">Bạn hỏi</span>
        <span class="home-faq-main">CHÚNG TÔI GIẢI ĐÁP</span>
      </h2>
      <p>Những điều cần biết trước khi bắt đầu.</p>
    </header>

    <% const faqs = [
      ['Thiết kế và thi công mất bao lâu?', 'Thời gian phụ thuộc diện tích, hiện trạng và hạng mục. Tiến độ từng giai đoạn được thống nhất sau khảo sát.'],
      ['Chi phí được tính như thế nào?', 'Chi phí được xác định dựa trên diện tích, vật liệu, mức độ hoàn thiện và phạm vi thi công thực tế.'],
      ['Có nhận thiết kế riêng không?', 'Shome Luxury nhận thiết kế theo nhu cầu, phong cách sống và ngân sách riêng của từng khách hàng.'],
      ['Làm sao kiểm soát vật liệu và chất lượng?', 'Vật liệu được duyệt trước khi sản xuất, mỗi hạng mục đều được kiểm tra trong suốt quá trình thi công.'],
      ['Thay đổi thiết kế có phát sinh phí không?', 'Đội ngũ sẽ tư vấn rõ ảnh hưởng về chi phí và tiến độ trước khi triển khai bất kỳ thay đổi nào.'],
      ['Bảo hành sau bàn giao như thế nào?', 'Chúng tôi áp dụng chính sách bảo hành minh bạch và luôn sẵn sàng hỗ trợ sau khi bàn giao.']
    ]; %>

    <div class="home-faq-list">
      <% faqs.forEach((faq) => { %>
        <details class="home-faq-item">
          <summary><span><%= faq[0] %></span><b aria-hidden="true"></b></summary>
          <p><%= faq[1] %></p>
        </details>
      <% }) %>
    </div>

    <div class="home-faq-cta">
      <h3>Bạn còn băn khoăn?</h3>
      <p>Chia sẻ nhu cầu để được tư vấn cụ thể.</p>
      <button type="button" class="trigger-consult-modal">Đặt lịch tư vấn</button>
    </div>
  </div>
</section>
