<section class="factory-gallery-v2-section" id="hinh-anh-xuong">
  <div class="container">
    <!-- Header -->
    <div class="gallery-v2-header">
      <div class="gallery-v2-eyebrow">SẢN PHẨM THỰC TẾ</div>
      <h2 class="gallery-v2-title">Hình ảnh xưởng sản xuất</h2>
      <div class="gallery-v2-line"></div>
    </div>

    <!-- Main Card Slider (3 Interactive Slides) -->
    <div class="gallery-v2-main-card">
      <div class="gallery-v2-slider-container" id="factorySlider">
        <div class="gallery-v2-slider-track">
          <!-- Slide 1 -->
          <div class="gallery-v2-slide">
            <div class="gallery-v2-img-wrap">
              <img src="/images/factory_cnc.jpg" alt="Khu vực sản xuất chính Luxury Home" loading="lazy" decoding="async" width="800" height="500" />
              
              <div class="gallery-v2-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="2">
                  <circle cx="12" cy="12" r="3"/>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
                SẢN XUẤT
              </div>

              <div class="gallery-v2-floating-card">
                <div class="gallery-v2-icon-circle">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="1.8">
                    <path d="M3 21h18M3 10l5-4 5 4 5-4 3 2.4V21H3V10z"/>
                  </svg>
                </div>
                <span class="gallery-v2-floating-title">Khu vực sản xuất chính</span>
              </div>
            </div>
          </div>

          <!-- Slide 2 -->
          <div class="gallery-v2-slide">
            <div class="gallery-v2-img-wrap">
              <img src="/images/factory_workers.jpg" alt="Đội ngũ kỹ thuật gia công sản xuất" loading="lazy" decoding="async" width="800" height="500" />
              
              <div class="gallery-v2-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                </svg>
                KỸ THUẬT
              </div>

              <div class="gallery-v2-floating-card">
                <div class="gallery-v2-icon-circle">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="1.8">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
                  </svg>
                </div>
                <span class="gallery-v2-floating-title">Đội ngũ kỹ thuật gia công</span>
              </div>
            </div>
          </div>

          <!-- Slide 3 -->
          <div class="gallery-v2-slide">
            <div class="gallery-v2-img-wrap">
              <img src="/images/hero_sofa_sharp.jpg" alt="Kiểm định sản phẩm hoàn thiện" loading="lazy" decoding="async" width="800" height="500" />
              
              <div class="gallery-v2-badge">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="2">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                CHẤT LƯỢNG
              </div>

              <div class="gallery-v2-floating-card">
                <div class="gallery-v2-icon-circle">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="1.8">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
                </div>
                <span class="gallery-v2-floating-title">Kiểm định sản phẩm hoàn thiện</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Pagination Dots (Interactive) -->
      <div class="gallery-v2-dots" id="factoryDots">
        <span class="dot active" data-slide="0" aria-label="Slide 1"></span>
        <span class="dot" data-slide="1" aria-label="Slide 2"></span>
        <span class="dot" data-slide="2" aria-label="Slide 3"></span>
      </div>
    </div>

    <!-- 2 Sub Cards -->
    <div class="gallery-v2-grid">
      <!-- Sub Card 1 -->
      <div class="gallery-v2-sub-card">
        <div class="gallery-v2-img-wrap">
          <img src="/images/factory_workers.jpg" alt="Không gian làm việc tại xưởng" loading="lazy" decoding="async" width="400" height="300" />
          <div class="gallery-v2-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="2">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
            </svg>
            CON NGƯỜI
          </div>
          <div class="gallery-v2-floating-card sub-floating">
            <div class="gallery-v2-icon-circle sub-circle">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="1.8">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
              </svg>
            </div>
            <span class="gallery-v2-floating-title sub-title">Không gian làm việc tại xưởng</span>
          </div>
        </div>
      </div>

      <!-- Sub Card 2 -->
      <div class="gallery-v2-sub-card">
        <div class="gallery-v2-img-wrap">
          <img src="/images/service_arch.jpg" alt="Quy trình vận hành thực tế" loading="lazy" decoding="async" width="400" height="300" />
          <div class="gallery-v2-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
            </svg>
            QUY TRÌNH
          </div>
          <div class="gallery-v2-floating-card sub-floating">
            <div class="gallery-v2-icon-circle sub-circle">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7D5B1E" stroke-width="1.8">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
            </div>
            <span class="gallery-v2-floating-title sub-title">Quy trình vận hành thực tế</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
