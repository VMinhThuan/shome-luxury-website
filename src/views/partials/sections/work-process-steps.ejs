<section class="work-process-steps-section" id="quy-trinh-lam-viec">
  <div class="container">
    <div class="work-process-steps-header">
      <div class="hero-script-eyebrow font-script">Quy trình làm việc</div>
    </div>

    <% const workSteps = [
      { number: '01', icon: 'survey', title: 'Khảo sát hiện trạng' },
      { number: '02', icon: 'drawing', title: 'Thống nhất bản vẽ' },
      { number: '03', icon: 'materials', title: 'Chốt vật liệu và phụ kiện' },
      { number: '04', icon: 'production', title: 'Sản xuất tại xưởng' },
      { number: '05', icon: 'delivery', title: 'Lắp đặt tại công trình' },
      { number: '06', icon: 'handover', title: 'Nghiệm thu và bàn giao' }
    ]; %>

    <ol class="work-process-steps-list">
      <% workSteps.forEach(step => { %>
        <li class="work-process-steps-item">
          <span class="work-process-step-number"><%= step.number %></span>
          <span class="work-process-step-icon" aria-hidden="true">
            <% if (step.icon === 'survey') { %>
              <svg viewBox="0 0 24 24"><path d="M5 3h12v14H5zM8 7h6M8 11h3M18.5 17.5 21 20"/><circle cx="15.5" cy="15.5" r="3.5"/></svg>
            <% } else if (step.icon === 'drawing') { %>
              <svg viewBox="0 0 24 24"><path d="m4 20 4.5-1 10-10-3.5-3.5-10 10L4 20Z"/><path d="m13.5 5.5 3.5 3.5M3 22h18"/></svg>
            <% } else if (step.icon === 'materials') { %>
              <svg viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5M3 16l9 5 9-5"/></svg>
            <% } else if (step.icon === 'production') { %>
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2v3m0 14v3M2 12h3m14 0h3M4.9 4.9 7 7m10 10 2.1 2.1M19.1 4.9 17 7M7 17l-2.1 2.1"/><path d="m7.5 3 1 2.5m7 13 1 2.5M3 7.5l2.5 1m13 7 2.5 1M3 16.5l2.5-1m13-7 2.5-1m-4 13.6-1-2.5m-7-13-1-2.5"/></svg>
            <% } else if (step.icon === 'delivery') { %>
              <svg viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h3l4 4v3h-7z"/><circle cx="7" cy="19" r="2"/><circle cx="18" cy="19" r="2"/></svg>
            <% } else { %>
              <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 3.5h6v3H9zM8 12l2 2 5-5M8 17h6"/></svg>
            <% } %>
          </span>
          <span class="work-process-step-title"><%= step.title %></span>
          <span class="work-process-step-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m9 5 7 7-7 7"/></svg></span>
        </li>
      <% }); %>
    </ol>
  </div>
</section>
