<section class="hero-section-v2" id="hero" aria-label="Banner trang chủ">
  <div class="hero-slider-track hero-slider--fade" id="heroSliderTrack" data-hero-slider data-hero-dots="heroSliderDots" aria-label="Danh sách banner">
    <!-- Slide 1 -->
    <div class="hero-slide" data-slide-index="0" aria-label="Banner 1 trên 3">
      <div class="hero-v2-bg">
        <img src="<%= homeImages.hero_banner_1 %>" alt="Tâm huyết trong từng sản phẩm - Không chỉ bán sản phẩm, phải bán cho khách hàng niềm tin" width="1920" height="1080" fetchpriority="high" decoding="async" draggable="false" />
        <div class="hero-v2-fade-overlay"></div>
      </div>
      <div class="container hero-v2-container">
        <div class="hero-v2-content">
          <h1 class="hero-v2-title">
            <span class="hero-title-line">
              <span class="hero-title-desktop">Tâm huyết trong <span class="hero-title-accent">từng sản phẩm</span></span>
              <span class="hero-title-mobile">Tâm huyết trong <span class="hero-title-accent">từng sản phẩm</span></span>
            </span>
          </h1>
          <div class="hero-script-subtitle font-script">
            <span class="hero-subtitle-desktop">Không chỉ bán sản phẩm - Phải bán cho khách hàng niềm tin</span>
            <span class="hero-subtitle-mobile">Giữ trọn niềm tin khách hàng</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="hero-slide" data-slide-index="1" aria-label="Banner 2 trên 3">
      <div class="hero-v2-bg">
        <img src="<%= homeImages.hero_banner_2 %>" alt="Tạo xu hướng cao cấp - Shome Luxury là thương hiệu thiết kế, thi công nội thất hàng đầu Việt Nam" width="1920" height="1080" loading="lazy" decoding="async" draggable="false" />
        <div class="hero-v2-fade-overlay"></div>
      </div>
      <div class="container hero-v2-container">
        <div class="hero-v2-content">
          <div class="hero-v2-title" role="heading" aria-level="2">
            <span class="hero-title-line">
              <span class="hero-title-desktop">Tạo xu hướng <span class="hero-title-accent">cao cấp</span></span>
              <span class="hero-title-mobile">Tạo xu hướng nội thất <span class="hero-title-accent">cao cấp</span></span>
            </span>
          </div>
          <div class="hero-script-subtitle font-script">
            <span class="hero-subtitle-desktop">Shome Luxury là thương hiệu thiết kế, thi công nội thất hàng đầu Việt Nam</span>
            <span class="hero-subtitle-mobile">Thiết kế nội thất chuẩn gu</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Slide 3 -->
    <div class="hero-slide" data-slide-index="2" aria-label="Banner 3 trên 3">
      <div class="hero-v2-bg">
        <img src="<%= homeImages.hero_banner_3 %>" alt="Kiến tạo không gian đẳng cấp - Sống chất từ chi tiết nhỏ nhất" width="1920" height="1080" loading="lazy" decoding="async" draggable="false" />
        <div class="hero-v2-fade-overlay"></div>
      </div>
      <div class="container hero-v2-container">
        <div class="hero-v2-content">
          <div class="hero-v2-title" role="heading" aria-level="2">
            <span class="hero-title-line">
              <span class="hero-title-desktop">Kiến tạo không gian <span class="hero-title-accent">đẳng cấp</span></span>
              <span class="hero-title-mobile">Kiến tạo không gian sống <span class="hero-title-accent">đẳng cấp</span></span>
            </span>
          </div>
          <div class="hero-script-subtitle font-script">
            <span class="hero-subtitle-desktop">Sống chất từ chi tiết nhỏ nhất</span>
            <span class="hero-subtitle-mobile">Sống chất từ chi tiết nhỏ</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="hero-slider-dots" id="heroSliderDots" role="tablist" aria-label="Chọn banner"></div>
</section>
