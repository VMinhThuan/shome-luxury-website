<section class="hero-section-v2 factory-hero subpage-banner-frame" id="hero">
  <div class="hero-slider-track" id="factoryHeroSliderTrack" data-hero-slider data-hero-dots="factoryHeroSliderDots" aria-label="Danh sách banner xưởng sản xuất">
    <div class="hero-slide" data-slide-index="0" aria-label="Banner xưởng sản xuất 1 trên 1">
      <div class="hero-v2-bg">
        <img src="<%= (locals.factoryImages && factoryImages.factory_hero_banner_1) || '/images/factory_cnc.jpg' %>" alt="Xưởng sản xuất nội thất gỗ công nghiệp Shome Luxury" width="2752" height="1536" fetchpriority="high" decoding="async" draggable="false" />
      </div>
    </div>
  </div>

  <div class="hero-slider-dots" id="factoryHeroSliderDots" role="tablist" aria-label="Chọn banner xưởng sản xuất"></div>
</section>
