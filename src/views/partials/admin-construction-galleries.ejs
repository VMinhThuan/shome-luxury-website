<section id="admin-image-construction-galleries" class="construction-gallery-admin" data-construction-gallery-manager hidden>
  <div class="construction-gallery-admin__heading">
    <div>
      <p class="eyebrow">THI CÔNG CÔNG TRÌNH / GALLERY</p>
      <h2 data-construction-gallery-title></h2>
      <p>Ảnh được lưu riêng theo từng menu con và từng section. Có thể chọn nhiều ảnh để tải lên cùng lúc.</p>
    </div>
  </div>
  <p class="construction-gallery-admin__status" data-construction-gallery-status aria-live="polite"></p>

  <div class="construction-gallery-admin__grid">
    <article class="construction-gallery-admin__card" data-gallery-section="in-progress">
      <header>
        <div><p class="eyebrow">SECTION 1</p><h3>Hình ảnh đang thi công</h3></div>
        <div class="construction-gallery-admin__card-actions"><span data-gallery-count>0 ảnh</span><button class="construction-gallery-admin__delete-all" type="button" data-gallery-delete-all disabled>Xóa tất cả</button></div>
      </header>
      <div class="construction-gallery-admin__upload">
        <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-gallery-files />
        <button class="content-cms-primary" type="button" data-gallery-upload>Tải ảnh lên section</button>
      </div>
      <div class="construction-gallery-admin__upload-progress" data-gallery-upload-progress hidden>
        <div class="construction-gallery-admin__upload-progress-head"><span data-gallery-progress-label>Đang chờ upload...</span><button type="button" class="construction-gallery-admin__retry" data-gallery-retry hidden>Thử lại ảnh lỗi</button></div>
        <progress data-gallery-progress max="1" value="0"></progress>
        <div class="construction-gallery-admin__batch-statuses" data-gallery-batch-status></div>
      </div>
      <div class="construction-gallery-admin__list" data-gallery-list><p>Chưa có ảnh.</p></div>
    </article>

    <article class="construction-gallery-admin__card" data-gallery-section="completed">
      <header>
        <div><p class="eyebrow">SECTION 2</p><h3>Hình ảnh hoàn công</h3></div>
        <div class="construction-gallery-admin__card-actions"><span data-gallery-count>0 ảnh</span><button class="construction-gallery-admin__delete-all" type="button" data-gallery-delete-all disabled>Xóa tất cả</button></div>
      </header>
      <div class="construction-gallery-admin__upload">
        <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-gallery-files />
        <button class="content-cms-primary" type="button" data-gallery-upload>Tải ảnh lên section</button>
      </div>
      <div class="construction-gallery-admin__upload-progress" data-gallery-upload-progress hidden>
        <div class="construction-gallery-admin__upload-progress-head"><span data-gallery-progress-label>Đang chờ upload...</span><button type="button" class="construction-gallery-admin__retry" data-gallery-retry hidden>Thử lại ảnh lỗi</button></div>
        <progress data-gallery-progress max="1" value="0"></progress>
        <div class="construction-gallery-admin__batch-statuses" data-gallery-batch-status></div>
      </div>
      <div class="construction-gallery-admin__list" data-gallery-list><p>Chưa có ảnh.</p></div>
    </article>
  </div>
</section>
