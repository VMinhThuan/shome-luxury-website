<%
  const galleryImages = [...new Set((project.gallery || []).filter(Boolean))].slice(0, 4);
  const extraGallery = typeof isExtraGallery !== 'undefined' && isExtraGallery;
%>

<article class="project-gallery-group <%= extraGallery ? 'is-extra-gallery' : '' %>"<%= extraGallery ? ' data-extra-gallery' : '' %>>
  <div class="project-gallery-grid" data-project-gallery-grid aria-label="Ảnh công trình <%= project.title %>">
    <% galleryImages.forEach((image, index) => { %>
      <a
        class="project-gallery-tile"
        href="<%= image %>"
        data-project-gallery-tile
        data-gallery-src="<%= image %>"
        data-gallery-alt="<%= project.title %> - ảnh <%= index + 1 %>"
        aria-label="Mở ảnh <%= project.title %> - ảnh <%= index + 1 %>"
      >
        <img
          src="<%= image %>"
          alt="<%= project.title %> - ảnh <%= index + 1 %>"
          loading="lazy"
          decoding="async"
          draggable="false"
        />
      </a>
    <% }); %>
  </div>
</article>
