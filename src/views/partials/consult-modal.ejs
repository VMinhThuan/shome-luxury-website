<!-- Quick Floating Contact Widget -->
<div class="quick-contact-widget" id="quickContactWidget">
  <!-- Main Floating Trigger Button (Contact Icon) -->
  <button class="quick-contact-trigger trigger-consult-modal" id="quickContactTrigger" aria-label="Liên hệ tư vấn">
    <div class="trigger-ring"></div>
    <div class="trigger-icon-wrap">
      <svg class="icon-plus" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2a1.003 1.003 0 011.02-.24c1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
      </svg>
    </div>
  </button>
</div>

<!-- Consultation Modal Form -->
<div class="modal-backdrop" id="consultModal" aria-hidden="true">
  <div class="modal-box" role="dialog" aria-labelledby="modalTitle">
    <button class="modal-close" id="modalCloseBtn" aria-label="Đóng form">&times;</button>
    <span class="eyebrow">Luxury Home Contact</span>
    <h3 id="modalTitle" class="font-serif" style="font-size: 1.85rem; margin-bottom: 0.5rem; color: var(--text-on-dark);">
      Đăng ký nhận tư vấn
    </h3>
    <p style="font-size: 0.875rem; color: var(--text-on-dark-muted); margin-bottom: 1.5rem;">
      Để lại thông tin, KTS trưởng Luxury Home sẽ liên hệ tư vấn chuyên sâu cho quý khách trong 15 phút.
    </p>

    <form id="consultForm">
      <div class="form-group">
        <label class="form-label" for="fullname">Họ và tên *</label>
        <input type="text" id="fullname" name="fullname" class="form-input" placeholder="Nguyễn Văn A" required />
      </div>

      <div class="form-group">
        <label class="form-label" for="phone">Số điện thoại *</label>
        <input type="tel" id="phone" name="phone" class="form-input" placeholder="0988.888.888" required />
      </div>

      <div class="form-group">
        <label class="form-label" for="service">Dịch vụ quan tâm</label>
        <select id="service" name="service" class="form-select">
          <option value="Thiet ke kien truc">Thiết kế kiến trúc</option>
          <option value="Thiet ke noi that">Thiết kế nội thất</option>
          <option value="Thi cong tron goi">Thi công trọn gói</option>
          <option value="Bao gia chi tiet">Nhận báo giá chi tiết</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label" for="message">Ghi chú thêm (Diện tích, ngân sách, phong cách)</label>
        <textarea id="message" name="message" class="form-textarea" rows="3" placeholder="Nhập nhu cầu của bạn..."></textarea>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Gửi yêu cầu tư vấn
      </button>
    </form>
  </div>
</div>
