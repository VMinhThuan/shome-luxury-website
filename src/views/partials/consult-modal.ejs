<!-- Consultation Modal Form -->
<div class="modal-backdrop" id="consultModal" aria-hidden="true">
  <div class="modal-box" role="dialog" aria-labelledby="modalTitle">
    <button class="modal-close" id="modalCloseBtn" aria-label="Đóng form">&times;</button>
    <h3 id="modalTitle" class="font-serif" style="font-size: 1.85rem; margin-bottom: 0.5rem; color: var(--text-on-dark);">
      Đăng ký nhận tư vấn
    </h3>
    <p style="font-size: 0.875rem; color: var(--text-on-dark-muted); margin-bottom: 1.5rem;">
      Để lại thông tin, Shome Luxury sẽ liên hệ và tư vấn cho bạn trong thời gian sớm nhất.
    </p>

    <form id="consultForm">
      <div class="form-group">
        <label class="form-label" for="fullname">Họ và tên *</label>
        <input type="text" id="fullname" name="fullname" class="form-input" placeholder="Nguyễn Văn A" required />
      </div>

      <div class="form-group">
        <label class="form-label" for="phone">Số điện thoại *</label>
        <input type="tel" id="phone" name="phone" class="form-input" placeholder="0988.888.888" required />
      </div>

      <div class="form-group">
        <label class="form-label" for="serviceSelectToggle">Dịch vụ quan tâm</label>
        <div class="custom-dropdown" id="customServiceDropdown">
          <button type="button" class="custom-dropdown-toggle" id="serviceSelectToggle" aria-haspopup="listbox" aria-expanded="false">
            <span class="custom-dropdown-selected" id="serviceSelectSelected">Thiết kế kiến trúc</span>
            <svg class="custom-dropdown-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <ul class="custom-dropdown-menu" role="listbox" id="serviceSelectMenu">
            <li class="custom-dropdown-item selected" role="option" data-value="Thiết kế kiến trúc" aria-selected="true">
              <span>Thiết kế kiến trúc</span>
              <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </li>
            <li class="custom-dropdown-item" role="option" data-value="Thiết kế nội thất" aria-selected="false">
              <span>Thiết kế nội thất</span>
              <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </li>
            <li class="custom-dropdown-item" role="option" data-value="Báo giá thiết kế" aria-selected="false">
              <span>Báo giá thiết kế</span>
              <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </li>
            <li class="custom-dropdown-item" role="option" data-value="Báo giá thi công" aria-selected="false">
              <span>Báo giá thi công</span>
              <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C89B4B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </li>
          </ul>
          <input type="hidden" id="service" name="service" value="Thiết kế kiến trúc" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="message">Ghi chú thêm (Dạng công trình, diện tích, ngân sách, phong cách)</label>
        <textarea id="message" name="message" class="form-textarea" rows="3" placeholder="Nhập nhu cầu của bạn..."></textarea>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Gửi yêu cầu tư vấn
      </button>
    </form>
  </div>
</div>
