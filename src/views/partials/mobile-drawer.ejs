<!-- Mobile Menu Backdrop -->
<%
  const adminImageModeEnabled = typeof adminImageMode !== 'undefined' && adminImageMode;
  const drawerNavigation = adminImageModeEnabled
    ? navigation
    : navigation.filter(item => item.id !== 'ho-so-nang-luc');
  const adminHomeTarget = typeof adminHomeHref !== 'undefined'
    ? adminHomeHref
    : (adminImageModeEnabled ? '/admin/images' : '/');
  const publicSiteOrigin = 'https://shomeluxury.com';
  const publicHref = href => {
    if (!adminImageModeEnabled || !href || href.startsWith('javascript:')) return href;
    return new URL(href, publicSiteOrigin).toString();
  };
  const adminImageTarget = (item) => {
    const quoteSubpageTargets = {
      'tk-kt-nha-cap-4': 'subpage:quote:tk-kt-nha-cap-4',
      'tk-kt-nha-pho': 'subpage:quote:tk-kt-nha-pho',
      'tk-kt-biet-thu': 'subpage:quote:tk-kt-biet-thu',
      'tk-kt-villa': 'subpage:quote:tk-kt-villa',
      'tk-nt-chung-cu': 'subpage:quote:tk-nt-chung-cu',
      'tk-nt-nha-pho': 'subpage:quote:tk-nt-nha-pho',
      'tk-nt-biet-thu': 'subpage:quote:tk-nt-biet-thu',
      'tk-nt-van-phong': 'subpage:quote:tk-nt-van-phong',
      'thiet-ke-kien-truc-nha-cap-4': 'subpage:quote:tk-kt-nha-cap-4',
      'thiet-ke-kien-truc-nha-pho': 'subpage:quote:tk-kt-nha-pho',
      'thiet-ke-kien-truc-biet-thu': 'subpage:quote:tk-kt-biet-thu',
      'thiet-ke-kien-truc-villa': 'subpage:quote:tk-kt-villa',
      'thiet-ke-noi-that-chung-cu': 'subpage:quote:tk-nt-chung-cu',
      'thiet-ke-noi-that-nha-pho': 'subpage:quote:tk-nt-nha-pho',
      'thiet-ke-noi-that-biet-thu': 'subpage:quote:tk-nt-biet-thu',
      'thiet-ke-noi-that-van-phong': 'subpage:quote:tk-nt-van-phong'
    };
    if (item.id === 'home') return 'home';
    if (item.id === 'xuong-san-xuat') return 'factory';
    if (item.id === 'ho-so-nang-luc') return 'profile';
    if (item.id === 'tin-tuc') return 'content:articles';
    if (item.id === 'tuyen-dung') return 'content:careers';
    if (item.id === 'bao-gia') return 'quote';
    if (item.id === 'thiet-ke-cong-trinh' || item.id === 'thi-cong-cong-trinh') return `subpage:${item.categoryCode || item.id}`;
    if (item.id === 'thi-cong-kien-truc' || item.id === 'thi-cong-noi-that') return 'subpage:thi-cong-cong-trinh';
    if (item.categoryCode) return `subpage:${item.categoryCode}`;
    const category = item.href?.match(/[?&]category=([^&]+)/)?.[1];
    if (category) return quoteSubpageTargets[category] || `subpage:quote:${category}`;
    const pathTargets = {
      '/thi-cong-cong-trinh/thi-cong-kien-truc/thi-cong-kien-truc-nha-cap-4': 'subpage:tc-kt-nha-cap-4',
      '/thi-cong-cong-trinh/thi-cong-kien-truc/thi-cong-kien-truc-nha-pho': 'subpage:tc-kt-nha-pho',
      '/thi-cong-cong-trinh/thi-cong-kien-truc/thi-cong-kien-truc-biet-thu': 'subpage:tc-kt-biet-thu',
      '/thi-cong-cong-trinh/thi-cong-kien-truc/thi-cong-kien-truc-villa': 'subpage:tc-kt-villa',
      '/thi-cong-cong-trinh/thi-cong-noi-that/thi-cong-noi-that-chung-cu': 'subpage:tc-nt-chung-cu',
      '/thi-cong-cong-trinh/thi-cong-noi-that/thi-cong-noi-that-nha-pho': 'subpage:tc-nt-nha-pho',
      '/thi-cong-cong-trinh/thi-cong-noi-that/thi-cong-noi-that-biet-thu': 'subpage:tc-nt-biet-thu',
      '/thi-cong-cong-trinh/thi-cong-noi-that/thi-cong-noi-that-van-phong': 'subpage:tc-nt-van-phong',
      '/bao-gia/thiet-ke-thi-cong-kien-truc/kien-truc-nha-cap-4-tron-goi': 'subpage:quote:tk-kt-nha-cap-4',
      '/bao-gia/thiet-ke-thi-cong-kien-truc/kien-truc-nha-pho-tron-goi': 'subpage:quote:tk-kt-nha-pho',
      '/bao-gia/thiet-ke-thi-cong-kien-truc/kien-truc-biet-thu-tron-goi': 'subpage:quote:tk-kt-biet-thu',
      '/bao-gia/thiet-ke-thi-cong-kien-truc/kien-truc-villa-tron-goi': 'subpage:quote:tk-kt-villa',
      '/bao-gia/thiet-ke-thi-cong-noi-that/noi-that-chung-cu-tron-goi': 'subpage:quote:tk-nt-chung-cu',
      '/bao-gia/thiet-ke-thi-cong-noi-that/noi-that-nha-pho-tron-goi': 'subpage:quote:tk-nt-nha-pho',
      '/bao-gia/thiet-ke-thi-cong-noi-that/noi-that-biet-thu-tron-goi': 'subpage:quote:tk-nt-biet-thu',
      '/bao-gia/thiet-ke-thi-cong-noi-that/noi-that-van-phong-tron-goi': 'subpage:quote:tk-nt-van-phong'
    };
    return pathTargets[item.href] || (item.id?.startsWith('bao-gia-') ? 'quote' : null);
  };
  const adminImageHref = (item) => {
    // Any item with children is a navigation group, not a destination. Its
    // submenu is the only clickable route on desktop, responsive and mobile.
    if (item.children && item.children.length) {
      if (!adminImageModeEnabled && item.id === 'bao-gia') return publicHref(item.href);
      return 'javascript:void(0)';
    }
    if (!adminImageModeEnabled) return publicHref(item.href);
    const target = adminImageTarget(item);
    if (!target) return publicHref(item.href);
    if (target.startsWith('content:')) return `/admin/images?content=${encodeURIComponent(target.slice('content:'.length))}`;
    return `/admin/images?page=${encodeURIComponent(target)}`;
  };
%>
<div class="drawer-backdrop" id="drawerBackdrop"></div>

<!-- Mobile Navigation Drawer -->
<aside class="mobile-drawer" id="mobileDrawer" aria-hidden="true">

  <!-- Brand -->
  <a href="<%= adminHomeTarget %>" class="drawer-brand" aria-label="SHOME LUXURY - <%= adminImageModeEnabled ? 'Quản lý ảnh' : 'Trang chủ' %>">
    <img src="/images/shome-logo.png" alt="SHOME LUXURY" width="160" height="56" />
  </a>

  <!-- Drawer Body - Accordion Navigation -->
  <nav class="drawer-body" aria-label="Mobile Navigation">
    <ul class="mobile-menu-list">
      <% drawerNavigation.forEach(item => { %>
        <li class="mobile-menu-item">
          <div class="mobile-menu-row">
            <a href="<%= adminImageHref(item) %>" class="mobile-menu-link"<% if (adminImageModeEnabled && !(item.children && item.children.length) && adminImageTarget(item)) { %> data-admin-image-page="<%= adminImageTarget(item) %>"<% } %>><%= item.label %></a>
            <% if (item.children) { %>
              <button class="accordion-toggle" aria-expanded="false" aria-controls="submenu-<%= item.id %>" aria-label="Mở <%= item.label %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            <% } %>
          </div>

          <% if (item.children) { %>
            <ul class="mobile-submenu-l2" id="submenu-<%= item.id %>">
              <% item.children.forEach(subItem => { %>
                <li class="l2-item">
                  <div class="mobile-menu-row">
                    <a href="<%= adminImageHref(subItem) %>" class="l2-link"<% if (adminImageModeEnabled && !(subItem.children && subItem.children.length) && adminImageTarget(subItem)) { %> data-admin-image-page="<%= adminImageTarget(subItem) %>"<% } %>><%= subItem.label %></a>
                    <% if (subItem.children) { %>
                      <button class="accordion-toggle" aria-expanded="false" aria-controls="submenu-<%= subItem.id %>" aria-label="Mở <%= subItem.label %>">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </button>
                    <% } %>
                  </div>

                  <% if (subItem.children) { %>
                    <ul class="mobile-submenu-l3" id="submenu-<%= subItem.id %>">
                      <% subItem.children.forEach(nestedItem => { %>
                        <li class="l3-item">
                          <a href="<%= adminImageHref(nestedItem) %>" class="l3-link"<% if (adminImageModeEnabled && adminImageTarget(nestedItem)) { %> data-admin-image-page="<%= adminImageTarget(nestedItem) %>"<% } %>><%= nestedItem.label %></a>
                        </li>
                      <% }); %>
                    </ul>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </li>
      <% }); %>
    </ul>
  </nav>

  <!-- Drawer Footer: quote and contact CTA, restored for the mobile menu. -->
  <div class="drawer-footer">
    <div class="drawer-contact-info">
      <div>Hotline: <a href="tel:0799997700">0799 997 700</a></div>
      <div>Email: <a href="mailto:shomeluxurydesign@gmail.com">shomeluxurydesign@gmail.com</a></div>
    </div>
    <button class="btn btn-primary trigger-consult-modal" type="button" style="width: 100%;">Nhận báo giá miễn phí</button>
  </div>

</aside>
