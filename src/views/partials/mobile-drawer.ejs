<!-- Mobile Menu Backdrop -->
<div class="drawer-backdrop" id="drawerBackdrop"></div>

<!-- Mobile Navigation Drawer -->
<aside class="mobile-drawer" id="mobileDrawer" aria-hidden="true">
  <div class="drawer-header-row">
    <span class="drawer-brand-title">SHOME LUXURY</span>
    <button class="drawer-close-btn" id="drawerCloseBtn" aria-label="Đóng menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Search Bar -->
  <div class="drawer-search-container">
    <div class="drawer-search-box">
      <input type="search" class="drawer-search-input" placeholder="Nhập từ khóa" aria-label="Tìm kiếm trên website" />
      <span class="drawer-search-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>
    </div>
  </div>

  <!-- Drawer Body - Accordion Navigation -->
  <nav class="drawer-body" aria-label="Mobile Navigation">
    <ul class="mobile-menu-list">
      <% navigation.forEach(item => { %>
        <li class="mobile-menu-item">
          <div class="mobile-menu-row">
            <a href="<%= (item.children && item.children.length) ? 'javascript:void(0)' : item.href %>" class="mobile-menu-link"><%= item.label %></a>
            <% if (item.children) { %>
              <button class="accordion-toggle" aria-expanded="false" aria-controls="submenu-<%= item.id %>" aria-label="Mở <%= item.label %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            <% } %>
          </div>

          <% if (item.children) { %>
            <ul class="mobile-submenu-l2" id="submenu-<%= item.id %>">
              <% item.children.forEach(subItem => { %>
                <li class="l2-item">
                  <div class="mobile-menu-row">
                    <a href="<%= (subItem.children && subItem.children.length) ? 'javascript:void(0)' : subItem.href %>" class="l2-link"><%= subItem.label %></a>
                    <% if (subItem.children) { %>
                      <button class="accordion-toggle" aria-expanded="false" aria-controls="submenu-<%= subItem.id %>" aria-label="Mở <%= subItem.label %>">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </button>
                    <% } %>
                  </div>

                  <% if (subItem.children) { %>
                    <ul class="mobile-submenu-l3" id="submenu-<%= subItem.id %>">
                      <% subItem.children.forEach(nestedItem => { %>
                        <li class="l3-item">
                          <a href="<%= nestedItem.href %>" class="l3-link"><%= nestedItem.label %></a>
                        </li>
                      <% }); %>
                    </ul>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </li>
      <% }); %>
    </ul>
  </nav>

</aside>
