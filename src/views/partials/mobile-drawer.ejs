<!-- Mobile Menu Backdrop -->
<%
  const adminImageModeEnabled = typeof adminImageMode !== 'undefined' && adminImageMode;
  const adminHomeTarget = typeof adminHomeHref !== 'undefined'
    ? adminHomeHref
    : (adminImageModeEnabled ? '/admin/images' : '/');
  const adminImageTarget = (item) => {
    const quoteSubpageTargets = {
      'tk-kt-nha-cap-4': 'subpage:quote:tk-kt-nha-cap-4',
      'tk-kt-nha-pho': 'subpage:quote:tk-kt-nha-pho',
      'tk-kt-biet-thu': 'subpage:quote:tk-kt-biet-thu',
      'tk-kt-villa': 'subpage:quote:tk-kt-villa',
      'tk-nt-chung-cu': 'subpage:quote:tk-nt-chung-cu',
      'tk-nt-nha-pho': 'subpage:quote:tk-nt-nha-pho',
      'tk-nt-biet-thu': 'subpage:quote:tk-nt-biet-thu',
      'tk-nt-van-phong': 'subpage:quote:tk-nt-van-phong',
      'thiet-ke-kien-truc-nha-cap-4': 'subpage:quote:tk-kt-nha-cap-4',
      'thiet-ke-kien-truc-nha-pho': 'subpage:quote:tk-kt-nha-pho',
      'thiet-ke-kien-truc-biet-thu': 'subpage:quote:tk-kt-biet-thu',
      'thiet-ke-kien-truc-villa': 'subpage:quote:tk-kt-villa',
      'thiet-ke-noi-that-chung-cu': 'subpage:quote:tk-nt-chung-cu',
      'thiet-ke-noi-that-nha-pho': 'subpage:quote:tk-nt-nha-pho',
      'thiet-ke-noi-that-biet-thu': 'subpage:quote:tk-nt-biet-thu',
      'thiet-ke-noi-that-van-phong': 'subpage:quote:tk-nt-van-phong'
    };
    if (item.id === 'home') return 'home';
    if (item.id === 'xuong-san-xuat') return 'factory';
    if (item.id === 'tin-tuc') return 'content:articles';
    if (item.id === 'tuyen-dung') return 'content:careers';
    if (item.id === 'bao-gia') return 'quote';
    if (item.id === 'thiet-ke-cong-trinh' || item.id === 'thi-cong-cong-trinh') return `subpage:${item.categoryCode || item.id}`;
    if (item.id === 'thi-cong-kien-truc' || item.id === 'thi-cong-noi-that') return 'subpage:thi-cong-cong-trinh';
    if (item.categoryCode) return `subpage:${item.categoryCode}`;
    const category = item.href?.match(/[?&]category=([^&]+)/)?.[1];
    if (category) return quoteSubpageTargets[category] || `subpage:quote:${category}`;
    const pathTargets = {
      '/thi-cong-cong-trinh/kien-truc/nha-cap-4': 'subpage:tc-kt-nha-cap-4',
      '/thi-cong-cong-trinh/kien-truc/nha-pho': 'subpage:tc-kt-nha-pho',
      '/thi-cong-cong-trinh/kien-truc/biet-thu': 'subpage:tc-kt-biet-thu',
      '/thi-cong-cong-trinh/kien-truc/villa': 'subpage:tc-kt-villa',
      '/thi-cong-cong-trinh/noi-that/chung-cu': 'subpage:tc-nt-chung-cu',
      '/thi-cong-cong-trinh/noi-that/nha-pho': 'subpage:tc-nt-nha-pho',
      '/thi-cong-cong-trinh/noi-that/biet-thu': 'subpage:tc-nt-biet-thu',
      '/thi-cong-cong-trinh/noi-that/van-phong': 'subpage:tc-nt-van-phong',
      '/bao-gia/thiet-ke-thi-cong-kien-truc/thiet-ke-kien-truc-nha-cap-4': 'subpage:quote:tk-kt-nha-cap-4',
      '/bao-gia/thiet-ke-thi-cong-kien-truc/thiet-ke-kien-truc-nha-pho': 'subpage:quote:tk-kt-nha-pho',
      '/bao-gia/thiet-ke-thi-cong-kien-truc/thiet-ke-kien-truc-biet-thu': 'subpage:quote:tk-kt-biet-thu',
      '/bao-gia/thiet-ke-thi-cong-kien-truc/thiet-ke-kien-truc-villa': 'subpage:quote:tk-kt-villa',
      '/bao-gia/thiet-ke-thi-cong-noi-that/thiet-ke-noi-that-chung-cu': 'subpage:quote:tk-nt-chung-cu',
      '/bao-gia/thiet-ke-thi-cong-noi-that/thiet-ke-noi-that-nha-pho': 'subpage:quote:tk-nt-nha-pho',
      '/bao-gia/thiet-ke-thi-cong-noi-that/thiet-ke-noi-that-biet-thu': 'subpage:quote:tk-nt-biet-thu',
      '/bao-gia/thiet-ke-thi-cong-noi-that/thiet-ke-noi-that-van-phong': 'subpage:quote:tk-nt-van-phong'
    };
    return pathTargets[item.href] || (item.id?.startsWith('bao-gia-') ? 'quote' : null);
  };
%>
<div class="drawer-backdrop" id="drawerBackdrop"></div>

<!-- Mobile Navigation Drawer -->
<aside class="mobile-drawer" id="mobileDrawer" aria-hidden="true">

  <!-- Brand -->
  <a href="<%= adminHomeTarget %>" class="drawer-brand" aria-label="SHOME LUXURY - <%= adminImageModeEnabled ? 'Quản lý ảnh' : 'Trang chủ' %>">
    <img src="/images/shome-logo.png" alt="SHOME LUXURY" width="160" height="56" />
  </a>

  <!-- Search Bar -->
  <div class="drawer-search-container">
    <div class="drawer-search-box">
      <input type="search" class="drawer-search-input" placeholder="Nhập từ khóa" aria-label="Tìm kiếm trên website" />
      <span class="drawer-search-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>
    </div>
  </div>

  <!-- Drawer Body - Accordion Navigation -->
  <nav class="drawer-body" aria-label="Mobile Navigation">
    <ul class="mobile-menu-list">
      <% navigation.forEach(item => { %>
        <li class="mobile-menu-item">
          <div class="mobile-menu-row">
            <a href="<%= (item.children && item.children.length) ? 'javascript:void(0)' : item.href %>" class="mobile-menu-link"<% if (adminImageModeEnabled && adminImageTarget(item)) { %> data-admin-image-page="<%= adminImageTarget(item) %>"<% } %>><%= item.label %></a>
            <% if (item.children) { %>
              <button class="accordion-toggle" aria-expanded="false" aria-controls="submenu-<%= item.id %>" aria-label="Mở <%= item.label %>">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
              </button>
            <% } %>
          </div>

          <% if (item.children) { %>
            <ul class="mobile-submenu-l2" id="submenu-<%= item.id %>">
              <% item.children.forEach(subItem => { %>
                <li class="l2-item">
                  <div class="mobile-menu-row">
                    <a href="<%= (subItem.children && subItem.children.length) ? 'javascript:void(0)' : subItem.href %>" class="l2-link"<% if (adminImageModeEnabled && adminImageTarget(subItem)) { %> data-admin-image-page="<%= adminImageTarget(subItem) %>"<% } %>><%= subItem.label %></a>
                    <% if (subItem.children) { %>
                      <button class="accordion-toggle" aria-expanded="false" aria-controls="submenu-<%= subItem.id %>" aria-label="Mở <%= subItem.label %>">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                      </button>
                    <% } %>
                  </div>

                  <% if (subItem.children) { %>
                    <ul class="mobile-submenu-l3" id="submenu-<%= subItem.id %>">
                      <% subItem.children.forEach(nestedItem => { %>
                        <li class="l3-item">
                          <a href="<%= nestedItem.href %>" class="l3-link"<% if (adminImageModeEnabled && adminImageTarget(nestedItem)) { %> data-admin-image-page="<%= adminImageTarget(nestedItem) %>"<% } %>><%= nestedItem.label %></a>
                        </li>
                      <% }); %>
                    </ul>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          <% } %>
        </li>
      <% }); %>
    </ul>
  </nav>

  <!-- Drawer Footer: quote and contact CTA, restored for the mobile menu. -->
  <div class="drawer-footer">
    <div class="drawer-contact-info">
      <div>Hotline: <a href="tel:0799997700">0799 997 700</a></div>
      <div>Email: <a href="mailto:shomeluxurydesign@gmail.com">shomeluxurydesign@gmail.com</a></div>
    </div>
    <button class="btn btn-primary trigger-consult-modal" type="button" style="width: 100%;">Nhận báo giá miễn phí</button>
  </div>

</aside>
